[
  {
    "provider": "anthropic",
    "version": "anthropic-messages-2023-06-01-1",
    "host": "api.anthropic.com",
    "header": "X-Api-Key",
    "headers": {"Anthropic-Version": "2023-06-01"},
    "ops": [{"name": "messages", "path": "/v1/messages"}],
    "body": {
      "keys": ["model", "messages", "system", "max_tokens", "stop_sequences", "tools", "tool_choice", "thinking", "output_config", "metadata", "temperature", "top_p", "top_k"],
