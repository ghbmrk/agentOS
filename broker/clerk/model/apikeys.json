      "max_out_key": "max_tokens",
      "tools_key": "tools",
      "tool_types": ["", "custom"],
      "source_types": ["base64", "text", "content"]
    },
    "usage_in": [
      {"path": ["usage", "input_tokens"], "weight": 1},
      {"path": ["usage", "cache_creation_input_tokens"], "weight": 2, "optional": true},
      {"path": ["usage", "cache_read_input_tokens"], "weight": 1, "optional": true}
    ],
    "usage_out": [{"path": ["usage", "output_tokens"], "weight": 1}],
    "unbilled": [400, 401, 403, 404, 413, 429, 500, 529],
    "models": [
      {"route": "anthropic-opus-5-5", "model": "claude-opus-5-5", "in_per_m": 400, "out_per_m": 2000, "context": 1000000, "max_out": 128000},
      {"route": "anthropic-sonnet-5-5", "model": "claude-sonnet-5-5", "in_per_m": 200, "out_per_m": 1000, "context": 1000000, "max_out": 128000},
      {"route": "anthropic-haiku-5-5", "model": "claude-haiku-5-5", "in_per_m": 50, "out_per_m": 250, "context": 1000000, "max_out": 128000}
    ]
  }
]
