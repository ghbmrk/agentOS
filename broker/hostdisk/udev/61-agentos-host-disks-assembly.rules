# AgentOS: nothing on a disk that is not the drive is assembled or
# registered (HW-8, security F1 and L3 on #172): a degraded array's resync,
# an LVM activation or a bcache registration (journal replay, writeback)
# would write it. Runs after 60-persistent-storage and
# 60-persistent-storage-dm (blkid's ID_FS_TYPE) and before 64-md-raid,
# 69-lvm and 69-bcache, which each act only on their own member type, and
# 69-bcache also on an empty one.
#
# A member type becomes the sentinel "agentos_held", which none of them
# acts on. ID_FS_USAGE stays, so 99-systemd keeps an unknown dm-verity or
# dm-crypt device ready, whatever it holds.
# A host dm device was re-probed by 60-persistent-storage-dm, which ignores
# 59's flag: its blkid result is held again here. (Its by-label and by-uuid
# links stay; a dm device on a host disk exists only by a root action.)

ACTION=="remove", GOTO="agentos_assembly_end"
SUBSYSTEM!="block", GOTO="agentos_assembly_end"
KERNEL=="loop*|ram*|zram*|nbd*", GOTO="agentos_assembly_end"
ENV{AGENTOS_DISK}=="drive", GOTO="agentos_assembly_end"

ENV{AGENTOS_DISK}=="host", ENV{ID_FS_TYPE}="agentos_held", ENV{ID_FS_USAGE}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_UUID}="", ENV{ID_FS_UUID_ENC}=""
ENV{ID_FS_TYPE}=="*_raid_member|LVM2_member|bcache|zfs_member", ENV{ID_FS_TYPE}="agentos_held"

LABEL="agentos_assembly_end"
