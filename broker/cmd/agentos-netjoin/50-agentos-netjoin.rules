// AgentOS home Wi-Fi helper (P2-2w c3; Security L8.2 on the P2-2w plan).
// Installed by the image (P2-1) to /usr/share/polkit-1/rules.d/. It lets
// the helper's user write NetworkManager system connections and nothing
// else; every other subject and action falls through to the other rules.
polkit.addRule(function(action, subject) {
    if (subject.user == "agentos-netjoin" &&
        action.id == "org.freedesktop.NetworkManager.settings.modify.system") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
