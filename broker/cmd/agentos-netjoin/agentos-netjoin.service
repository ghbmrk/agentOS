# AgentOS home Wi-Fi helper (P2-2w c3; Security L8 on the P2-2w plan).
# Installed by the image (P2-1) to /usr/lib/systemd/system/, with its
# system user and 50-agentos-netjoin.rules. It writes one NetworkManager
# connection for agentosd during setup, so it runs as its own user with no
# capabilities, no IP networking and no writable path but its socket's
# directory (L8.1). Its only privilege is the polkit rule (L8.2).
[Unit]
Description=AgentOS home Wi-Fi helper
# After agentos-ap, which creates the station wlsta0 beside the access
# point (#936) before the access point comes up.
After=dbus.service NetworkManager.service agentos-ap.service

[Service]
User=agentos-netjoin
Group=agentos-netjoin
# -ap-iface is agentos-ap's -iface, so the join never takes the radio
# agentos_ap holds (S-R4, #1428). No -station yet: agentos-ap creates
# wlsta0 (#936), and #935 names it here with the sealed store; until then
# every join answers failed and setup points to Ethernet.
ExecStart=/usr/lib/agentos/agentos-netjoin -dir /run/agentos-netjoin -agentosd-uid 0 -ap-iface wlan0
Restart=always
RestartSec=5

# The one writable path: the socket's directory, the helper's own, 0700.
# agentosd (root) reaches the socket through it; sockets' SO_PEERCRED
# check serves uid 0 alone.
RuntimeDirectory=agentos-netjoin
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateIPC=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

# Network: the system bus and its own socket only.
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr

[Install]
WantedBy=multi-user.target
