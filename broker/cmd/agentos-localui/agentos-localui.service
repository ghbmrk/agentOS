# AgentOS Wi-Fi page (P2-2w). Installed by the image (P2-1) to
# /usr/lib/systemd/system/. It decodes untrusted forms and photos from any
# phone on the access point, so it runs as its own user with no secret and
# no authority: agentosd's localui.sock decides every owner action
# (Security L1, L5 on the P2-2w plan).
[Unit]
Description=AgentOS Wi-Fi page
After=agentosd.service
Requires=agentosd.service

[Service]
User=agentos-localui
Group=agentos-localui
ExecStart=/usr/lib/agentos/agentos-localui -sock /run/agentos/localui.sock -iface wlan0 -addr 10.42.0.1/24
Restart=always
RestartSec=5
# The access point may come up after the page: listening fails until it
# does, and the unit restarts.

# Port 80, and SO_BINDTODEVICE to the access point's interface (CH-9).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
RemoveIPC=yes

# Memory ceiling for the photo decoder's worst case (L18 on #50); the Go
# heap's soft limit sits under it (memoryLimit).
MemoryMax=512M

# Network: the access point's clients only, and agentosd's Unix socket.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.42.0.0/24
# No AgentOS state at all: the page keeps nothing on disk (L18).
TemporaryFileSystem=/var/lib/agentos:ro

[Install]
WantedBy=multi-user.target
