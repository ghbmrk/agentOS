# agentOS Wi-Fi page (P2-2w). Installed by the image (P2-1, image/build.sh)
# to /usr/lib/systemd/system/. It decodes untrusted forms and photos from any
# phone on the access point, so it runs as its own user, with no key and
# none of the broker's or the vault's state: agentosd's localui.sock decides
# every owner action (Security L1, L5 on the P2-2w plan), and the vault
# process's unlock.sock every vault step. It does hold one authority: on a
# preloaded box it keeps the claim state (salted verifiers of the sticker
# codes, HW-10) and checks the claim against it, and it keeps the Owner Card
# step's latch (#1270). Both live in its own state directory.
[Unit]
Description=agentOS Wi-Fi page
After=agentosd.service agentos-egress.service
Requires=agentosd.service
Wants=agentos-egress.service

[Service]
User=agentos-localui
Group=agentos-localui
# The seller's sealed claim state moves here at the first start (localui-claim).
StateDirectory=agentos-localui
StateDirectoryMode=0700
ExecStartPre=+/usr/lib/agentos/localui-claim
ExecStart=/usr/lib/agentos/agentos-localui -sock /run/agentos/localui.sock -iface wlan0 -addr 10.42.0.1/24 \
        -vault-sock /run/agentos-egress/unlock.sock -claim-state /var/lib/agentos-localui/claim.json \
        -card-latch /var/lib/agentos-localui/card-latch.json
Restart=always
RestartSec=5
# The access point may come up after the page: listening fails until it
# does, and the unit restarts.

# Port 80, and SO_BINDTODEVICE to the access point's interface (CH-9).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# No other process's /proc entries. ProcSubset=pid is left off: the claim
# reads the boot's id from /proc/sys/kernel/random/boot_id, which that would
# hide, and the page would fail at every start (B3 on #1302).
ProtectProc=invisible
PrivateIPC=yes
RemoveIPC=yes

# Memory ceiling for the photo decoder's worst case (L18 on #50); the Go
# heap's soft limit sits under it (memoryLimit).
MemoryMax=512M

# Network: the access point's clients only, and agentosd's Unix socket.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.42.0.0/24
# None of the broker's state (L18): localui-claim, outside this mask, moves
# the claim state to the page's own directory, which stays writable.
TemporaryFileSystem=/var/lib/agentos:ro
# The claim and the card step pass codes through this process (IMG-nodump).
LimitCORE=0

[Install]
WantedBy=multi-user.target
