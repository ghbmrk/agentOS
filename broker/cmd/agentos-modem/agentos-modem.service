# AgentOS modem bridge (P2-3w). Installed by the image (P2-1) to
# /usr/lib/systemd/system/. It drives the modems and parses any sender's
# texts, so it runs as its own user with nothing else (security S-B7 on
# the P2-3w design read).
[Unit]
Description=AgentOS modem bridge
After=agentosd.service
Requires=agentosd.service

[Service]
User=agentos-modem
Group=agentos-modem
ExecStart=/usr/lib/agentos/agentos-modem -owner-sock /run/agentosd/owner.sock -roles /var/lib/agentos/modem-roles.json -owner-number ${OWNER_NUMBER} -country-code ${COUNTRY_CODE} -box-number ${BOX_NUMBER}
EnvironmentFile=/etc/agentos/modem.env
Restart=always
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

# Devices: the modems' serial nodes and sound card only. The udev rule
# makes only qualified modems' nodes this user's; every other serial or
# sound node stays root's, so the class allows no more than that.
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-alsa rw

# Network: none in part 1, Unix sockets only. The second line's SIP
# account (part 2) reaches only its provider through the egress allow-list.
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/agentos/modem-roles.json

[Install]
WantedBy=multi-user.target
