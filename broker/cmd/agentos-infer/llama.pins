# The llama.cpp release and the test models the real-runtime test runs on (INFER-llama, G4).
# .github/workflows/infer-real.yml downloads each file, checks its SHA-256 against the value
# here and fails on a mismatch, so a changed upstream asset is never run. Key=value, no spaces.
# Changing a pin changes what the real test proves: read ASSUMPTIONS INFER-A13 first.
#
# llama.cpp release b11900 (2026-10-26), CPU build for Linux x86-64. `unpinned` makes the
# workflow print the asset's hash and fail, which is how the first pin is taken (the hash of
# a file downloaded in CI, never a value typed from memory).
llama_url=https://github.com/ggml-org/llama.cpp/releases/download/b11900/llama-b11900-bin-ubuntu-x64.tar.gz
llama_sha256=unpinned
# Test models, Apache-2.0, at the Hugging Face revisions below. The SHA-256 is the LFS object id
# Hugging Face publishes for the file, read from its API on 2026-10-28. They test the adapter;
# the model the image ships is G5's (INFER-A4).
gen_url=https://huggingface.co/Qwen/Qwen3-0.6B-GGUF/resolve/23749fefcc72300e3a2ad315e1317431b06b590a/Qwen3-0.6B-Q8_0.gguf
gen_sha256=9465e63a22add5354d9bb4b99e90117043c7124007664907259bd16d043bb031
embed_url=https://huggingface.co/Qwen/Qwen3-Embedding-0.6B-GGUF/resolve/370f27d7550e0def9b39c1f16d3fbaa13aa67728/Qwen3-Embedding-0.6B-Q8_0.gguf
embed_sha256=06507c7b42688469c4e7298b0a1e16deff06caf291cf0a5b278c308249c3e439
