# agentOS access point loader (P2-1). Installed by the image (image/build.sh)
# to /usr/lib/systemd/system/. It serves the sticker's setup network on the
# radio so a phone can reach the Wi-Fi page (§8.1 step 4; CH-7, HW-10), and
# it drives the access point only through localui.APLoader (DEV-net-h): at
# start it brings every radio down, which also takes back one a dead loader
# left exempt from the inbound drop, before anything joins a network on it.
#
# It runs as root: it loads nftables, restarts agentos-ap-exempt@, gives the
# radio its address, and starts hostapd and dnsmasq (dnsmasq drops to its
# own user). It reads the page's latch, which the page can write, without
# following a link and only so far, and it burns the setup network in
# /var/lib/agentos once the Owner Card step confirms.
[Unit]
Description=agentOS access point loader
# The inbound drop is in place before any radio is brought up.
Requires=agentos-inbound.service
After=agentos-inbound.service
# The page listens on the access point's address.
Before=agentos-localui.service

[Service]
ExecStart=/usr/lib/agentos/agentos-ap -iface wlan0 -addr 10.42.0.1/24 \
        -card-latch /var/lib/agentos-localui/card-latch.json
# A dead hostapd or dnsmasq fails the run; the restart brings every radio
# down and serves again.
Restart=always
RestartSec=5
# hostapd.conf holds the setup network's password (CH-7) while it runs.
RuntimeDirectory=agentos-ap
RuntimeDirectoryMode=0700
# The setup network's password passes through this process (IMG-nodump).
LimitCORE=0

# The radio and its address, the firewall (CAP_NET_ADMIN), hostapd's raw
# sockets, dnsmasq's ports and its drop to its own user, stopping the
# children, and reading the page's latch in its 0700 directory.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/agentos
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Not ~@privileged: dnsmasq calls setuid and setgid to drop to its user.
SystemCallFilter=@system-service
UMask=0077
# hostapd and nft speak netlink; hostapd also uses packet sockets.
# PrivateDevices is left off: hostapd unblocks the radio through /dev/rfkill.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

[Install]
WantedBy=multi-user.target
