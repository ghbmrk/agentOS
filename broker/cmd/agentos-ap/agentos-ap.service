# agentOS access point loader (P2-1). Installed by the image (image/build.sh)
# to /usr/lib/systemd/system/. It serves the sticker's setup network on the
# radio so a phone can reach the Wi-Fi page (§8.1 step 4; CH-7, HW-10), and
# it drives the access point only through localui.APLoader (DEV-net-h): at
# start it brings every radio down, which also takes back one a dead loader
# left exempt from the inbound drop, before anything joins a network on it.
#
# It runs as root: it loads nftables, restarts agentos-ap-exempt@, gives the
# radio its address, and starts hostapd and dnsmasq (dnsmasq drops to its
# own user). hostapd runs as agentos-hostapd with ambient NET_ADMIN and
# NET_RAW only (#1426): as root it would pass egress's uid-0 broker check
# and reach verify.sock. It reads the page's latch, which the page can write, without
# following a link and only so far. At the Owner Card confirm, or once the
# box is owned, it brings the access point down, burns the setup network in
# /var/lib/agentos, and brings it up with the card's network, which the page
# reported through agentosd to /var/lib/agentos/ap-net.json (#1185). It
# serves the card's network at every later start.
[Unit]
Description=agentOS access point loader
# The inbound drop is in place before any radio is brought up. The masks
# below cover only paths that exist at start: egress's state and runtime
# directories do by then, and egress keeps its runtime directory across
# restarts (RuntimeDirectoryPreserve, #1628) so the mask on its sockets
# holds; agentosd's subtrees made after its fork (Type=simple) may
# not, and a restart covers those.
Requires=agentos-inbound.service
After=agentos-inbound.service agentos-egress.service agentosd.service
# The page listens on the access point's address.
Before=agentos-localui.service

[Service]
ExecStart=/usr/lib/agentos/agentos-ap -iface wlan0 -addr 10.42.0.1/24 \
        -card-latch /var/lib/agentos-localui/card-latch.json \
        -ap-net /var/lib/agentos/ap-net.json
# A dead hostapd or dnsmasq fails the run; the restart brings every radio
# down and serves again.
Restart=always
RestartSec=5
# hostapd.conf holds the served network's password (CH-7) while it runs.
RuntimeDirectory=agentos-ap
RuntimeDirectoryMode=0700
# The loader gives /run/agentos-ap (0710) and hostapd.conf (0640) to
# hostapd's group, which it shares for that alone, so it needs no
# CAP_CHOWN. dnsmasq.conf stays root's.
SupplementaryGroups=agentos-hostapd
# The setup network's password passes through this process (IMG-nodump).
LimitCORE=0

# The radio and its address, the firewall (CAP_NET_ADMIN), hostapd's raw
# sockets, dnsmasq's ports, dnsmasq's and hostapd's drops to their own
# users (hostapd keeps ambient NET_ADMIN and NET_RAW, nothing else, and
# CAP_SETPCAP drops the rest from its bounding set),
# stopping the children, and reading the page's latch in the page's 0700
# directory (CAP_DAC_READ_SEARCH). Not CAP_DAC_OVERRIDE: everything it
# writes (/run/agentos-ap, the setup file) is root's in root's
# directories. Not CAP_CHOWN: it gives hostapd.conf to a group it is in.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_READ_SEARCH CAP_SETPCAP
NoNewPrivileges=yes
# Everything is read-only, the page's latch included, but the setup
# file's directory: the burn is a durable rename beside the file, so a
# narrower path cannot hold it. The secrets that share that directory,
# and the vault's, are hidden instead (a path that does not exist yet is
# skipped), and so are the vault's sockets: their only peer check is the
# broker uid, which is root, and the access point never calls them (#1628).
# Owner and guest content and the meter and clock state agentosd trusts
# are hidden too (#2626); TestAgentosdStateIsHidden fails on any state
# path under /var/lib/agentos named in the source and missing here. This
# is still a deny-list: a file agentosd makes after the loader starts
# shows until a restart. The allowlist #2626 asks for needs the three
# files the loader shares with agentosd in their own directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/agentos
InaccessiblePaths=-/var/lib/agentos-egress -/run/agentos-egress -/var/lib/agentos/vault -/var/lib/agentos/machines -/var/lib/agentos/slots -/var/lib/agentos/journal -/var/lib/agentos/journal.log -/var/lib/agentos/change -/var/lib/agentos/recall -/var/lib/agentos/learn -/var/lib/agentos/skills -/var/lib/agentos/modem -/var/lib/agentos/claim.json -/var/lib/agentos/drive-id
InaccessiblePaths=-/var/lib/agentos/digest -/var/lib/agentos/meter.json -/var/lib/agentos/spare-meter.json -/var/lib/agentos/kept-replies.json -/var/lib/agentos/guest-inbox.json -/var/lib/agentos/clock.json -/var/lib/agentos/questions.json -/var/lib/agentos/loop7 -/var/lib/agentos/setup.json -/var/lib/agentos/card-latch.json
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Not ~@privileged: dnsmasq calls setuid and setgid to drop to its user.
SystemCallFilter=@system-service
UMask=0077
# hostapd and nft speak netlink; hostapd also uses packet sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# No block device or TPM: hostapd unblocks the radio through /dev/rfkill,
# the only device beyond the pseudo-devices.
DevicePolicy=closed
DeviceAllow=/dev/rfkill rw

[Install]
WantedBy=multi-user.target
