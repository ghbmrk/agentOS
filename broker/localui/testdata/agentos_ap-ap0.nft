table inet agentos_ap {}
delete table inet agentos_ap
table inet agentos_ap {
  chain input {
    type filter hook input priority filter; policy accept;
    iifname "ap0" ip saddr 10.42.0.0/24 ip daddr 10.42.0.1 tcp dport 80 accept
    iifname "ap0" ip saddr 10.42.0.0/24 ip daddr 10.42.0.1 tcp dport 443 accept
    iifname "ap0" udp dport { 53, 67 } accept
    iifname "ap0" tcp dport 53 accept
    iifname "ap0" drop
    iifname != "ap0" tcp dport 80 ip daddr 10.42.0.1 drop
    iifname != "ap0" tcp dport 443 ip daddr 10.42.0.1 drop
  }
  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "ap0" drop
    oifname "ap0" drop
  }
}
