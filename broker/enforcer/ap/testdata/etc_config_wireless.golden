config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi'
	option band '2g'
	option htmode 'HE20'
	option channel 'auto'
	option country 'US'
	option cell_density '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi+1'
	option band '5g'
	option htmode 'HE80'
	option channel 'auto'
	option country 'US'
	option cell_density '0'

config wifi-iface 'owner_radio0'
	option device 'radio0'
	option mode 'ap'
	option network 'owner'
	option ssid 'Home'
	option encryption 'sae-mixed'
	option key 'CANARYOWNERAAAAAAAAAAAAAAA'
	option ieee80211w '1'
	option wps_pushbutton '0'
	option ieee80211r '0'

config wifi-iface 'household_radio0'
	option device 'radio0'
	option mode 'ap'
	option network 'household'
	option ssid 'Home family'
	option encryption 'sae-mixed'
	option key 'CANARYHOUSEHOLDAAAAAAAAAAA'
	option ieee80211w '1'
	option wps_pushbutton '0'
	option ieee80211r '0'

config wifi-iface 'guests_radio0'
	option device 'radio0'
	option mode 'ap'
	option network 'guests'
	option ssid 'Home guests'
	option encryption 'sae-mixed'
	option key 'CANARYGUESTSAAAAAAAAAAAAAA'
	option ieee80211w '1'
	option wps_pushbutton '0'
	option ieee80211r '0'
	option isolate '1'

config wifi-iface 'owner_radio1'
	option device 'radio1'
	option mode 'ap'
	option network 'owner'
	option ssid 'Home'
	option encryption 'sae-mixed'
	option key 'CANARYOWNERAAAAAAAAAAAAAAA'
	option ieee80211w '1'
	option wps_pushbutton '0'
	option ieee80211r '0'

config wifi-iface 'household_radio1'
	option device 'radio1'
	option mode 'ap'
	option network 'household'
	option ssid 'Home family'
	option encryption 'sae-mixed'
	option key 'CANARYHOUSEHOLDAAAAAAAAAAA'
	option ieee80211w '1'
	option wps_pushbutton '0'
	option ieee80211r '0'

config wifi-iface 'guests_radio1'
	option device 'radio1'
	option mode 'ap'
	option network 'guests'
	option ssid 'Home guests'
	option encryption 'sae-mixed'
	option key 'CANARYGUESTSAAAAAAAAAAAAAA'
	option ieee80211w '1'
	option wps_pushbutton '0'
	option ieee80211r '0'
	option isolate '1'

config wifi-iface 'devices'
	option device 'radio0'
	option mode 'ap'
	option ssid 'Home things'
	option encryption 'psk2+ccmp'
	option key 'CANARYDEVICESUNUSEDAAAAAAA'
	option ieee80211w '1'
	option wps_pushbutton '0'
	option ieee80211r '0'
	option isolate '1'
	option dynamic_vlan '2'

config wifi-vlan
	option name 'v101'
	option iface 'devices'
	option vid '101'
	option network 'v101'

config wifi-station
	option iface 'devices'
	option vid '101'
	option key 'CANARYTVAAAAAAAAAAAAAAAAAA'

config wifi-vlan
	option name 'v102'
	option iface 'devices'
	option vid '102'
	option network 'v102'

config wifi-station
	option iface 'devices'
	option vid '102'
	option key 'CANARYPLUGAAAAAAAAAAAAAAAA'

config wifi-vlan
	option name 'v104'
	option iface 'devices'
	option vid '104'
	option network 'v104'

config wifi-station
	option iface 'devices'
	option vid '104'
	option key 'CANARYCAMAAAAAAAAAAAAAAAAA'
