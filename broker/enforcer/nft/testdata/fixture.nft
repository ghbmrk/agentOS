flush ruleset

table inet enforcer {
	counter guests_out { }
	counter guests_in { }
	counter guests_conns { }
	counter inbound { }
	counter blocked { }
	counter core_device { }
	counter core_stream { }
	counter edge_device { }
	counter edge_in { }
	counter ra_dropped { }
	counter dns_outside { }
	counter ap_admin { }
	counter isp { }
	counter core_edge { }
	set isp_4 {
		type ipv4_addr;
		flags interval;
		elements = { 192.168.1.0/24 }
	}
	set isp_6 {
		type ipv6_addr;
		flags interval;
		elements = { 2001:db8:1::/64 }
	}
	set nonglobal_4 {
		type ipv4_addr;
		flags interval;
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }
	}
	set nonglobal_6 {
		type ipv6_addr;
		flags interval;
		elements = { ::/127, ::ffff:0.0.0.0/96, 64:ff9b:1::/48, fc00::/7, fe80::/10, ff00::/8 }
	}
	set doh_4 {
		type ipv4_addr;
		flags interval;
		elements = { 1.0.0.1, 1.1.1.1, 8.8.4.4, 8.8.8.8, 9.9.9.9, 45.90.28.0/24, 45.90.30.0/24, 94.140.14.14, 94.140.15.15, 149.112.112.112, 185.228.168.9, 208.67.220.220, 208.67.222.222 }
	}
	set doh_6 {
		type ipv6_addr;
		flags interval;
		elements = { 2001:4860:4860::8844, 2001:4860:4860::8888, 2606:4700:4700::1001, 2606:4700:4700::1111, 2620:fe::9, 2620:fe::fe, 2a07:a8c0::/33, 2a10:50c0::ad1:ff, 2a10:50c0::ad2:ff }
	}
	set ap_4 {
		type ipv4_addr;
		elements = { 10.70.0.2 }
	}
	set ap_6 {
		type ipv6_addr;
	}
	set core_4 {
		type ipv4_addr;
		flags timeout;
	}
	set core_6 {
		type ipv6_addr;
		flags timeout;
	}
	set d101_4 {
		type ipv4_addr;
		flags timeout;
	}
	set d101_6 {
		type ipv6_addr;
		flags timeout;
	}
	set d103_4 {
		type ipv4_addr;
		flags timeout;
	}
	set d103_6 {
		type ipv6_addr;
		flags timeout;
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		iifname "edge0" counter name "edge_in" drop
		ct state invalid drop
		ct state established,related accept
		icmpv6 type nd-router-advert iifname != "wan0" counter name "ra_dropped" drop
		iifname "wan0" udp sport 67 udp dport 68 accept
		iifname "wan0" udp sport 547 udp dport 546 accept
		iifname "wan0" icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
		iifname "wan0" log prefix "enf inbound " counter name "inbound" drop
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } accept
		iifname { "own0", "hh0", "gst0", "adm0", "core0", "ap0.*" } udp dport { 53, 67, 547 } accept
		iifname { "own0", "hh0", "gst0", "adm0", "core0", "ap0.*" } tcp dport 53 accept
		iifname { "own0", "adm0" } tcp dport 8443 accept
		iifname "core0" tcp dport 7443 accept
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname "gst0" counter name "guests_out"
		oifname "gst0" counter name "guests_in"
		iifname "gst0" ct state new counter name "guests_conns"
		ct state invalid drop
		ct state established,related accept
		iifname "wan0" log prefix "enf inbound " counter name "inbound" drop
		iifname "gst0" oifname "wan0" ip daddr != @isp_4 ip daddr != @nonglobal_4 accept
		iifname "gst0" oifname "wan0" ip6 daddr != @isp_6 ip6 daddr != @nonglobal_6 accept
		iifname "gst0" drop
		iifname { "own0", "hh0" } jump people
		iifname "adm0" oifname "apm0" ip daddr @ap_4 accept
		iifname "adm0" oifname "apm0" ip6 daddr @ap_6 accept
		ip daddr @ap_4 log prefix "enf ap-admin " counter name "ap_admin" drop
		ip6 daddr @ap_6 log prefix "enf ap-admin " counter name "ap_admin" drop
		ip daddr @isp_4 log prefix "enf isp " counter name "isp" drop
		ip6 daddr @isp_6 log prefix "enf isp " counter name "isp" drop
		oifname "wan0" ip daddr @nonglobal_4 log prefix "enf nonglobal " counter name "blocked" drop
		oifname "wan0" ip6 daddr @nonglobal_6 log prefix "enf nonglobal " counter name "blocked" drop
		iifname "edge0" oifname "core0" log prefix "enf core-edge " counter name "core_edge" drop
		iifname "core0" oifname "edge0" log prefix "enf core-edge " counter name "core_edge" drop
		iifname "adm0" oifname "core0" tcp dport 443 accept
		iifname "edge0" oifname "wan0" accept
		iifname "core0" oifname "wan0" ip daddr @core_4 accept
		iifname "core0" oifname "wan0" ip6 daddr @core_6 accept
		iifname "ap0.*" oifname "wan0" ip daddr @doh_4 log prefix "enf dns " counter name "dns_outside" drop
		iifname "ap0.*" oifname "wan0" ip6 daddr @doh_6 log prefix "enf dns " counter name "dns_outside" drop
		iifname "ap0.*" oifname "wan0" meta l4proto { tcp, udp } th dport { 53, 853 } log prefix "enf dns " counter name "dns_outside" drop
		iifname "ap0.101" oifname "wan0" ip daddr @d101_4 accept
		iifname "ap0.101" oifname "wan0" ip6 daddr @d101_6 accept
		iifname "edge0" oifname "ap0.101" tcp dport { 80 } log prefix "enf edge-dev 101 " counter name "edge_device" accept
		iifname "core0" oifname "ap0.102" tcp dport { 80 } log prefix "enf core-dev 102 " counter name "core_device" accept
		iifname "core0" oifname "ap0.102" udp dport { 123 } log prefix "enf core-dev 102 " counter name "core_device" accept
		iifname "ap0.103" oifname "wan0" ip daddr @d103_4 accept
		iifname "ap0.103" oifname "wan0" ip6 daddr @d103_6 accept
		iifname "core0" oifname "ap0.104" tcp dport { 554 } log prefix "enf core-stream 104 " counter name "core_stream" accept
		iifname "ap0.106" oifname "ap0.107" accept
		iifname "ap0.107" oifname "ap0.106" accept
		log prefix "enf drop " counter name "blocked" drop
	}
	chain people {
		ip daddr @ap_4 drop
		ip6 daddr @ap_6 drop
		ip daddr @isp_4 drop
		ip6 daddr @isp_6 drop
		oifname "wan0" ip daddr @nonglobal_4 drop
		oifname "wan0" ip6 daddr @nonglobal_6 drop
		oifname "wan0" accept
		iifname "own0" oifname "core0" tcp dport 443 accept
		iifname "hh0" oifname "ap0.105" accept
		drop
	}
	chain output {
		type filter hook output priority filter; policy accept;
		oifname "edge0" drop
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "wan0" masquerade
	}
}

table arp enforcer_arp {
	chain input {
		type filter hook input priority filter; policy accept;
		iifname "edge0" arp operation request arp daddr ip != 10.60.0.1 drop
	}
}
