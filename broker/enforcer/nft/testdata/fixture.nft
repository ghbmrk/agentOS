flush ruleset

table inet enforcer {
	counter guests_out { }
	counter guests_in { }
	counter guests_conns { }
	counter inbound { }
	counter blocked { }
	counter core_device { }
	counter core_stream { }
	counter edge_device { }
	counter edge_in { }
	counter ra_dropped { }
	counter dns_outside { }
	counter dns_redirect { }
	counter spoofed { }
	counter ap_admin { }
	counter isp { }
	counter core_edge { }
	counter t101_out { }
	counter t101_in { }
	counter t102_out { }
	counter t102_in { }
	counter t103_out { }
	counter t103_in { }
	counter t104_out { }
	counter t104_in { }
	counter t105_out { }
	counter t105_in { }
	counter t106_out { }
	counter t106_in { }
	counter t107_out { }
	counter t107_in { }
	set isp_4 {
		type ipv4_addr;
		flags interval;
		elements = { 192.168.1.0/24 }
	}
	set isp_6 {
		type ipv6_addr;
		flags interval;
		elements = { 2001:db8:1::/64 }
	}
	set nonglobal_4 {
		type ipv4_addr;
		flags interval;
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }
	}
	set nonglobal_6 {
		type ipv6_addr;
		flags interval;
		elements = { ::/127, ::ffff:0.0.0.0/96, 64:ff9b:1::/48, fc00::/7, fe80::/10, ff00::/8 }
	}
	set doh_4 {
		type ipv4_addr;
		flags interval;
		elements = { 1.0.0.1, 1.1.1.1, 8.8.4.4, 8.8.8.8, 9.9.9.9, 45.90.28.0/24, 45.90.30.0/24, 94.140.14.14, 94.140.15.15, 149.112.112.112, 185.228.168.9, 208.67.220.220, 208.67.222.222 }
	}
	set doh_6 {
		type ipv6_addr;
		flags interval;
		elements = { 2001:4860:4860::8844, 2001:4860:4860::8888, 2606:4700:4700::1001, 2606:4700:4700::1111, 2620:fe::9, 2620:fe::fe, 2a07:a8c0::/33, 2a10:50c0::ad1:ff, 2a10:50c0::ad2:ff }
	}
	set ap_4 {
		type ipv4_addr;
		elements = { 10.70.0.2 }
	}
	set ap_6 {
		type ipv6_addr;
	}
	set core_4 {
		type ipv4_addr;
		flags timeout;
	}
	set core_6 {
		type ipv6_addr;
		flags timeout;
	}
	set d101_4 {
		type ipv4_addr;
		flags timeout;
	}
	set d101_6 {
		type ipv6_addr;
		flags timeout;
	}
	set d103_4 {
		type ipv4_addr;
		flags timeout;
	}
	set d103_6 {
		type ipv6_addr;
		flags timeout;
	}
	set t101_4 {
		type ipv4_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t101_6 {
		type ipv6_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t102_4 {
		type ipv4_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t102_6 {
		type ipv6_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t103_4 {
		type ipv4_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t103_6 {
		type ipv6_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t104_4 {
		type ipv4_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t104_6 {
		type ipv6_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t105_4 {
		type ipv4_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t105_6 {
		type ipv6_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t106_4 {
		type ipv4_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t106_6 {
		type ipv6_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t107_4 {
		type ipv4_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	set t107_6 {
		type ipv6_addr;
		size 64;
		flags dynamic,timeout;
		timeout 1d;
	}
	chain rpf {
		type filter hook prerouting priority raw; policy accept;
		iif "lo" accept
		ip saddr 0.0.0.0 udp sport 68 udp dport 67 accept
		ip6 saddr :: meta l4proto ipv6-icmp accept
		fib saddr . iif oif missing counter name "spoofed" drop
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		iifname "edge0" counter name "edge_in" drop
		ct state invalid drop
		ct state established,related accept
		icmpv6 type nd-router-advert iifname != "wan0" counter name "ra_dropped" drop
		iifname "wan0" udp sport 67 udp dport 68 accept
		iifname "wan0" udp sport 547 udp dport 546 accept
		iifname "wan0" icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
		iifname "wan0" log prefix "enf inbound " counter name "inbound" drop
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } accept
		iifname { "own0", "hh0", "gst0", "adm0", "core0", "ap0.*" } udp dport { 53, 67, 547 } accept
		iifname { "own0", "hh0", "gst0", "adm0", "core0", "ap0.*" } tcp dport 53 accept
		iifname { "own0", "adm0" } tcp dport 8443 accept
		iifname "core0" tcp dport 7443 accept
		iifname "core0" udp dport 9 accept
		iifname { "ap0.105", "ap0.106", "ap0.107", "hh0" } ip daddr 224.0.0.251 udp dport 5353 accept
		iifname { "ap0.105", "ap0.106", "ap0.107", "hh0" } ip6 daddr ff02::fb udp dport 5353 accept
	}
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "ap0.*" meta l4proto { tcp, udp } th dport 53 counter name "dns_redirect" redirect
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname "gst0" counter name "guests_out"
		oifname "gst0" counter name "guests_in"
		iifname "gst0" ct state new counter name "guests_conns"
		ct state invalid drop
		ct state established,related jump forward_live
		ct state established iifname vmap { "ap0.101" : jump t101_out_count, "ap0.102" : jump t102_out_count, "ap0.103" : jump t103_out_count, "ap0.104" : jump t104_out_count, "ap0.105" : jump t105_out_count, "ap0.106" : jump t106_out_count, "ap0.107" : jump t107_out_count }
		ct state established oifname vmap { "ap0.101" : jump t101_in_count, "ap0.102" : jump t102_in_count, "ap0.103" : jump t103_in_count, "ap0.104" : jump t104_in_count, "ap0.105" : jump t105_in_count, "ap0.106" : jump t106_in_count, "ap0.107" : jump t107_in_count }
		ct state established,related accept
		iifname "wan0" log prefix "enf inbound " counter name "inbound" drop
		iifname "gst0" oifname "wan0" ip daddr != @isp_4 ip daddr != @nonglobal_4 ct mark set 0x10011004 accept
		iifname "gst0" oifname "wan0" ip6 daddr != @isp_6 ip6 daddr != @nonglobal_6 ct mark set 0x10011004 accept
		iifname "gst0" drop
		iifname { "own0", "hh0" } jump people
		iifname "adm0" oifname "apm0" ip daddr @ap_4 ct mark set 0x10081005 accept
		iifname "adm0" oifname "apm0" ip6 daddr @ap_6 ct mark set 0x10081005 accept
		ip daddr @ap_4 log prefix "enf ap-admin " counter name "ap_admin" drop
		ip6 daddr @ap_6 log prefix "enf ap-admin " counter name "ap_admin" drop
		ip daddr @isp_4 log prefix "enf isp " counter name "isp" drop
		ip6 daddr @isp_6 log prefix "enf isp " counter name "isp" drop
		oifname "wan0" ip daddr @nonglobal_4 log prefix "enf nonglobal " counter name "blocked" drop
		oifname "wan0" ip6 daddr @nonglobal_6 log prefix "enf nonglobal " counter name "blocked" drop
		iifname "edge0" oifname "core0" log prefix "enf core-edge " counter name "core_edge" drop
		iifname "core0" oifname "edge0" log prefix "enf core-edge " counter name "core_edge" drop
		iifname "adm0" oifname "core0" tcp dport 443 ct mark set 0x10061005 accept
		iifname "edge0" oifname "wan0" ct mark set 0x10011007 accept
		iifname "core0" oifname "wan0" ip daddr @core_4 ct mark set 0x10011006 accept
		iifname "core0" oifname "wan0" ip6 daddr @core_6 ct mark set 0x10011006 accept
		iifname "ap0.*" oifname "wan0" ip daddr @doh_4 log prefix "enf dns " counter name "dns_outside" drop
		iifname "ap0.*" oifname "wan0" ip6 daddr @doh_6 log prefix "enf dns " counter name "dns_outside" drop
		iifname "ap0.*" oifname "wan0" meta l4proto { tcp, udp } th dport { 53, 853 } log prefix "enf dns " counter name "dns_outside" drop
		iifname "ap0.101" oifname "wan0" ip daddr @d101_4 ct mark set 0x10010065 accept
		iifname "ap0.101" oifname "wan0" ip6 daddr @d101_6 ct mark set 0x10010065 accept
		iifname "edge0" oifname "ap0.101" tcp dport { 80 } ct mark set 0x00651007 log prefix "enf edge-dev 101 " counter name "edge_device" accept
		iifname "core0" oifname "ap0.102" tcp dport { 80 } ct mark set 0x00661006 log prefix "enf core-dev 102 " counter name "core_device" accept
		iifname "core0" oifname "ap0.102" udp dport { 123 } ct mark set 0x00661006 log prefix "enf core-dev 102 " counter name "core_device" accept
		iifname "ap0.103" oifname "wan0" ip daddr @d103_4 ct mark set 0x10010067 accept
		iifname "ap0.103" oifname "wan0" ip6 daddr @d103_6 ct mark set 0x10010067 accept
		iifname "core0" oifname "ap0.104" tcp dport { 554 } ct mark set 0x00681006 log prefix "enf core-stream 104 " counter name "core_stream" accept
		iifname "ap0.106" oifname "ap0.107" ct mark set 0x006b006a accept
		iifname "ap0.107" oifname "ap0.106" ct mark set 0x006a006b accept
		log prefix "enf drop " counter name "blocked" drop
	}
	chain people {
		ip daddr @ap_4 drop
		ip6 daddr @ap_6 drop
		ip daddr @isp_4 drop
		ip6 daddr @isp_6 drop
		oifname "wan0" ip daddr @nonglobal_4 drop
		oifname "wan0" ip6 daddr @nonglobal_6 drop
		iifname "own0" oifname "wan0" ct mark set 0x10011002 accept
		iifname "hh0" oifname "wan0" ct mark set 0x10011003 accept
		iifname "own0" oifname "core0" tcp dport 443 ct mark set 0x10061002 accept
		iifname "hh0" oifname "ap0.105" ct mark set 0x00691003 accept
		drop
	}
	chain forward_live {
		ct direction original iifname "wan0" drop
		ct direction reply oifname "wan0" drop
		ct direction original iifname "gst0" oifname "wan0" ct original ip daddr != @isp_4 ct original ip daddr != @nonglobal_4 ct mark 0x10011004 return
		ct direction reply iifname "wan0" oifname "gst0" ct original ip daddr != @isp_4 ct original ip daddr != @nonglobal_4 ct mark 0x10011004 return
		ct direction original iifname "gst0" oifname "wan0" ct original ip6 daddr != @isp_6 ct original ip6 daddr != @nonglobal_6 ct mark 0x10011004 return
		ct direction reply iifname "wan0" oifname "gst0" ct original ip6 daddr != @isp_6 ct original ip6 daddr != @nonglobal_6 ct mark 0x10011004 return
		ct direction original iifname "gst0" drop
		ct direction reply oifname "gst0" drop
		ct direction original iifname { "own0", "hh0" } goto people_live
		ct direction reply oifname { "own0", "hh0" } goto people_live
		ct direction original iifname "adm0" oifname "apm0" ct original ip daddr @ap_4 ct mark 0x10081005 return
		ct direction reply iifname "apm0" oifname "adm0" ct original ip daddr @ap_4 ct mark 0x10081005 return
		ct direction original iifname "adm0" oifname "apm0" ct original ip6 daddr @ap_6 ct mark 0x10081005 return
		ct direction reply iifname "apm0" oifname "adm0" ct original ip6 daddr @ap_6 ct mark 0x10081005 return
		ct original ip daddr @ap_4 drop
		ct original ip6 daddr @ap_6 drop
		ct original ip daddr @isp_4 drop
		ct original ip6 daddr @isp_6 drop
		ct direction original oifname "wan0" ct original ip daddr @nonglobal_4 drop
		ct direction reply iifname "wan0" ct original ip daddr @nonglobal_4 drop
		ct direction original oifname "wan0" ct original ip6 daddr @nonglobal_6 drop
		ct direction reply iifname "wan0" ct original ip6 daddr @nonglobal_6 drop
		ct direction original iifname "edge0" oifname "core0" drop
		ct direction reply iifname "core0" oifname "edge0" drop
		ct direction original iifname "core0" oifname "edge0" drop
		ct direction reply iifname "edge0" oifname "core0" drop
		ct direction original iifname "adm0" oifname "core0" ct protocol tcp ct original proto-dst 443 ct mark 0x10061005 return
		ct direction reply iifname "core0" oifname "adm0" ct protocol tcp ct original proto-dst 443 ct mark 0x10061005 return
		ct direction original iifname "edge0" oifname "wan0" ct mark 0x10011007 return
		ct direction reply iifname "wan0" oifname "edge0" ct mark 0x10011007 return
		ct direction original iifname "core0" oifname "wan0" meta nfproto ipv4 ct mark 0x10011006 return
		ct direction reply iifname "wan0" oifname "core0" meta nfproto ipv4 ct mark 0x10011006 return
		ct direction original iifname "core0" oifname "wan0" meta nfproto ipv6 ct mark 0x10011006 return
		ct direction reply iifname "wan0" oifname "core0" meta nfproto ipv6 ct mark 0x10011006 return
		ct direction original iifname "ap0.*" oifname "wan0" ct original ip daddr @doh_4 drop
		ct direction reply iifname "wan0" oifname "ap0.*" ct original ip daddr @doh_4 drop
		ct direction original iifname "ap0.*" oifname "wan0" ct original ip6 daddr @doh_6 drop
		ct direction reply iifname "wan0" oifname "ap0.*" ct original ip6 daddr @doh_6 drop
		ct direction original iifname "ap0.*" oifname "wan0" ct protocol { tcp, udp } ct original proto-dst { 53, 853 } drop
		ct direction reply iifname "wan0" oifname "ap0.*" ct protocol { tcp, udp } ct original proto-dst { 53, 853 } drop
		ct direction original iifname "ap0.101" oifname "wan0" meta nfproto ipv4 ct mark 0x10010065 return
		ct direction reply iifname "wan0" oifname "ap0.101" meta nfproto ipv4 ct mark 0x10010065 return
		ct direction original iifname "ap0.101" oifname "wan0" meta nfproto ipv6 ct mark 0x10010065 return
		ct direction reply iifname "wan0" oifname "ap0.101" meta nfproto ipv6 ct mark 0x10010065 return
		ct direction original iifname "edge0" oifname "ap0.101" ct protocol tcp ct original proto-dst { 80 } ct mark 0x00651007 return
		ct direction reply iifname "ap0.101" oifname "edge0" ct protocol tcp ct original proto-dst { 80 } ct mark 0x00651007 return
		ct direction original iifname "core0" oifname "ap0.102" ct protocol tcp ct original proto-dst { 80 } ct mark 0x00661006 return
		ct direction reply iifname "ap0.102" oifname "core0" ct protocol tcp ct original proto-dst { 80 } ct mark 0x00661006 return
		ct direction original iifname "core0" oifname "ap0.102" ct protocol udp ct original proto-dst { 123 } ct mark 0x00661006 return
		ct direction reply iifname "ap0.102" oifname "core0" ct protocol udp ct original proto-dst { 123 } ct mark 0x00661006 return
		ct direction original iifname "ap0.103" oifname "wan0" meta nfproto ipv4 ct mark 0x10010067 return
		ct direction reply iifname "wan0" oifname "ap0.103" meta nfproto ipv4 ct mark 0x10010067 return
		ct direction original iifname "ap0.103" oifname "wan0" meta nfproto ipv6 ct mark 0x10010067 return
		ct direction reply iifname "wan0" oifname "ap0.103" meta nfproto ipv6 ct mark 0x10010067 return
		ct direction original iifname "core0" oifname "ap0.104" ct protocol tcp ct original proto-dst { 554 } ct mark 0x00681006 return
		ct direction reply iifname "ap0.104" oifname "core0" ct protocol tcp ct original proto-dst { 554 } ct mark 0x00681006 return
		ct direction original iifname "ap0.106" oifname "ap0.107" ct mark 0x006b006a return
		ct direction reply iifname "ap0.107" oifname "ap0.106" ct mark 0x006b006a return
		ct direction original iifname "ap0.107" oifname "ap0.106" ct mark 0x006a006b return
		ct direction reply iifname "ap0.106" oifname "ap0.107" ct mark 0x006a006b return
		drop
	}
	chain people_live {
		ct original ip daddr @ap_4 drop
		ct original ip6 daddr @ap_6 drop
		ct original ip daddr @isp_4 drop
		ct original ip6 daddr @isp_6 drop
		ct direction original oifname "wan0" ct original ip daddr @nonglobal_4 drop
		ct direction reply iifname "wan0" ct original ip daddr @nonglobal_4 drop
		ct direction original oifname "wan0" ct original ip6 daddr @nonglobal_6 drop
		ct direction reply iifname "wan0" ct original ip6 daddr @nonglobal_6 drop
		ct direction original iifname "own0" oifname "wan0" ct mark 0x10011002 return
		ct direction reply iifname "wan0" oifname "own0" ct mark 0x10011002 return
		ct direction original iifname "hh0" oifname "wan0" ct mark 0x10011003 return
		ct direction reply iifname "wan0" oifname "hh0" ct mark 0x10011003 return
		ct direction original iifname "own0" oifname "core0" ct protocol tcp ct original proto-dst 443 ct mark 0x10061002 return
		ct direction reply iifname "core0" oifname "own0" ct protocol tcp ct original proto-dst 443 ct mark 0x10061002 return
		ct direction original iifname "hh0" oifname "ap0.105" ct mark 0x00691003 return
		ct direction reply iifname "ap0.105" oifname "hh0" ct mark 0x00691003 return
		drop
	}
	chain t101_out_count {
		counter name "t101_out"
		oifname "wan0" update @t101_4 { ip daddr counter }
		oifname "wan0" update @t101_6 { ip6 daddr counter }
	}
	chain t101_in_count {
		counter name "t101_in"
		iifname "wan0" update @t101_4 { ip saddr counter }
		iifname "wan0" update @t101_6 { ip6 saddr counter }
	}
	chain t102_out_count {
		counter name "t102_out"
		oifname "wan0" update @t102_4 { ip daddr counter }
		oifname "wan0" update @t102_6 { ip6 daddr counter }
	}
	chain t102_in_count {
		counter name "t102_in"
		iifname "wan0" update @t102_4 { ip saddr counter }
		iifname "wan0" update @t102_6 { ip6 saddr counter }
	}
	chain t103_out_count {
		counter name "t103_out"
		oifname "wan0" update @t103_4 { ip daddr counter }
		oifname "wan0" update @t103_6 { ip6 daddr counter }
	}
	chain t103_in_count {
		counter name "t103_in"
		iifname "wan0" update @t103_4 { ip saddr counter }
		iifname "wan0" update @t103_6 { ip6 saddr counter }
	}
	chain t104_out_count {
		counter name "t104_out"
		oifname "wan0" update @t104_4 { ip daddr counter }
		oifname "wan0" update @t104_6 { ip6 daddr counter }
	}
	chain t104_in_count {
		counter name "t104_in"
		iifname "wan0" update @t104_4 { ip saddr counter }
		iifname "wan0" update @t104_6 { ip6 saddr counter }
	}
	chain t105_out_count {
		counter name "t105_out"
		oifname "wan0" update @t105_4 { ip daddr counter }
		oifname "wan0" update @t105_6 { ip6 daddr counter }
	}
	chain t105_in_count {
		counter name "t105_in"
		iifname "wan0" update @t105_4 { ip saddr counter }
		iifname "wan0" update @t105_6 { ip6 saddr counter }
	}
	chain t106_out_count {
		counter name "t106_out"
		oifname "wan0" update @t106_4 { ip daddr counter }
		oifname "wan0" update @t106_6 { ip6 daddr counter }
	}
	chain t106_in_count {
		counter name "t106_in"
		iifname "wan0" update @t106_4 { ip saddr counter }
		iifname "wan0" update @t106_6 { ip6 saddr counter }
	}
	chain t107_out_count {
		counter name "t107_out"
		oifname "wan0" update @t107_4 { ip daddr counter }
		oifname "wan0" update @t107_6 { ip6 daddr counter }
	}
	chain t107_in_count {
		counter name "t107_in"
		iifname "wan0" update @t107_4 { ip saddr counter }
		iifname "wan0" update @t107_6 { ip6 saddr counter }
	}
	chain output {
		type filter hook output priority filter; policy accept;
		oifname "edge0" drop
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "wan0" masquerade
	}
}

table arp enforcer_arp {
	chain input {
		type filter hook input priority filter; policy accept;
		iifname "edge0" arp operation request arp daddr ip != 10.60.0.1 drop
	}
}
