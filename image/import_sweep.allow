# The files of the built image (main tree and initrds) that may import or reach glibc's regex engine
# (DEBIAN-CVE-2026-100290, #5697): one glob per line, each a file the image -100290 record in
# assurance/vulncheck.json names. image/import_sweep.py --summary fails on a file that matches none,
# and on a glob that matches no file. A file naming a function counts as importing it: by its dynamic
# imports, by a dlsym or dlvsym lookup of a name it holds, or as a static copy of glibc's code (#6298).
# Only files whose own regex use the record explains are named here: command-line tools, the guests'
# shells and libraries. "via GLOB" (#6297) accepts every file that reaches the functions only through
# libraries GLOB names, each with an entry of its own, and imports none itself: such a file can call them
# only through the library's code. A via entry accepts each new dependent of its library without an entry
# of its own, a long-lived or network-facing process among them, so the library's own entry, and its
# comment here, is where the review sits: it has to cover every input the library's callers can pass. A
# file importing a function itself always needs its own entry, and a via entry that accepts no file fails
# as a glob that matches none does.

# Shell and text tools, run locally.
/usr/bin/bash
/usr/bin/csplit
/usr/bin/du
/usr/bin/expr
/usr/bin/find
/usr/bin/grep
/usr/bin/hardlink
/usr/bin/kmod
/usr/bin/less
/usr/bin/localedef
/usr/bin/more
/usr/bin/nl
/usr/bin/ptx
/usr/bin/run-parts
/usr/bin/sed
/usr/bin/tac

# Tools that import only glibc's rpmatch, which runs the locale's YESEXPR on a yes/no answer to an
# interactive prompt (cp -i, rm -i and the like).
/usr/bin/cp
/usr/bin/install
/usr/bin/ln
/usr/bin/mv
/usr/bin/rename.ul
/usr/bin/rm

# The guests' bash, an agent-driven shell inside the guest sandbox, and their rm (rpmatch), both
# linking the guest's own glibc (the image/guest -100290 record).
/usr/lib/agentos/images/*/bin/bash
/usr/lib/agentos/images/*/bin/rm

# libsmartcols (filters, and rpmatch) and the util-linux tools that need it (findmnt, lsblk, losetup,
# swapon and the rest); fdisk, sfdisk and cfdisk also import rpmatch for their prompts.
/usr/lib/x86_64-linux-gnu/libsmartcols.so.1.*
via /usr/lib/x86_64-linux-gnu/libsmartcols.so.1.*
/usr/sbin/cfdisk
/usr/sbin/fdisk
/usr/sbin/sfdisk

# libcryptsetup (its one regcomp parses FileVault2 metadata) and what needs it: its token plugins,
# systemd's cryptsetup, cryptenroll, integritysetup and veritysetup, and cryptsetup's own tools.
/usr/lib/x86_64-linux-gnu/libcryptsetup.so.12.*
via /usr/lib/x86_64-linux-gnu/libcryptsetup.so.12.*

# libedit (line editing) and nft, which needs it for its interactive mode; nft itself is a one-shot
# ruleset load.
/usr/lib/x86_64-linux-gnu/libedit.so.2.*
via /usr/lib/x86_64-linux-gnu/libedit.so.2.*

# libformw (ncurses forms); nothing in the image needs it.
/usr/lib/x86_64-linux-gnu/libformw.so.6.*

[glob]
# The files of the built image (main tree and initrds) that may import or reach glibc's glob(), glob64 or
# wordexp, which calls glob() (DEBIAN-CVE-2026-126765, #6285): one entry per line, each a file the
# -126765 records in assurance/vulncheck.json name, or "via GLOB" for the files reaching it only through
# a library with its own entry. As for the regex list above, a file no entry accepts fails the step, and
# so does an entry that accepts no file.

# libsystemd-shared's one glob() call is basic/glob-util.c safe_glob (systemd 257.13), behind glob_first,
# glob_extend and glob_exists. Its callers and their patterns: PID 1 and systemd-executor (libsystemd-core)
# for unit settings (EnvironmentFile=, ImportCredential=, PathExistsGlob=, ConditionPathExistsGlob=);
# networkd and udevd for the conditions of .network, .netdev and .link files; systemd-analyze for a
# condition on its command line; systemd-sysctl and systemd-tmpfiles for sysctl.d and tmpfiles.d
# entries; journalctl for --file. Each pattern is root-owned configuration (no agentOS process
# starts a transient unit) or the command line of a root tool; none comes from the network or a guest.
/usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-*.so

# The files that reach glob() only through libsystemd-shared (systemctl, journald, logind, resolved,
# networkd, udevd's helpers, the generators, libsystemd-core, the cryptsetup token plugins and the rest);
# none of them but those named above calls into safe_glob's wrappers, so linking it is all they share.
via /usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-*.so

# iproute2's ip: its one glob() (ip/iptuntap.c, 6.15) walks the fixed pattern /proc/[0-9]*/fd/[0-9]*
# for "ip tuntap show".
/usr/bin/ip

# libnftables globs an "include" path in a ruleset. nft loads only rulesets agentOS renders (port1's
# fixed set commands and a name matching [a-zA-Z0-9_.-], the enforcer's tables) or root-owned files;
# none holds an include.
/usr/lib/x86_64-linux-gnu/libnftables.so.1.*
via /usr/lib/x86_64-linux-gnu/libnftables.so.1.*

# libpopt globs only in its config readers (poptReadConfigFiles, poptReadDefaultConfig and poptInit,
# src/poptconfig.c); cryptsetup 2.7.5's tools call none of them.
/usr/lib/x86_64-linux-gnu/libpopt.so.0.*
via /usr/lib/x86_64-linux-gnu/libpopt.so.0.*

# PAM modules globbing their own root-owned config directories (/etc/security/access.d, limits.d and
# namespace.d); a module runs only in a process that loads PAM, and its patterns are fixed paths.
/usr/lib/x86_64-linux-gnu/security/pam_access.so
/usr/lib/x86_64-linux-gnu/security/pam_limits.so
/usr/lib/x86_64-linux-gnu/security/pam_namespace.so

[cipher]
# The files of the built image (main tree and initrds) whose bytes name an OpenSSL by-name cipher
# selector (import_sweep.py CIPHER_NAMES: EVP_CIPHER_fetch, EVP_get_cipherbyname, systemd's
# openssl_cipher_many, EVP_CIPHER_do_all_provided, EVP_CIPHER_is_a, OSSL_ENCODER_CTX_set_cipher) or spell
# GCM-SIV or KRB5KDF (SPELT), each with the SHA-256 of the file reviewed and the references to them it
# holds (instructions naming them and data relocations against them, and a SPELT name the times it is
# spelt), or "*" where they are not counted (#5341). The SHA-256 keys an entry to the package version
# whose source was read: an update that keeps the counts but changes where a name comes from still fails
# (#5861). Each file matches one entry; read_allow refuses a malformed, empty or repeated entry.
# AES-GCM-SIV has no OID or NID in OpenSSL 3.5.7, so it is selected only by one of the names
# AES-128-GCM-SIV, AES-192-GCM-SIV or AES-256-GCM-SIV (or a MAC or KDF "cipher" parameter, which has to
# spell one; CMAC, GMAC, KBKDF and CTR-DRBG refuse it by mode, and KRB5KDF's callers are counted).
# EVP_get_cipherbyname cannot return it at all: it returns only the legacy method table's ciphers
# (crypto/evp/names.c), and crypto/evp/c_allc.c adds no GCM-SIV; its references are counted so that a
# change to the file is still seen. A new file, a changed count or changed bytes fail the step: review
# where its names come from, then add or update the entry and the openssl records' reach note.

# libcryptsetup's one fetch (crypto_openssl.c _cipher_init, 2.7.5) asks for "<cipher>-<key bits>-<mode>",
# the mode cut at its first '-' by every caller that takes it from a header (crypto_storage.c
# crypt_storage_init, for LUKS1 and LUKS2 keyslots and reencryption; tcrypt.c from its fixed table). The
# name always ends in "-<digits>-<a part with no '-'>", which no AES-GCM-SIV name does ("-GCM-SIV"), so no
# header, LUKS1's raw cipher field included, can select it. FileVault2 and BitLocker use fixed ciphers.
/usr/lib/x86_64-linux-gnu/libcryptsetup.so.12.* sha256=3fdc2e4c8c0e05bb85a446d96b7407a4ba2eda2d25e3ab24379d2ca2e063e2d3 EVP_CIPHER_fetch=1

# libsystemd-shared's openssl_cipher_many formats "%s-%zu-%s" from its caller; its one caller
# (tpm2-util.c tpm2_calculate_seal's import path, v257) maps a TPM parent key's algorithm and mode ids
# to "aes" and one of ctr, ofb, cbc, cfb or ecb, none of which names GCM-SIV.
/usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-*.so sha256=9f6f06ff4883d23eee5e628c625878e8bc7f60613e945e04ead7793ae969f37c EVP_CIPHER_fetch=1 openssl_cipher_many=1

# OpenSSL itself. libcrypto's internal fetches take the name from an OID (none names AES-GCM-SIV) or from
# its API caller. A caller handing it to a selector holds the selector's name, so its own entry here covers
# it. A caller passing it as an OSSL_PARAM "cipher" to a MAC, KDF or DRBG holds no selector name, so its
# entry does not: CMAC, GMAC, KBKDF and CTR-DRBG refuse GCM-SIV by mode, and of the rest only KRB5KDF takes
# a cipher, so its callers spell "KRB5KDF" and are counted (SPELT; #5861). The image build of #5861 found
# it spelt only by OpenSSL copies' own provider tables (libcrypto here, the guests' node and codex below),
# so KRB5KDF has no caller in the image. libssl fetches only its cipher
# suites' fixed names, and no TLS suite uses AES-GCM-SIV; the openssl CLI takes a name from its command
# line, which nothing on the box runs (the records' QUIC and CMS reasoning). Their sites are not counted.
/usr/lib/x86_64-linux-gnu/libcrypto.so.3 *
/usr/lib/x86_64-linux-gnu/libssl.so.3 *
/usr/bin/openssl *

# OpenSSL's loader_attic engine: both fetches are of the fixed name "RC4" (crypto/pem/pvkfmt.c, built
# into it); nothing on the box loads engines.
/usr/lib/x86_64-linux-gnu/engines-3/loader_attic.so sha256=2c99266b31bfc02d011955db1600bd36146554cd6970d3cbfe46011e11014c83 EVP_CIPHER_fetch=2
# The legacy provider: its one fetch and one EVP_get_cipherbyname are providers/common/provider_util.c
# ossl_prov_cipher_load_from_params, for an algorithm's "cipher" parameter; none of legacy's algorithms
# (old digests and ciphers, PBKDF1, PVKKDF) takes one.
/usr/lib/x86_64-linux-gnu/ossl-modules/legacy.so sha256=533bb6758a00a87a2d7835bcd3ebca58e0def2c1096ec582dea180adceeb7404 EVP_CIPHER_fetch=1 EVP_get_cipherbyname=1

# The openclaw guest's node (nodejs.org v24.22.2) links its own OpenSSL statically. That copy is not
# libssl3t64 and is outside these records; #5853 checks it against the same advisories.
/usr/lib/agentos/images/openclaw/usr/local/bin/node *
# The codex guest's two static (musl) Rust binaries hold no OpenSSL selector name but spell GCM-SIV three
# times, as OpenSSL's default provider does (AES-128/192/256-GCM-SIV), and KRB5KDF six times, as
# libcrypto's provider tables do: they may carry a stripped static copy of OpenSSL or another crypto
# library. Either way not libssl3t64; #5853 identifies it. guest/codex/build-rootfs.sh pins the codex
# version, and image.yml runs on a change to it, so a version bump meets these digests in its own PR.
/usr/lib/agentos/images/codex/opt/codex/vendor/x86_64-unknown-linux-musl/bin/codex sha256=628e35487d888a28f0427fc37501da529dd3d81fcbad7a2c3421c1e8670d92e1 GCM-SIV=3 KRB5KDF=6
/usr/lib/agentos/images/codex/opt/codex/vendor/x86_64-unknown-linux-musl/bin/codex-code-mode-host sha256=ec71830690a7c0024916ee0c99fbdc635bc6e747ff665ea4f03a8389bbcb6b30 GCM-SIV=3 KRB5KDF=6
