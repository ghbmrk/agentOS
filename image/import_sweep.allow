[wrapper]
# Libraries that import dlsym or dlvsym and pass it only names of their own, never a caller's string
# but through an export the sweep counts as a lookup function itself (LOOKUP_FUNCS; #6299): a file that
# needs one is no lookup through it, so a string it holds is not read as a name it can resolve. Each
# entry pins the bytes whose dlsym calls were read, as [glob] entries do; a file's own dlsym import always
# counts, and an entry that a lookup's sources do not include fails.

# libsystemd-shared (systemd 257): dlsym_many_or_warn (src/basic/dlfcn-util.c) resolves the
# DLSYM_ARG(name) list its callers spell (idn-util.c, bpf-dlopen.c, cryptsetup-util.c and the other
# *-util.c loaders), userdb.c looks up "_nss_systemd_block", and tpm2-util.c TSS2_TCTI_INFO_SYMBOL.
/usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-*.so sha256=9f6f06ff4883d23eee5e628c625878e8bc7f60613e945e04ead7793ae969f37c

# libpam (Linux-PAM 1.7.0): pam_handlers.c _load_module resolves the pam_sm_* names its switch spells
# through _pam_dlsym (pam_dynamic.c), which libpam does not export.
/usr/lib/x86_64-linux-gnu/libpam.so.0.* sha256=7e61037c89b06382c9d22518174914fef77b9e473962f49ab1c90c55c9b5bca2

# libselinux (3.8.1): load_policy.c resolves ten sepol_* names it spells from libsepol; nothing else
# calls dlsym, and it exports no wrapper.
/usr/lib/x86_64-linux-gnu/libselinux.so.1 sha256=5cb5293b4e7590463b94f7b23152d54807a6a2ccaf8cac9e343908c6692c086c

# libmount (util-linux 2.41.5): hook_veritydev.c resolves the crypt_* names of its static
# verity_symbols table from libcryptsetup; it exports no wrapper.
/usr/lib/x86_64-linux-gnu/libmount.so.1.* sha256=1654d2cf948e3608cc0d38340807d4ddac1114315a3a77f7b274c4c859cb2181

# libcrypto (OpenSSL 3.5.7): dlfcn_bind_func and dlfcn_globallookup (crypto/dso/dso_dlfcn.c) are its
# only dlsym calls. A caller's name reaches them only through the exports DSO_bind_func,
# DSO_global_lookup and DSO_METHOD_openssl, which the sweep counts as lookup functions of their own
