# The files of the built image (main tree and initrds) that may import or reach glibc's regex engine
# (DEBIAN-CVE-2026-100290, #5697): one glob per line, each a file the image -100290 record in
# assurance/vulncheck.json names. image/import_sweep.py --summary fails on a file that matches none,
# and on a glob that matches no file. Only command-line tools, the guests' shells and libraries whose
# regex use the record explains belong here; a long-lived or network-facing process never does.

# Shell and text tools, run locally.
/usr/bin/bash
/usr/bin/csplit
/usr/bin/du
/usr/bin/expr
/usr/bin/find
/usr/bin/grep
/usr/bin/hardlink
/usr/bin/kmod
/usr/bin/less
/usr/bin/localedef
/usr/bin/more
/usr/bin/nl
/usr/bin/ptx
/usr/bin/run-parts
/usr/bin/sed
/usr/bin/tac

# Tools that import only glibc's rpmatch, which runs the locale's YESEXPR on a yes/no answer to an
# interactive prompt (cp -i, rm -i and the like).
/usr/bin/cp
/usr/bin/install
/usr/bin/ln
/usr/bin/mv
/usr/bin/rename.ul
/usr/bin/rm

# The guests' bash, an agent-driven shell inside the guest sandbox, and their rm (rpmatch), both
# linking the guest's own glibc (the image/guest -100290 record).
/usr/lib/agentos/images/*/bin/bash
/usr/lib/agentos/images/*/bin/rm

# libsmartcols (filters, and rpmatch) and the util-linux tools that need it; fdisk, sfdisk and cfdisk
# also import rpmatch for their prompts.
/usr/lib/x86_64-linux-gnu/libsmartcols.so.1.*
/usr/bin/findmnt
/usr/bin/lsblk
/usr/bin/lscpu
/usr/bin/lsipc
/usr/bin/lslocks
/usr/bin/lsmem
/usr/bin/lsns
/usr/bin/partx
/usr/bin/prlimit
/usr/bin/wdctl
/usr/sbin/cfdisk
/usr/sbin/fdisk
/usr/sbin/losetup
/usr/sbin/sfdisk
/usr/sbin/swapon
/usr/sbin/wipefs
/usr/sbin/zramctl

# libcryptsetup (its one regcomp parses FileVault2 metadata) and what needs it.
/usr/lib/x86_64-linux-gnu/libcryptsetup.so.12.*
/usr/lib/x86_64-linux-gnu/cryptsetup/libcryptsetup-token-systemd-*.so
/usr/bin/systemd-cryptenroll
/usr/bin/systemd-cryptsetup
/usr/lib/systemd/systemd-integritysetup
/usr/lib/systemd/systemd-veritysetup
/usr/sbin/cryptsetup
/usr/sbin/integritysetup
/usr/sbin/veritysetup

# libedit (line editing) and nft, which needs it for its interactive mode; nft itself is a one-shot
# ruleset load.
/usr/lib/x86_64-linux-gnu/libedit.so.2.*
/usr/sbin/nft

# libformw (ncurses forms); nothing in the image needs it.
/usr/lib/x86_64-linux-gnu/libformw.so.6.*

[glob]
# The files of the built image (main tree and initrds) that may import or reach glibc's glob(), glob64 or
# wordexp, which calls glob() (DEBIAN-CVE-2026-126765, #6285): one glob per line, each a file the
# -126765 records in assurance/vulncheck.json name. As for the regex list above, a file that matches
# none fails the step, and so does an entry that matches no file.

# libsystemd-shared's one glob() call is basic/glob-util.c safe_glob (systemd 257.13), behind glob_first,
# glob_extend and glob_exists. Its callers and their patterns: PID 1 and systemd-executor (libsystemd-core)
# for unit settings (EnvironmentFile=, ImportCredential=, PathExistsGlob=, ConditionPathExistsGlob=);
# networkd and udevd for the conditions of .network, .netdev and .link files; systemd-analyze for a
# condition on its command line; systemd-sysctl and systemd-tmpfiles for sysctl.d and tmpfiles.d
# entries; journalctl for --file. Each pattern is root-owned configuration (no agentOS process
# starts a transient unit) or the command line of a root tool; none comes from the network or a guest.
/usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-*.so

# The files that reach glob() only through libsystemd-shared; none of them but those named above calls
# into safe_glob's wrappers, so linking it is all they share (journald, logind, resolved and the rest).
/usr/bin/bootctl
/usr/bin/busctl
/usr/bin/hostnamectl
/usr/bin/journalctl
/usr/bin/kernel-install
/usr/bin/localectl
