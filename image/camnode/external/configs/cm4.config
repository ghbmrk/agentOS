# The Raspberry Pi CM4 board (the prototype, part d): the Raspberry Pi kernel and firmware,
# libcamera's rpi/vc4 pipeline and rpicam-vid on the hardware H.264 encoder.
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CAMNODE_PATH)/board/common/linux.fragment $(BR2_EXTERNAL_CAMNODE_PATH)/board/cm4/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-cm4"
BR2_GLOBAL_PATCH_DIR="$(TOPDIR)/board/raspberrypi/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CAMNODE_PATH)/board/common/overlay $(BR2_EXTERNAL_CAMNODE_PATH)/board/cm4/overlay"
BR2_ROOTFS_POST_SCRIPT_ARGS="cm4"
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_CAMNODE_PATH)/board/cm4/config.txt"
BR2_PACKAGE_LIBCAMERA=y
BR2_PACKAGE_LIBCAMERA_PIPELINE_RPI_VC4=y
BR2_PACKAGE_LIBCAMERA_APPS=y
