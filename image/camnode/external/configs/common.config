# Shared by both boards: the camera node's userland (CAM-node part c; briefs/CAM-node.md, design
# point 5). build.sh appends a board file (cm4.config or qemu.config) and runs olddefconfig.
BR2_aarch64=y
BR2_cortex_a72=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_REPRODUCIBLE=y
BR2_CCACHE=y

# Toolchain built from source (no prebuilt binaries), glibc for systemd, C++ for libcamera.
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_12=y

# systemd as init, no shell, no busybox, no getty, no root login, a read-only root.
BR2_INIT_SYSTEMD=y
BR2_INIT_SYSTEMD_VAR_FACTORY=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_TARGET_GENERIC_HOSTNAME="camnode"
BR2_TARGET_GENERIC_ISSUE=""
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_CAMNODE_PATH)/board/common/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CAMNODE_PATH)/board/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CAMNODE_PATH)/board/common/post-image.sh"

# The systemd parts the node uses: udev, networkd (the DHCP client), journald (volatile).
BR2_PACKAGE_SYSTEMD_NETWORKD=y
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_TIMESYNCD is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_LOCALED is not set
# BR2_PACKAGE_SYSTEMD_TIMEDATED is not set
# BR2_PACKAGE_SYSTEMD_LOGIND is not set
# BR2_PACKAGE_SYSTEMD_MYHOSTNAME is not set
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_FIRSTBOOT is not set
# BR2_PACKAGE_SYSTEMD_BINFMT is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
# BR2_PACKAGE_SYSTEMD_QUOTACHECK is not set
# BR2_PACKAGE_SYSTEMD_RANDOMSEED is not set
# BR2_PACKAGE_SYSTEMD_UTMP is not set
# BR2_PACKAGE_SYSTEMD_BACKLIGHT is not set
# BR2_PACKAGE_SYSTEMD_RFKILL is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
# BR2_PACKAGE_SYSTEMD_COREDUMP is not set
# BR2_PACKAGE_SYSTEMD_SYSUSERS is not set
# BR2_PACKAGE_SYSTEMD_IMPORTD is not set
# BR2_PACKAGE_SYSTEMD_HOMED is not set
# BR2_PACKAGE_SYSTEMD_MACHINED is not set
# BR2_PACKAGE_SYSTEMD_NSPAWN is not set
# BR2_PACKAGE_SYSTEMD_OOMD is not set
# BR2_PACKAGE_SYSTEMD_PORTABLED is not set
# BR2_PACKAGE_SYSTEMD_REPART is not set
# BR2_PACKAGE_SYSTEMD_SYSEXT is not set
# BR2_PACKAGE_SYSTEMD_SYSUPDATE is not set
# BR2_PACKAGE_SYSTEMD_USERDB is not set
# BR2_PACKAGE_SYSTEMD_ANALYZE is not set
# BR2_PACKAGE_SYSTEMD_KERNELINSTALL is not set
BR2_PACKAGE_NFTABLES=y

# The root: erofs (read-only by construction) under dm-verity, built by post-image.sh.
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_CAMNODE_INIT=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Host tools post-image.sh uses: veritysetup, FAT images, the disk, the data partition.
BR2_PACKAGE_HOST_CRYPTSETUP=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_E2FSPROGS=y
