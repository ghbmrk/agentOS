# The QEMU aarch64 board, for the end-to-end test only (image/camnode/e2e/): mainline kernel on
# QEMU's virt machine, with a CUSE stand-in for the secure element, a uinput stand-in for the
# button and a generated-video stand-in for the encoder (board/qemu/). It never ships.
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.33"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(TOPDIR)/board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CAMNODE_PATH)/board/common/linux.fragment $(BR2_EXTERNAL_CAMNODE_PATH)/board/qemu/linux.fragment"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_CAMNODE_PATH)/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CAMNODE_PATH)/board/common/overlay $(BR2_EXTERNAL_CAMNODE_PATH)/board/qemu/overlay"
BR2_ROOTFS_POST_SCRIPT_ARGS="qemu"
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
