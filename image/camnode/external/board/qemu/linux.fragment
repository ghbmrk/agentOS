# The QEMU board's stand-ins (board/qemu/): CUSE for the secure element, uinput for the button,
# fw_cfg for the button's state, virtio for the disk, the network and the journal's console.
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_CONSOLE=y
# The harness's firmware page (e2e/driver/vm.go, mailbox): the reboot notifier writes the restart
# command's word there, as the Pi's firmware driver hands tryboot to the firmware.
CONFIG_POWER_RESET=y
CONFIG_MFD_SYSCON=y
CONFIG_SYSCON_REBOOT_MODE=y
