#!/bin/sh
# Let the access point's interface through the inbound drop while the access point runs, and take
# it out again when it stops (DEV-net-f, DEV-net-g; DEV-2, CH-7, CH-9).
# agentos-inbound.service drops every connection to a box port on every interface not in the
# agentos_inbound table's exempt set, and that drop is final, so the owner's phone on the box's
# Wi-Fi reaches the local page only once its interface is in the set. CH-9's agentos_ap table then
# holds that interface to the page, DHCP and DNS, so the set may name an interface only while
# agentos_ap is loaded for it. The set also exempts the interface from agentos_inbound's forward
# drop (#2824), so agentos_ap's forward chain must drop the interface's forwarding both ways too
# (all but passthrough, which it accepts before those drops).
#   ap-exempt <iface>           run by agentos-ap-exempt@<iface>.service at each access-point
#                               bring-up, which fails if this does. It adds <iface> only if it is
#                               wireless, agentos_ap's input chain ends in a drop for it and its
#                               forward chain drops it in and out: the
#                               loader loads agentos_ap first, for the interface it created as the
#                               access point, so a second radio, the uplink, a USB tether or a
#                               second NIC stays dropped.
#   ap-exempt --remove <iface>  run when that unit stops (the access point stopped, or its
#                               interface went). It removes <iface> and checks it is gone; on a
#                               single radio the same interface may next join the home Wi-Fi, where
#                               the drop must hold. The interface need not exist any more.
# On any failure it says so and exits non-zero. It never loads, flushes or deletes rules or other
# set elements: removing an element closes that interface, it never opens the drop.
# AGENTOS_SYSFS exists for tests/test_image.py and tests/test_inbound_netns.py.
S=${AGENTOS_SYSFS:-/sys}
SET="inet agentos_inbound exempt"
remove=
[ "$1" = --remove ] && { remove=1; shift; }
if [ -n "$remove" ]; then
	fail() { echo "agentos-ap-exempt: FAIL $*; the interface may still be exempt"; exit 1; }
else
	fail() { echo "agentos-ap-exempt: FAIL $*; the access point stays closed"; exit 1; }
fi

[ $# -eq 1 ] || fail "usage: ap-exempt [--remove] <interface>"
i=$1
case $i in
'' | -* | lo | *[!a-zA-Z0-9_.-]*) fail "\"$i\" is not an access point interface" ;;
esac
[ ${#i} -le 15 ] || fail "\"$i\" is not an interface name"

if [ -n "$remove" ]; then
	nft list set $SET >/dev/null || fail "the inbound rules are not loaded"
	# Adding first makes the delete succeed whether or not $i is still there, in one transaction.
	printf 'add element %s { "%s" }\ndelete element %s { "%s" }\n' "$SET" "$i" "$SET" "$i" | nft -f - ||
		fail "could not remove $i from the inbound exempt set"
	l=$(nft list set $SET) || fail "could not read the inbound exempt set"
	case $l in *"\"$i\""*) fail "$i is still in the inbound exempt set" ;; esac
	echo "agentos-ap-exempt: OK removed $i"
	exit 0
fi

[ -d "$S/class/net/$i/phy80211" ] || fail "$i is not a wireless interface"
nft list set $SET >/dev/null || fail "the inbound rules are not loaded"
nft list chain inet agentos_ap input | sed 's/^[[:space:]]*//' | grep -qxF "iifname \"$i\" drop" ||
	fail "agentos_ap is not loaded for $i"
fwd=$(nft list chain inet agentos_ap forward) || fail "agentos_ap is not loaded for $i"
for k in iifname oifname; do
	printf '%s\n' "$fwd" | sed 's/^[[:space:]]*//' | grep -qxF "$k \"$i\" drop" ||
		fail "agentos_ap does not drop forwarding for $i"
done
nft add element $SET "{ \"$i\" }" || fail "could not add $i to the inbound exempt set"
nft get element $SET "{ \"$i\" }" >/dev/null || fail "$i is not in the inbound exempt set"
echo "agentos-ap-exempt: OK $i"
