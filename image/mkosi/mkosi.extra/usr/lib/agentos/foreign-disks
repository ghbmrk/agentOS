#!/bin/sh
# Prints "foreign=none", or "foreign=" and the block devices, comma-separated, that are mounted or
# swapped on and do not sit on the disk the box booted from: a host PC's disk, a loop device, a
# USB stick (HW-8, ONB-2: no file system of a host disk is opened, read-only or not). The mounts are
# read from every process's mountinfo, so a mount in a private namespace counts, and a mount is a
# block device by its major:minor number (major 0 is a virtual file system), not by the source
# string, which a mount(2) call can write as any path. Prints "foreign=unknown" when the boot disk,
# the mount listing or a device cannot be read, so a damaged answer is no "none". boot-report prints
# this on every boot and CI reads it with a host disk attached (ci_boot.sh); the end-to-end run
# prints it again when it is done.
proc=${AGENTOS_PROC:-/proc}
# unknown WHY: the answer when something cannot be read; WHY says what, for the console reader.
unknown() { echo "foreign=unknown ($1)"; exit 0; }
# chain DEV: lsblk's lines "NAME TYPE" for DEV and what it sits on; roots is the disks among them.
chain() { lsblk -snrpo NAME,TYPE "$1" 2>/dev/null; }
roots() { chain "$1" | while read -r name type; do
	case $type in disk | loop | rom) echo "$name" ;; esac
done | sort -u; }
# findmnt right-aligns the number in a padded column; -r and tr leave the bare MAJ:MIN.
rootmm=$(findmnt -rno MAJ:MIN / 2>/dev/null | tr -d ' ')
boot=$(roots "/dev/block/$rootmm")
[ -n "$boot" ] && [ "$(echo "$boot" | wc -l)" = 1 ] || unknown "boot disk of $rootmm"
# The device number is the third field of a mountinfo line. A process can exit while its file is read,
# so errors are ignored; the listing must still name the root's number, or it is not the listing.
mms=$(cat "$proc"/[0-9]*/mountinfo 2>/dev/null | awk '$3 !~ /^0:/ { print $3 }' | sort -u)
echo "$mms" | grep -qxF "$rootmm" || unknown "no mount listing for $rootmm"
[ -r "$proc/swaps" ] || unknown "no swap list"
bad=
for m in $mms; do
	r=$(roots "/dev/block/$m")
	[ -n "$r" ] || unknown "device $m"
	[ "$r" = "$boot" ] || bad="$bad,$(chain "/dev/block/$m" | head -n 1 | cut -d' ' -f1)"
done
# Swap is named by path, and so is a mount whose file system keeps its own anonymous device number
# (major 0, as btrfs does) and names the real device only as its source.
for s in $( { tail -n +2 "$proc/swaps" | cut -d' ' -f1
	cat "$proc"/[0-9]*/mountinfo 2>/dev/null |
		awk '$3 ~ /^0:/ { for (i = 4; i < NF; i++) if ($i == "-") { print $(i + 2); break } }'; } | sort -u); do
	case $s in /dev/*) ;; *) continue ;; esac
	d=$(readlink -f "$s")
	[ -b "$d" ] || { bad="$bad,$s"; continue; }
	r=$(roots "$d")
	[ -n "$r" ] || unknown "device $s"
	[ "$r" = "$boot" ] || bad="$bad,$s"
done
echo "foreign=${bad#,}" | sed 's/^foreign=$/foreign=none/'
