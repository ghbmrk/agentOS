#!/bin/sh
# The weekly reboot (UPD-10), from agentos-reboot.timer. A shutdown block inhibitor means the box
# is busy (UPD-6: a call or accepted work holds one), so the reboot waits for it to go, retrying
# every five minutes; but never past a week of uptime, so an implant cannot hold the box up by
# taking an inhibitor of its own. The timer fires weekly, so the box is never up longer than that.
# Once a month the reboot is a restore drill (#2932): first every block of the booted /usr is read
# through dm-verity against the signed boot entry's usrhash=, then the reboot is the clean start, and
# drill-report times it to the healthy boot (agentos-drill-report.service). A failed check still
# reboots: the week's bound holds whatever the drill found. The check gets only the time left in the
# week, so a stalled verifier cannot hold the reboot up; one cut off, or not started because the week
# is already up, records image=incomplete, which drill-report reads as a failed drill.
# AGENTOS_HEALTH_ROOT exists for tests/test_image_noexec.py and tests/test_image_drill.py.
set -u
R=${AGENTOS_HEALTH_ROOT:-}
WEEK=604800
STEP=300
D=$R/var/lib/agentos/drill
up() { cut -d. -f1 "$R/proc/uptime"; }
# Due when no drill finished in the last 27 days, so one Sunday in four or five. drill-report touches
# last.json on every drill, passed or failed.
due() { [ -z "$(find "$D/last.json" -mtime -27 2>/dev/null)" ]; }
image=
if due; then
	start=$(date +%s)
	# unrecorded stands until a drill's record is written, so the next healthy boot reports a drill whose
	# record never was (a full or failing disk, a power cut during the check) as missed (#5455). A record
	# still standing from an earlier drill is superseded, so it cannot stand in for this one.
	mkdir -p -m 0700 "$D"
	rm -f "$D/pending" "$D/pending.new"
	# true, not ":": a redirection error on a special builtin exits the shell, which would skip the reboot.
	true 2>/dev/null >"$D/unrecorded" ||
		echo "agentos-reboot: FAIL drill start record not written: likely /var is full or failing. If the drill's record is lost too, no boot reports this drill"
	want=$(tr ' ' '\n' <"$R/proc/cmdline" | sed -n 's/^usrhash=//p' | tail -n 1)
	st=$(veritysetup status usr 2>/dev/null)
	data=$(printf '%s\n' "$st" | sed -n 's/^ *data device: *//p')
	hash=$(printf '%s\n' "$st" | sed -n 's/^ *hash device: *//p')
	image=failed
	left=$((WEEK - $(up)))
	# verify reads both partitions, not the mapping, and checks the whole tree against the signed hash.
	# timeout 0 would mean no bound at all, so a week already up skips the check.
	if [ -n "$want" ] && [ -n "$data" ] && [ -n "$hash" ]; then
		if [ "$left" -le 0 ]; then
			image=incomplete
		else
			timeout -k 10 "$left" ionice -c 3 nice -n 19 veritysetup verify "$data" "$hash" "$want" >/dev/null 2>&1
			case $? in 0) image=verified ;; 124 | 137) image=incomplete ;; esac
		fi
	fi
	secs=$(($(date +%s) - start))
	echo "agentos-reboot: drill image=$image in ${secs}s; the reboot is the clean start"
fi
# The drill's record, rewritten just before each reboot is asked for, so a wait on an inhibitor is not
# counted in the time to a clean core. A record that cannot be written is said so, and the reboot goes
# ahead: the week's bound outranks the report, and the next weekly reboot drills again (#5455). It is
# said once, not on every 5-minute retry, and once more just before the reboot (#5466). A record
# written on an earlier try and not on this one is removed: its reboot_at would count the wait since,
# so the next healthy boot reports the drill missed instead. That is promised only when unrecorded was
# written: with it lost too, no boot reports this drill (#5513).
failed= said= now= missed=
fail() { echo "agentos-reboot: FAIL drill record not written (image=$image): likely /var is full or failing. The reboot goes ahead${missed:+; the next boot reports the drill missed}"; }
stamp() {
	now=
	[ -n "$image" ] || return 0
	if { printf 'image=%s image_seconds=%s reboot_at=%s\n' "$image" "$secs" "$(date +%s)" >"$D/pending.new"; } 2>/dev/null &&
		mv -fT "$D/pending.new" "$D/pending" 2>/dev/null; then
		rm -f "$D/unrecorded"
		failed=
		return 0
	fi
	rm -f "$D/pending" "$D/pending.new" 2>/dev/null
	missed=
	true 2>/dev/null >"$D/unrecorded" && missed=1
	failed=1
	[ -n "$said" ] || { said=1 now=1; fail; }
}
# Just before the reboot: a failure said on an earlier try is said again.
last() { [ -z "$failed" ] || [ -n "$now" ] || fail; }
while [ "$(up)" -lt "$WEEK" ]; do
	stamp
	if systemctl reboot --check-inhibitors=yes; then
		last
		echo "agentos-reboot: rebooting"
		exit 0
	fi
	echo "agentos-reboot: inhibited; trying again in ${STEP}s"
	sleep "$STEP"
done
echo "agentos-reboot: up a week; rebooting through any inhibitor"
stamp
last
exec systemctl reboot --check-inhibitors=no
