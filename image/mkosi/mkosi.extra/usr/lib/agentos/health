#!/bin/sh
# AgentOS boot health check (UPD-1). boot-complete.target requires it, so systemd-bless-boot
# blesses this boot's entry only when it passes; a release that fails it on every try is
# abandoned by systemd-boot's boot counting and the previous one boots instead.
# Secure Boot off is reported, not failed: HW-5 allows PCs whose firmware has it off.
# This is a reliability gate (it keeps a release that cannot run from being blessed), not a
# security control: integrity of the boot path rests on Secure Boot, verity and the TPM seal.
# AGENTOS_LIB and AGENTOS_HEALTH_ROOT exist for tests/test_image.py.
L=${AGENTOS_LIB:-/usr/lib/agentos}
R=${AGENTOS_HEALTH_ROOT:-}
fail() { echo "agentos-health: FAIL $*"; exit 1; }

sb=unknown
v=$R/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
if [ -r "$v" ]; then
	case $(od -An -tu1 -j4 -N1 "$v" | tr -d ' ') in
	1) sb=on ;;
	0) sb=off ;;
	esac
fi

st=$(veritysetup status usr 2>/dev/null)
printf '%s\n' "$st" | grep -Eq '^ *status: *verified' || fail "/usr is not under dm-verity"
[ "$(findmnt -no SOURCE /usr)" = /dev/mapper/usr ] || fail "/usr is not mounted from the verity device"
# The verity device must be the release this boot entry names (UPD-1a).
want=$(tr ' ' '\n' <"$R/proc/cmdline" | sed -n 's/^usrhash=//p')
got=$(printf '%s\n' "$st" | sed -n 's/^ *root hash: *//p')
[ -n "$want" ] && [ "$got" = "$want" ] || fail "/usr root hash ${got:-unreported} does not match usrhash=${want:-none}"
case ,$(findmnt -no OPTIONS /usr), in
*,ro,*) ;;
*) fail "/usr is mounted writable" ;;
esac
# Root and the ESP are on the drive this PC booted, and no other disk carries its GUIDs.
"$L/drive-id" check || fail "boot drive is ambiguous"
# The host-disk rules found the drive (HW-8, HOST-1a; hostdisk ASSUMPTIONS H7, H11): with no drive
# they cannot tell the box's own disk from a host PC's, so such a boot is never blessed.
hd=$("$L/agentos-hostdisk" health 2>/dev/null) && [ "$hd" = hostdisk=ok ] ||
	fail "the AgentOS drive is not found among the disks (${hd:-no answer})"
[ -x "$L/agentosd" ] || fail "broker missing"
"$L/agentosd" -h >/dev/null 2>&1 || fail "broker does not start"
"$L/runsc" --version >/dev/null 2>&1 || fail "gVisor runsc does not start"
# runsc refuses every sandbox without its sentry beside it (#1701), so such a release is never blessed.
[ -x "$L/gvisor-bin/gvisor_sentry" ] || fail "gVisor sentry missing"
[ -d "$L/images/openclaw/opt/openclaw" ] && [ -r "$L/guest/launch.json" ] || fail "OpenClaw guest image or launch.json missing"
# The inbound drop (DEV-2 In, DEV-net-e 2a) is loaded and its input chain ends in drop: a release
# whose rules cannot load is never blessed, so the previous one boots instead.
last=$(nft list chain inet agentos_inbound input 2>/dev/null | grep -v '^[[:space:]]*}*[[:space:]]*$' | tail -n 1)
[ "$(echo $last)" = drop ] || fail "inbound firewall not loaded"
# Nothing can write the broker's memory to disk (IMG-nodump): the Owner Card passphrase in it
# cannot be zeroed (card C13). The build checks the same; this proves it on the running box.
[ -r "$R/proc/swaps" ] || fail "swap state unreadable"
[ "$(sed 1d "$R/proc/swaps" | grep -c .)" = 0 ] || fail "swap is active"
[ "$(cat "$R/proc/sys/kernel/core_pattern" 2>/dev/null)" = "|/usr/bin/false" ] || fail "core dumps are not discarded"
# The box routes nothing (#1478): the inbound drop has no forward hook, so forwarding must be off.
# IPv4 forwards by input device, so every device's switch counts, and "default" (what a new device
# starts with). Kernels from 6.17 also force IPv6 forwarding per device. A device can vanish
# between the glob and the read (a radio moved to another namespace, a USB NIC unplugged; #2803):
# a switch that is gone forwards nothing, so it is skipped only when it no longer exists; a switch
# still present that does not read 0 fails. A rename also looks like a vanish, and the new name was
# never globbed, so any skip re-runs the loop once with a fresh glob, and a second skip fails.
devices() {
	gone=
	# Quoted, so the patterns glob only under /proc, never against the working directory.
	for p in 'ipv4/conf/*/forwarding' 'ipv6/conf/*/forwarding' 'ipv6/conf/*/force_forwarding'; do
		for f in "$R"/proc/sys/net/$p; do
			[ "$(cat "$f" 2>/dev/null)" = 0 ] && continue
			[ -e "$f" ] && fail "forwarding is on (${f#"$R"})"
			# A glob that matches nothing comes back as itself (force_forwarding before 6.17): no
			# device, unless "all" has the switch, when the glob should have matched at least that.
			[ "$f" = "$R/proc/sys/net/$p" ] && [ ! -e "$R/proc/sys/net/${p%/\**}/all/${p##*/}" ] && continue
			gone=${f#"$R"}
		done
	done
}
devices
if [ -n "$gone" ]; then
	devices
	[ -z "$gone" ] || fail "forwarding switches keep vanishing ($gone)"
fi
# The global switch, "all" and "default" never vanish: missing or unreadable fails.
for f in "$R/proc/sys/net/ipv4/ip_forward" "$R/proc/sys/net/ipv4/conf/all/forwarding" \
	"$R/proc/sys/net/ipv4/conf/default/forwarding" "$R/proc/sys/net/ipv6/conf/all/forwarding" \
	"$R/proc/sys/net/ipv6/conf/default/forwarding"; do
	[ -e "$f" ] || fail "forwarding state unreadable (${f#"$R"})"
	[ "$(cat "$f" 2>/dev/null)" = 0 ] || fail "forwarding is on (${f#"$R"})"
done
echo "agentos-health: PASS secure_boot=$sb usr=verity inbound=drop swap=off dumps=off forward=off $hd"
