#!/bin/sh
# One console line carrying the wired uplink and the bless state (after the boot is blessed, or
# not): what CI's boot test reads. A physical Ethernet port with a cable in gets up to 30 s for
# its lease (20-agentos-uplink.network, #1416). With no carrier on any port the report waits
# about 5 s, since a cold NIC can still be negotiating; a carrier that cannot be read (link
# down) counts as not yet.
net=${AGENTOS_SYS_NET:-/sys/class/net}
up=none
for i in $(seq 30); do
	wired=
	for d in "$net"/*; do
		[ -e "$d/device" ] && [ ! -e "$d/wireless" ] && [ "$(cat "$d/type" 2>/dev/null)" = 1 ] &&
			[ "$(cat "$d/carrier" 2>/dev/null)" = 1 ] || continue
		wired=1
		# "2: enp1s0    inet 192.0.2.10/24 brd ...": the fourth word is the address.
		# shellcheck disable=SC2046 # split into words on purpose
		set -- $(ip -4 -o addr show dev "${d##*/}" scope global | head -n 1)
		[ -n "${4:-}" ] && up="${d##*/} $4" && break 2
	done
	[ -n "$wired" ] || [ "$i" -le 5 ] || break
	sleep 1
done
st=$(/usr/lib/systemd/systemd-bless-boot status 2>&1)
root=$(findmnt -bno SIZE /)
# One line, one write: a reset or hangup of the console (getty starting) discards output still
# queued, and two lines can lose one fact and keep the other (#1764, image/ASSUMPTIONS.md I24).
echo "agentos-uplink: $up agentos-boot: bless=$st root_bytes=$root"
# The Wi-Fi page Requires= its claim hand-over (agentos-localui.service), so a failed hand-over
# keeps the page down while the setup access point still comes up (#1743). Say so here, the line
# the console and journal carry for support; agentos-health stays out of it, since a failed health
# check rolls the release back and a box-local fault such as a full disk is not the release's.
# A state systemctl cannot report reads claim=unknown, never ok.
case $(systemctl is-failed agentos-localui-claim.service 2>/dev/null) in
failed) echo "agentos-page: down claim=failed (power-cycle; if it persists, contact support)" ;;
active | inactive) echo "agentos-page: claim=ok" ;;
*) echo "agentos-page: claim=unknown" ;;
esac
# Each agent machine writes under its own hard quota on root (RES-4), which needs root mounted with
# project quotas (rootflags=prjquota, image/ASSUMPTIONS.md I15); agentosd keeps machines off
# otherwise. Say which, from the mount itself; CI's boot test needs the on line on every boot.
fs=$(findmnt -no FSTYPE / 2>/dev/null) || fs=unknown
case ",$(findmnt -no OPTIONS / 2>/dev/null)," in
*,prjquota,*) [ "$fs" = ext4 ] && q=on || q=off ;;
*) q=off ;;
esac
if [ "$q" = on ]; then
	echo "agentos-quota: root=ext4 prjquota"
else
	echo "agentos-quota: off root=${fs:-unknown} (agent machines stay off)"
fi
