#!/bin/sh
# One console line carrying the wired uplink and the bless state (after the boot is blessed, or
# not): what CI's boot test reads. A physical Ethernet port with a cable in gets up to 30 s for
# its lease (20-agentos-uplink.network, #1416). With no carrier on any port the report waits
# about 5 s, since a cold NIC can still be negotiating; a carrier that cannot be read (link
# down) counts as not yet.
net=${AGENTOS_SYS_NET:-/sys/class/net}
up=none
for i in $(seq 30); do
	wired=
	for d in "$net"/*; do
		[ -e "$d/device" ] && [ ! -e "$d/wireless" ] && [ "$(cat "$d/type" 2>/dev/null)" = 1 ] &&
			[ "$(cat "$d/carrier" 2>/dev/null)" = 1 ] || continue
		wired=1
		# "2: enp1s0    inet 192.0.2.10/24 brd ...": the fourth word is the address.
		# shellcheck disable=SC2046 # split into words on purpose
		set -- $(ip -4 -o addr show dev "${d##*/}" scope global | head -n 1)
		[ -n "${4:-}" ] && up="${d##*/} $4" && break 2
	done
	[ -n "$wired" ] || [ "$i" -le 5 ] || break
	sleep 1
done
st=$(/usr/lib/systemd/systemd-bless-boot status 2>&1)
root=$(findmnt -bno SIZE /)
# One line, one write: a reset or hangup of the console (getty starting) discards output still
# queued, and two lines can lose one fact and keep the other (#1764, image/ASSUMPTIONS.md I24).
echo "agentos-uplink: $up agentos-boot: bless=$st root_bytes=$root"
# The Wi-Fi page Requires= its claim hand-over (agentos-localui.service), so a failed hand-over
# keeps the page down while the setup access point still comes up (#1743). Say so here, the line
# the console and journal carry for support; agentos-health stays out of it, since a failed health
# check rolls the release back and a box-local fault such as a full disk is not the release's.
# A state systemctl cannot report reads claim=unknown, never ok.
case $(systemctl is-failed agentos-localui-claim.service 2>/dev/null) in
failed) echo "agentos-page: down claim=failed (power-cycle; if it persists, contact support)" ;;
active | inactive) echo "agentos-page: claim=ok" ;;
*) echo "agentos-page: claim=unknown" ;;
esac
# Each agent machine writes under its own hard quota on root (RES-4), which needs root mounted with
# project quotas (rootflags=prjquota, image/ASSUMPTIONS.md I15); agentosd keeps machines off
# otherwise. Say which, from the mount itself; CI's boot test needs the on line on every boot.
# flag=on: the command systemd loaded for agentosd, after every unit path and drop-in, is exactly the
# shipped one (systemctl shows variables unexpanded), with ignore_errors=no and no further field that
# a quoted word or a second command would add. Parsers that allowed variations were bypassed three
# review rounds running, so nothing varies (Security #2110 re-sign 3). Anything else reads overridden.
x=$(systemctl show -P ExecStart agentosd.service 2>/dev/null) || x=
c='/usr/lib/agentos/with-uids /usr/lib/agentos/agentosd -owner ${AGENTOS_OWNER} -modem-uid @uid:agentos-modem -localui-uid @uid:agentos-localui -netjoin-sock /run/agentos-netjoin/netjoin.sock -kernel-owner /run/agentos-kernel/owner.sock -kernel-uid @uid:agentos-kernel -kernel-owner-uid @uid:agentos-owner -runsc /usr/lib/agentos/runsc -image openclaw=/usr/lib/agentos/images/openclaw -image codex=/usr/lib/agentos/images/codex -worker-image openclaw -disk-quota on'
t=${x#"{ path=/usr/lib/agentos/with-uids ; argv[]=$c ; ignore_errors="}
case $x in
"$t") case $x in *"argv[]="*) f=overridden ;; *) f=unknown ;; esac ;;
*) case $t in
	*ignore_errors=* | *"argv[]="* | *path=*) f=overridden ;;
	"no ; start_time="*) f=on ;;
	*) f=overridden ;;
	esac ;;
esac
fs=$(findmnt -no FSTYPE / 2>/dev/null) || fs=unknown
case ",$(findmnt -no OPTIONS / 2>/dev/null)," in
*,prjquota,*) [ "$fs" = ext4 ] && q=on || q=off ;;
*) q=off ;;
esac
if [ "$q" = on ]; then
	echo "agentos-quota: root=ext4 prjquota flag=$f"
else
	echo "agentos-quota: off root=${fs:-unknown} flag=$f (agent machines stay off)"
fi
# HW-8, ONB-2: no mount or swap on a disk other than the one the box booted from, so a host PC's disk
# that sits beside the drive is never opened, even read-only. CI's boot test attaches one on the first
# and the end-to-end boot and needs foreign=none (image/ASSUMPTIONS.md IMG-1-1).
echo "agentos-disks: $(/usr/lib/agentos/foreign-disks 2>/dev/null || echo foreign=unknown)"
# STO-2c: the keeper. enroll=ran when enrollment made the sealed store this boot, skipped when its
# conditions held it back (a store already, or no Owner Card factors from setup yet), failed
# otherwise; kernel= the kernel unit's state. Read from systemd: this unit cannot see the keeper's
# state (agentos-.service.d/50-main-side.conf). CI's boot test reads it with the unlock step's own
# console lines (image/ci_boot.sh).
case $(systemctl show -P ConditionResult agentos-keeper-enroll.service 2>/dev/null):$(systemctl show -P Result agentos-keeper-enroll.service 2>/dev/null):$(systemctl show -P ActiveState agentos-keeper-enroll.service 2>/dev/null) in
yes:success:inactive) e=ran ;;
no:success:inactive) e=skipped ;;
*:*:activating) e=running ;;
yes:*:* | no:*:*) e=failed ;;
*) e=unknown ;;
esac
echo "agentos-keeper: enroll=$e kernel=$(systemctl is-active agentos-keeper-kernel.service 2>/dev/null)"
