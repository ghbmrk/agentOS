[Unit]
Description=AgentOS boot report
# After the Wi-Fi page's claim hand-over, so the report reads its final state (#1743), and after
# enrollment and the kernel, so its keeper line reads enrollment's result and the kernel unit's
# state once its start job has settled, not a job still queued or running its ExecStartPre= (STO-2c,
# #4474). A kernel that then reads "activating" is waiting to restart after a failure.
After=systemd-bless-boot.service boot-complete.target agentos-drive-id.service agentos-localui-claim.service agentos-keeper-enroll.service agentos-keeper-kernel.service

[Service]
Type=oneshot
ExecStart=/usr/lib/agentos/boot-report
StandardOutput=journal+console
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr
# Block devices, read only (bless-boot status opens the ESP, foreign-disks reads each disk): only the
# keeper's units reach the TPM (#2889, STO-2c). Not char-misc, which holds /dev/tpm0 too.
DevicePolicy=closed
DeviceAllow=block-* r

[Install]
WantedBy=multi-user.target
