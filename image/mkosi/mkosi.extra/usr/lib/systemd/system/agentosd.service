# The broker. On a preloaded box (D-105) it starts in setup mode, with no owner, and the Wi-Fi page
# sets it up (P2-2w c2); onboarding's /etc/agentos/agentosd.env, when written, sets AGENTOS_OWNER
# (E.164); agentosd.path starts the broker then if it is not running.
[Unit]
Description=agentOS broker
# Never without the inbound drop (DEV-net-e 2a): if it failed to load, the broker does not start.
Requires=agentos-inbound.service
# The kernel's unit, if it starts (only on a box with a sealed store), is ordered first but never
# required, so the broker still starts on the setup boot; it keeps trying the owner socket (#2682).
After=local-fs.target network.target agentos-inbound.service agentos-egress.service agentos-keeper-kernel.service
# The vault process serves its model, verify and routing sockets (#1249).
Wants=agentos-egress.service

[Service]
Environment=AGENTOS_OWNER=
EnvironmentFile=-/etc/agentos/agentosd.env
# The service's group is delegated to the broker, which moves itself into broker/ and puts its
# components beside it (RES-2, #124); -cgroup-root defaults to the broker's own group.
Slice=agentos.slice
Delegate=yes
# No child gains privileges through a setuid or file-capability binary (agentosd L7-6): runsc
# keeps root's full set.
NoNewPrivileges=yes
# The Owner Card passphrase lives in this process's memory and cannot be zeroed (card C13): it
# never dumps core (IMG-nodump; the image also discards dumps and has no swap).
LimitCORE=0
# agentos-modem's roles directory, where agentosd records the SIM setup binds (-modem-roles): made
# before agentos-modem starts (After=agentosd.service), since that unit binds it in only if it exists
# (G1-e2e). No tmpfiles line: tmpfiles also runs at image build, which ships /var/lib/agentos empty.
StateDirectory=agentos/modem
StateDirectoryMode=0755
# Only on the drive this PC booted (drive-id: no other disk carries the boot partition's GUID).
ExecStartPre=/usr/lib/agentos/drive-id check
# with-uids swaps each @uid:NAME for that user's uid (agentos-setup.conf).
# The kernel's owner socket is called as agentos-owner, the one peer the kernel's unit admits there
# (-owner-uid), on a thread of the broker's own; the kernel's uid is the only peer it calls (#2682).
# -disk-quota on is the default, passed so the image never runs another value (RES-4, #1386): with
# no project quota on root agentosd keeps agent machines off. The off value is never passed (tests/test_image_quota.py).
# The local inference service's user, model and the model's hash (INFER-image, D-230); -infer itself
# stays off until a retrieve row consumes the service, so the model costs disk only (tests/test_image_infer.py).
ExecStart=/usr/lib/agentos/with-uids /usr/lib/agentos/agentosd -owner ${AGENTOS_OWNER} \
        -modem-uid @uid:agentos-modem -localui-uid @uid:agentos-localui \
        -infer-uid @uid:agentos-infer -infer-model /usr/lib/agentos/infer/Qwen3-Embedding-0.6B-Q8_0.gguf \
        -infer-model-sha256 06507c7b42688469c4e7298b0a1e16deff06caf291cf0a5b278c308249c3e439 \
        -kernel-owner /run/agentos-kernel/owner.sock -kernel-uid @uid:agentos-kernel \
        -kernel-owner-uid @uid:agentos-owner \
        -runsc /usr/lib/agentos/runsc -image openclaw=/usr/lib/agentos/images/openclaw \
        -image codex=/usr/lib/agentos/images/codex -worker-image openclaw \
        -disk-quota on
Restart=on-failure

[Install]
WantedBy=multi-user.target
