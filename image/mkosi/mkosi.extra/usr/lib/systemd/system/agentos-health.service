[Unit]
Description=AgentOS boot health check
Documentation=file:/usr/lib/agentos/health
Before=boot-complete.target
# A failure (or a hang past the timeout) reboots into the next try (UPD-1).
OnFailure=agentos-fallback.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=5min
ExecStart=/usr/lib/agentos/health
StandardOutput=journal+console
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr
# Block devices only, and the device mapper's control node for veritysetup: only the keeper's
# units reach the TPM (#2889, STO-2c). Not char-misc, which holds /dev/tpm0 too.
DevicePolicy=closed
DeviceAllow=block-* r
DeviceAllow=/dev/mapper/control rw

[Install]
RequiredBy=boot-complete.target
