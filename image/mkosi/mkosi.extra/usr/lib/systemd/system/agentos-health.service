[Unit]
Description=AgentOS boot health check
Documentation=file:/usr/lib/agentos/health
Before=boot-complete.target
After=agentos-machines.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/agentos/health
# veritysetup status asks device-mapper through its control node; nothing else.
DevicePolicy=closed
DeviceAllow=/dev/mapper/control rw
StandardOutput=journal+console

[Install]
RequiredBy=boot-complete.target
