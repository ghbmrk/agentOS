[Unit]
Description=agentOS weekly reboot
Documentation=file:/usr/lib/agentos/reboot-weekly

[Service]
Type=oneshot
ExecStart=/usr/lib/agentos/reboot-weekly
# It may wait out a call or accepted work for up to a week of uptime (reboot-weekly).
TimeoutStartSec=infinity
StandardOutput=journal+console
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr
# Block devices only, and the device mapper's control node for veritysetup: only the keeper's
# units reach the TPM (#2889, STO-2c). Not char-misc, which holds /dev/tpm0 too.
DevicePolicy=closed
DeviceAllow=block-* r
DeviceAllow=/dev/mapper/control rw
