# The kernel (STO-2b, STO-2c): agentos-unlock runs as root, opens the sealed store through this PC's
# tpm slot with the pins on its TPM, derives the kernel's keys, closes the store and execs
# agentos-kernel as the kernel's user, with the keys on descriptor 3 and one TPM connection on
# descriptor 4 for the log's counter (LOG-2, STO-1). No process lives on with the store key (CLK-1).
# The unlock step caps the tpm slot after its unseal (#2977), so no restart in the same boot unlocks:
# a kernel that came up and then failed reboots the box (#2998, ExecStopPost= below).
# On a boot by the tpm slot, unlock also carries out the owner's lost-card request (REC-4, route B of
# D-201): agentosd writes the kernel's head-signed approval to its root-only state directory, and unlock
# makes the new recovery key, replaces the recovery slot and backup recipient in one write, and hands
# the key to the kernel for the new card. A request that is not one is ignored and the box starts.
# The clerks (MAIL-unit): unlock writes the owner's anchors for them to a file only root writes
# (D-146); the kernel calls the mail clerk on its socket, admitting only its uid, and hands it its key
# on a socket only the service manager starting agentos-keeper-mail.service, in that unit's cgroup,
# is answered on (MAIL-keys). The edge link (EDGE-link-core c2c): agentos-link asks the kernel about the
# edge's key and has it sign the link's TLS on one more socket, admitting only the link's uid. A
# slice's name nests at each "-", so the keeper's slice is under
# agentos.slice.
[Unit]
Description=agentOS kernel
ConditionPathExists=/var/lib/agentos-store/store
After=local-fs.target systemd-sysusers.service agentos-keeper-enroll.service
# #2897: each start opens the counter anchor, which spends two of the TPM counter's increments
# (LOG-anchor-tpm-b), so a crash loop under Restart= stops after three starts in a boot.
StartLimitIntervalSec=infinity
StartLimitBurst=3

[Service]
# #2899: nothing reaches the unlock step past descriptor 2 (no socket activation, no OpenFile=,
# no descriptor store), and nothing it starts gains privileges: it drops every id itself, and no
# capability or securebits setting carries any past the drop (mkosi.finalize refuses one).
NoNewPrivileges=yes
# The kernel's sockets, which its peers reach, and its "up" file (#2998): the directory holds only
# them (0711), and is the kernel's to make them in. Not RuntimeDirectory=: systemd chowns that to the
# unit's user (root here) at every command's spawn, ExecStart's too, so the kernel could not bind in
# it (#3073). The directory outlives a stop, so each start first removes the last start's "up": a
# start refused after a good one must not read as a kernel that came up (#2998, ExecStopPost= below).
ExecStartPre=/usr/bin/install -d -m 0711 -o agentos-kernel -g agentos-kernel /run/agentos-kernel
ExecStartPre=/usr/bin/rm -f /run/agentos-kernel/up
ExecStart=/usr/lib/agentos/with-uids /usr/lib/agentos/agentos-unlock -store /var/lib/agentos-store/store \
        -recovery-request /var/lib/agentos/recovery-request \
        -clerk-anchors /run/agentos-keeper/anchors -log /var/lib/agentos-kernel/log \
        -uid @uid:agentos-kernel -gid @gid:agentos-kernel -exec /usr/lib/agentos/agentos-kernel -- \
        -log /var/lib/agentos-kernel/log -anchor-dir /var/lib/agentos-kernel/anchor \
        -keys-dir /var/lib/agentos-kernel/keys -content-dir /var/lib/agentos-kernel/content \
        -backup-dir /var/lib/agentos-kernel/backups \
        -owner-sock /run/agentos-kernel/owner.sock -owner-uid @uid:agentos-owner \
        -meter-sock /run/agentos-kernel/meter.sock -meter-uid @uid:agentos-model \
        -clerk mail=/run/agentos-mail/kernel.sock,@uid:agentos-mail \
        -clerk-key mail=/run/agentos-kernel/key-mail.sock,/agentos.slice/agentos-keeper.slice/agentos-keeper-mail.service \
        -link-sock /run/agentos-kernel/link.sock -link-uid @uid:agentos-link \
        -up /run/agentos-kernel/up
# #2998: after the cap, a restart in this boot is refused at the unseal, so a kernel that came up (its
# sockets listened, and it made "up") and then failed reboots the box. One refused at its start (no
# owner's hardware keys, a log under another key, a rolled-back drive) never made "up": every boot
# would repeat it, so it stays down as before. The reboot waits until the box has been up 30 minutes
# (a boot timer past its time elapses at once), so a kernel that fails soon after every boot reboots
# the box at most twice an hour, and spends at most four of the counter's increments an hour (#2897).
ExecStopPost=/usr/bin/sh -c 'if [ "$$SERVICE_RESULT" != success ] && [ -e /run/agentos-kernel/up ]; then exec /usr/bin/systemd-run --on-boot=30min --unit=agentos-kernel-reboot /usr/bin/systemctl reboot; fi'
StandardError=journal+console
Restart=on-failure
RestartSec=10
# The store key, then the log and head keys, live in this process's memory (IMG-nodump).
LimitCORE=0
UMask=0077
ProtectSystem=full
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
# The TPM is the keeper's (#2889 Security later 2). The kernel's uid opens none: it uses the
# connection unlock opened (ASSUMPTIONS STO-2c-g).
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr

[Install]
WantedBy=multi-user.target
