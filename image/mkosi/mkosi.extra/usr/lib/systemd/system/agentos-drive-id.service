[Unit]
Description=Give this drive its own partition GUIDs
Documentation=file:/usr/lib/agentos/drive-id
# Once per drive, after its first boot has passed the health check (which runs drive-id check) and
# been blessed.
Requires=boot-complete.target
After=boot-complete.target systemd-bless-boot.service
ConditionPathExists=!/var/lib/agentos/drive-id

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/agentos/drive-id assign
StandardOutput=journal+console
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr
# Block devices only (sfdisk writes the drive's GUIDs): only the keeper's
# units reach the TPM (#2889, STO-2c). Not char-misc, which holds /dev/tpm0 too.
DevicePolicy=closed
DeviceAllow=block-* rw

[Install]
WantedBy=multi-user.target
