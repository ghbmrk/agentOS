# Starts the broker, if it is not running, as soon as onboarding writes its settings (UX-41-1).
# The broker no longer waits for them: on a preloaded box it starts in setup mode (#1249).
[Unit]
Description=AgentOS broker settings

[Path]
PathExists=/etc/agentos/agentosd.env
Unit=agentosd.service

[Install]
WantedBy=paths.target
