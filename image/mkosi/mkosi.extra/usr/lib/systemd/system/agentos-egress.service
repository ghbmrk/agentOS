# The vault process (agentos-egress serve): it holds the vault and the API keys, and it is the only
# path from this box to a model provider (ARC-1, ARC-6, CRED-9). agentosd reaches it on model.sock,
# verify.sock and routing.sock, the Wi-Fi page on unlock.sock, all in /run/agentos-egress (#1249).
# Until the page records the claim there is no vault: the process serves its sockets, and
# egress-setup makes the setup vault (init -setup) before a start and when the claim is recorded.
[Unit]
Description=agentOS vault process
# Never without the inbound drop (DEV-net-e 2a), and up before the broker and the page.
# No wait for an uplink (#1416): with a cable in but no lease, or none at all, network-online
# would hold this unit, and the page after it, for wait-online's whole timeout. The policy learns
# the home network from netlink and its poll, not at start.
Requires=agentos-inbound.service
After=local-fs.target agentos-inbound.service
Before=agentosd.service agentos-localui.service

[Service]
User=agentos-egress
Group=agentos-egress
# The vault, its key slots, unlock state and adopted routing rule: the vault user's only.
StateDirectory=agentos-egress
StateDirectoryMode=0700
# Its sockets: each one admits only its peer's uid (SO_PEERCRED).
RuntimeDirectory=agentos-egress
RuntimeDirectoryMode=0711
# Kept across stops and restarts (#1628): agentos-ap masks this directory, and a mask on a
# removed directory is detached, so a recreated one would show through until agentos-ap restarts.
RuntimeDirectoryPreserve=yes
# Only on the drive this PC booted, as the broker (drive-id).
ExecStartPre=+/usr/lib/agentos/drive-id check
ExecStartPre=+/usr/lib/agentos/egress-setup
# agentosd runs as root; the page has its own user. No machine is granted a model and no provider
# is allowed private data here: the owner grants them at setup (CAP-9).
ExecStart=/usr/lib/agentos/with-uids /usr/lib/agentos/agentos-egress serve -broker-uid 0 \
        -unlock-uid @uid:agentos-localui -rule /usr/lib/agentos/egress/rule.json
Restart=on-failure
RestartSec=5
# The API keys and the vault passphrase live in this process's memory (IMG-nodump).
LimitCORE=0
# Memory ceiling (SR3-mail-k18e): a reply the parser bounds miss ends this process, inside its own
# cgroup, not the host or another unit; it restarts locked (fail closed). The bounded paths peak
# near 1.2 GiB at once: eight mail calls each at mail M21's worst (a response at the field bound
# plus a full Fetch budget), one unlock's Argon2id and the proxy's request bodies
# (tests/test_egress_memory.py derives it). The Go heap's soft limit sits under MemoryHigh, which
# sits under the cap, a quarter of the HW-4 floor's 8 GB.
Environment=GOMEMLIMIT=1536MiB
MemoryHigh=1792M
MemoryMax=2G
# At least the page's and the modem bridge's sandbox (Security B1 on #1302). The + steps above run
# outside it, as root (egress-setup drops to the page's and the vault's users itself), except the
# device policy, which binds the whole unit: drive-id reads partitions from sysfs and udev, not /dev.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# No other process's /proc entries. ProcSubset=pid is left off: netguard learns the gateway from
# /proc/net/route and /proc/net/ipv6_route, which that would hide (B3 on #1302).
ProtectProc=invisible
PrivateIPC=yes
RemoveIPC=yes
# No PrivateDevices: the TPM (/dev/tpmrm0, group agentos-egress) is how a trusted host opens the
# vault (CRED-8), and it is the only device beyond systemd's pseudo-devices (null, urandom, ...).
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
# No IP filter: providers are reached from here, and netlink watches the routes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr

[Install]
WantedBy=multi-user.target
