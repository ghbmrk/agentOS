[Unit]
Description=Reboot into the next boot try after a failed health check
Documentation=file:/usr/lib/agentos/fallback

[Service]
Type=oneshot
ExecStart=/usr/lib/agentos/fallback
StandardOutput=journal+console
# No code from writable storage (UPD-10): only the read-only, verity-checked /usr executes.
NoExecPaths=/
ExecPaths=/usr
# No device but the standard pseudo-devices: only the keeper's units reach the TPM (#2889, STO-2c).
DevicePolicy=closed
