enable agentos-inbound.service
# The wired uplink (20-agentos-uplink.network, #1416).
enable systemd-networkd.service
enable agentos-health.service
enable agentos-boot-report.service
enable agentosd.service
enable agentosd.path
enable agentos-egress.service
enable agentos-egress-setup.path
enable agentos-localui.service
enable agentos-modem.service
enable agentos-modem-env.path
enable agentos-drive-id.service
# The weekly reboot (UPD-10).
enable agentos-reboot.timer
# The monthly restore drill's report, after the drill's reboot (#2932).
enable agentos-drill-report.service
# The keeper (STO-2c): enrollment, then the unlock step that becomes the kernel; each waits on its
# own conditions (the Owner Card's factors, the store).
enable agentos-keeper-enroll.service
enable agentos-keeper-kernel.service
# The recovery-key rotation's socket (REC-4): its one-shot runs per connection.
enable agentos-keeper-rotate.socket
# Debian's nftables.service runs /etc/nftables.conf, which flushes the whole ruleset.
disable nftables.service
# NetworkManager runs for the station only (50-agentos.conf); no join is enabled before the sealed store.
enable NetworkManager.service
# Nothing waits on a Wi-Fi join to finish booting, and no dispatcher script ships.
disable NetworkManager-wait-online.service
disable NetworkManager-dispatcher.service
