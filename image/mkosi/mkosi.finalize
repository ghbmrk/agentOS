#!/usr/bin/env python3
"""Refuse an image tree that carries per-install state (HW-1) or socket files (V15).

mkosi runs this as the last step before it writes the partitions, with the tree in $BUILDROOT.
Every drive gets the same image, so anything generated during the build (a machine ID, a random
seed, a host key, the snakeoil TLS key) would be shared by every box, and owner state belongs only
on that owner's drive. A planted socket file could look like a broker socket inside a guest.
It also refuses a tree that could write the broker's memory to disk (IMG-nodump): the Owner Card
passphrase is a Go string that cannot be zeroed (card C13), so core dumps must be discarded and
there must be no swap. And it refuses a tree without the controller radio's firmware (#1415), since
the setup network cannot come up without it, or one that lets the same chip's Bluetooth half load.
It refuses a tree whose networkd could forward or masquerade (#1478): the inbound drop has no
forward hook, so the wired uplink file is the only live .network file, it holds exactly the shipped
keys, and no networkd setting turns forwarding on. And it refuses a tree that tells the LAN about the box (#1479): the uplink sends no
hostname and uses addresses without the MAC, and resolved answers no LLMNR or multicast DNS.
Every tmpfiles.d line must be on tmpfiles.allow, nothing but mkosi's credentials may ship in a credential
store, and no configuration file it reads may be a link other than a mask to /dev/null, or be reached
through a step that is not root's or that anyone else can write; no link anywhere in the tree may
reach into a directory anyone on the box can write (#1543).
Usage outside mkosi: mkosi.finalize ROOT; mkosi.finalize --tmpfiles-allowlist ROOT prints the
allowlist for a tree."""
import errno
import fnmatch
import os
import re
import stat
import sys

# Files that systemd, dbus, OpenSSH or ssl-cert generate per install. Must not exist in the image.
GENERATED = ("var/lib/systemd/random-seed", "var/lib/systemd/credential.secret",
             "var/lib/dbus/machine-id", "etc/ssh/ssh_host_*", "etc/ssl/private/*",
             "etc/credstore*/*", "var/lib/systemd/credential*/*")
# Owner configuration and broker state. Created on the drive at onboarding, never in the image.
OWNER_DIRS = ("etc/agentos", "var/lib/agentos")
# Content scan: where build-generated keys land. /usr is package content, the same for everyone.
SCAN = ("etc", "var", "root", "home", "srv", "opt", "boot", "efi")
KEY_MARKERS = (b"PRIVATE KEY-----", b"PGP PRIVATE KEY BLOCK", b"AGE-SECRET-KEY-")
# Larger files are not content-scanned (key files are small); the OpenClaw guest under /usr is
# package content from pinned sources and is covered only by the socket check.
SCAN_MAX = 1 << 20
# IMG-nodump: what each setting must end up as, after every file systemd reads.
CORE_PATTERN = "|/usr/bin/false"
NODUMP_SYSCTL = "usr/lib/sysctl.d/99-agentos-nodump.conf"
# The services that hold the card's passphrase, the vault's keys, the claim's codes or the setup
# network's password in memory.
CARD_UNITS = ("agentosd.service", "agentos-egress.service", "agentos-localui.service", "agentos-ap.service")
# systemd 257.13's search path for its configuration files, highest precedence first: CONF_PATHS
# (src/basic/constants.h) without /run, which the box mounts a tmpfs over, so nothing the tree puts
# there is read (stray_violations refuses it). Split-/usr /lib is not searched by 257 at all.
def conf_paths(n):
    return ("etc/" + n, "usr/local/lib/" + n, "usr/lib/" + n)


# The system manager's unit search path in the image, highest precedence first (lookup_paths_init
# in src/libsystemd/sd-path/path-lookup.c, without its /run entries).
UNIT_PATHS = ("etc/systemd/system.control", "etc/systemd/system", "etc/systemd/system.attached",
              "usr/local/lib/systemd/system", "usr/lib/systemd/system")
# Where swap units are looked for (any precedence).
UNIT_DIRS = ("usr/lib/systemd/system", "lib/systemd/system", "usr/local/lib/systemd/system",
             "etc/systemd/system")
SWAP_GENERATORS = ("zram-generator", "systemd-zram-generator")
# The M6 Ultra's RZ616 (MT7922) radio (#1415): the files mt7921e requests (MT7922_FIRMWARE_WM and
# MT7922_ROM_PATCH in the kernel's mt792x.h), from firmware-mediatek (non-free-firmware).
RADIO_FIRMWARE = ("usr/lib/firmware/mediatek/WIFI_RAM_CODE_MT7922_1.bin",
                  "usr/lib/firmware/mediatek/WIFI_MT7922_patch_mcu_1_1_hdr.bin")
# The kernel's firmware loader also tries these suffixes (Debian's kernel enables both).
FIRMWARE_SUFFIXES = ("", ".xz", ".zst")
# The same chip's Bluetooth half, which nothing uses: these modules must never load (#1415).
BLOCKED_MODULES = ("btusb", "btmtk")
# kmod 34's modprobe.d directories (default_config_paths in libkmod/libkmod.c), highest precedence
# first, without /run (a tmpfs on the box).
MODPROBE_DIRS = ("etc/modprobe.d", "usr/local/lib/modprobe.d", "usr/lib/modprobe.d", "lib/modprobe.d")
REFUSE = ("/bin/false", "/usr/bin/false")
# The only .network file the image may run (#1478); anything else (Debian's 80-* container, VM and
# ad-hoc files) must be removed or masked.
UPLINK = "20-agentos-uplink.network"
# The uplink's every assignment, as (section, key): value (#1496). The live uplink must hold exactly
# these, each once: an allowlist, since networkd also honours old spellings (ProxyARP=, [DHCP]),
# generic DHCP options (SendOption=) and list keys (a second Token=) that a denylist misses. With
# them nothing forwards, answers or advertises on the LAN (#1478), the box sends no hostname (every
# box is "agentos") and its IPv6 addresses carry no MAC (#1479).
UPLINK_KEYS = {("Match", "Type"): "ether", ("Match", "Kind"): "!*", ("Network", "DHCP"): "yes",
               ("Network", "IPv6PrivacyExtensions"): "yes", ("DHCPv4", "SendHostname"): "no",
               ("DHCPv6", "SendHostname"): "no", ("IPv6AcceptRA", "Token"): "prefixstable"}
# sysctl leaves that turn routing on (#1478). systemd-sysctl expands a glob key per component against
# /proc/sys, so a key counts when its first component is "net" or a glob and its last is one of these
# or a glob (#1497). Any glob counts, not only one that matches: glibc's glob takes [^x] as a negated
# class and Python's fnmatch does not. Components are taken after systemd's normalisation (#1508).
FORWARD_LEAVES = ("ip_forward", "forwarding", "force_forwarding")
GLOB = re.compile(r"[*?\[]")
# In a glob key (one holding *, ? or [), systemd-sysctl's glob() also takes a backslash as an escape
# and {a,b} as alternatives (GLOB_BRACE, which can span a "/"), so either makes the whole key count.
GLOB_ESCAPE = re.compile(r"[\\{]")
# systemd's read_line ends a sysctl.d line at LF, CR or NUL; Python's splitlines also splits at
# \x0b, \x0c, \x1c-\x1e, U+0085, U+2028 and U+2029. The check refuses every such byte, any other
# control byte and a BOM rather than model them (#1508).
SYSCTL_BAD_BYTES = re.compile(rb"[\x00-\x08\x0a-\x1f\x7f]|\xc2\x85|\xe2\x80[\xa8\xa9]|\xef\xbb\xbf")
# systemd's LONG_LINE_MAX: read_line fails on a line of this many bytes or more (the length check
# comes before the end-of-line check), and systemd-sysctl and config_parse stop reading the file
# there (#1508).
LONG_LINE_MAX = 1 << 20
# Where the booted box mounts something of its own (devtmpfs, proc, sysfs, tmpfs): a link into one
# reaches what the box makes, not the image, and nothing the tree puts there is read.
BOX_MOUNTS = ("dev", "proc", "sys", "run", "tmp")
# #1543 Security R2: directories anyone on the box can write, whether or not the tree holds them yet:
# systemd mounts /tmp, /dev/shm and /dev/mqueue 1777, and tmpfiles' tmp.conf and legacy.conf make
# /var/tmp and /run/lock 1777 at boot. Any directory the tree itself gives o+w counts too.
WORLD_WRITABLE = ("tmp", "var/tmp", "dev/shm", "dev/mqueue", "run/lock")
# #1702: directories a service user or a login user owns on the box. A unit's fuzz children run in
# var/lib/agentos-fuzz (tmpfiles' ACLs deny that user /tmp, /var/tmp and /dev/shm, so it is the one
# place it can write), agentos-localui serves the LAN-facing setup page from var/lib/agentos-localui,
# the vault's user from var/lib/agentos-egress; DynamicUser services live under var/lib/private, and
# people under home and run/user; the egress, netjoin and ap units' RuntimeDirectory= lives under run.
# A link into one is refused like one into WORLD_WRITABLE.
SERVICE_DIRS = ("var/lib/agentos-fuzz", "var/lib/agentos-localui", "var/lib/agentos-egress", "home",
                "run/user", "var/lib/private",
                "run/agentos-egress", "run/agentos-netjoin", "run/agentos-ap")
# #1702 (delta 2): the only links the tree may hold into what the box mounts, by the link's path and
# its exact target. Anything else that reaches a box mount is refused (world_writable_link): the box
# makes what is there at boot (/proc/self/root, /proc/<pid>/cwd and /dev/fd are links to wherever the
# reader is), so where such a link ends is not known at build time. CI's stock trixie build holds
# exactly these four (listed from the build, 2acb5843) and four masks: var/lock -> /run/lock,
# var/run -> /run, etc/mtab -> ../proc/self/mounts and etc/resolv.conf ->
# ../run/systemd/resolve/stub-resolv.conf. The relative var/lock and var/run forms are trixie's own
# tmpfiles lines (legacy.conf, debian.conf), so a tree they made passes too.
# An entry, like a mask, skips every link rule (world-writable, SERVICE_DIRS, '..'), so this rule is
# the only check on it. Add an entry only as "<rel>": ("<target>",), copied from the build's refusal,
# with every form the tree may hold, and only if <target> names a fixed, root-owned file or directory:
# not under /proc/self, /proc/thread-self, /proc/<pid>, /dev/fd or /dev/std*, and neither
# world-writable nor service-owned unless named as an exception here. Then update the BOX_LINKS
# assertion in tests/test_image.py (I23).
# Exceptions: var/lock names /run/lock, which is 1777; the link is root's and names only that one
# directory, which /var/lock has always been. etc/resolv.conf names a file in /run/systemd/resolve,
# which is systemd-resolved's RuntimeDirectory=, owned by the service user systemd-resolve: readers
# parse it as resolver configuration (nameservers, search domains, options), not code, and resolved
# already answers every DNS query the box sends to 127.0.0.53, so owning it gains that user nothing.
# Neither exception extends by analogy to another world-writable or service-owned target.
# A mask (a link to exactly MASK) passes wherever it is but at a box mount point: /dev/null is the box's own
# device.
BOX_LINKS = {"var/lock": ("../run/lock", "/run/lock"),
             "var/run": ("../run", "/run"),
             "etc/mtab": ("../proc/self/mounts",),
             "etc/resolv.conf": ("../run/systemd/resolve/stub-resolv.conf",)}
# The systemd configuration this check reads, by its name under each configuration directory.
# #1543 Security B1: the only links the check follows to a configuration file it reads. A file that is
# a link to exactly /dev/null is a mask (it reads as nothing), and trixie's merged-/usr /lib is a link
# to usr/lib. Any other link is refused, wherever it points: a dangling link reads as nothing at build
# and as whatever appears at its target on the box (/var/tmp is world-writable), and any link reaches
# a file the build may not have read. tmpfiles.d takes no link at all, not even a mask (stock has none).
MASK = "/dev/null"
TOP_LINKS = {"lib": ("usr/lib", "/usr/lib")}
READ_CONF = ("sysctl.d", "tmpfiles.d", "systemd/network", "systemd/system", "systemd/system.control",
             "systemd/system.attached") + tuple("systemd/%s%s" % (n, d) for n in
                                                ("coredump.conf", "system.conf", "networkd.conf", "resolved.conf")
                                                for d in ("", ".d"))


_MAKERS = None  # #1829: tmpfiles_makers by root while violations() runs, else None


def violations(root):
    """Every reason the tree at ROOT must not ship, one line each."""
    global _MAKERS
    _MAKERS = {}
    try:
        return _violations(str(root))
    finally:
        _MAKERS = None


def tmpfiles_maker(root, parts, st=None, lacks=False):
    """#1803, #1829: (file, line number, what) of the first tmpfiles.d line tmpfiles_makers counts
    that names step PARTS, or None. Inside violations() the makers are read once per root. ST: the
    held step's tree_lstat; a line giving group write (a Z line also on the steps below it) counts
    when ST's gid is not root, whatever group another line claims to set. LACKS: the tree lacks the
    step; ST then carries no mode and its parent's gid."""
    makers = _MAKERS.get(root) if _MAKERS is not None else None
    if makers is None:
        makers = tmpfiles_makers(root)
        if _MAKERS is not None:
            _MAKERS[root] = makers
    for rel, n, (paths, what, compose) in makers:
        if compose is None:
            if any(len(m) == len(parts) and glob_reaches(m, parts) for m in paths):
                return rel, n, what
        elif st is not None and st.st_gid != TREE_GROUP and any(
                (len(m) == len(parts) or compose[0] and len(m) < len(parts))
                and glob_reaches(m, parts, ancestor=True) for m in paths):
            return rel, n, "%s %s gid %d" % (what, "under a parent of" if lacks else "over the tree's", st.st_gid)
    return None


def _violations(root):
    out = []
    try:
        if Conf(root, "etc/machine-id").text().strip() not in ("", "uninitialized"):
            out.append("etc/machine-id: holds an ID; must be empty or 'uninitialized'")
    except FileNotFoundError:
        pass
    except OSError as e:
        out.append("etc/machine-id: unreadable (%s); the tree check never passes a file it cannot read" % e.strerror)
    for pat in GENERATED:
        for parts in tree_glob(root, pat.split("/")):
            if stat.S_ISREG(entry_mode(root, "/".join(parts))):
                out.append("%s: generated per install; must not ship" % "/".join(parts))
    for d in OWNER_DIRS:
        if d == "etc/agentos" and entry_mode(root, d):
            out.append("etc/agentos: owner configuration; written at onboarding only")
        elif d == "var/lib/agentos" and tree_dir(root, d) and tree_listdir(root, tree_dir(root, d)):
            out.append("var/lib/agentos: broker state; must be empty")
    # LOOP-7's state: agentosd creates it on the box and gives it to the fuzz user (agentosd L7-6).
    if entry_mode(root, "var/lib/agentos-fuzz"):
        out.append("var/lib/agentos-fuzz: fuzz state; created on the box, never shipped")
    # The vault and the page's claim state: their units create them on the box (#1249, #1270).
    for d, what in (("var/lib/agentos-egress", "vault state"), ("var/lib/agentos-localui", "claim state")):
        if entry_mode(root, d):
            out.append("%s: %s; created on the box, never shipped" % (d, what))
    for rel, st in tree_walk(root):
        if stat.S_ISSOCK(st.st_mode):
            out.append("%s: socket file (V15)" % rel)
        elif (stat.S_ISREG(st.st_mode) and st.st_size <= SCAN_MAX
              and rel.split("/", 1)[0] in SCAN and has_key(root, rel)):
            out.append("%s: private key material" % rel)
        elif stat.S_ISLNK(st.st_mode):
            out += world_writable_link(root, rel)
        if (not stat.S_ISLNK(st.st_mode) and st.st_mode & 0o002
                and not any(rel == w or rel.startswith(w + "/") for w in WORLD_WRITABLE)):
            # #1702: any entry anyone on the box can write, file or directory, sticky or not, wherever
            # it is but in or below the directories the box makes world-writable (nothing reads
            # configuration there, and a link into them is refused): a unit, a drop-in, a rules file
            # or a generator elsewhere is then the user's. A tree-wide group-write rule is deliberately
            # absent (stock trixie has 2775 var/mail and var/local); a link's steps and the directories
            # holding it are held to one (#1829, step_refusal).
            out.append("%s: mode %04o is writable by anyone on the box (#1702)" % (rel, st.st_mode & 0o7777))
    return (out + dump_violations(root) + swap_violations(root) + radio_violations(root)
            + bluetooth_violations(root) + sysctl_byte_violations(root) + network_violations(root)
            + resolved_violations(root) + tmpfiles_violations(root) + tmpfiles_allow_violations(root)
            + credstore_violations(root) + stray_violations(root))


# #1543 (delta 4 B1): every look at the image tree goes through these four primitives, and none of
# them follows a link on the build host: each step before the last must be a directory, never a link.
# Configuration is read only through conf_chase and Conf, which apply the link and owner rules on top.
# tests/test_image.py's TreeAccessTest parses this file and fails on a file-reading or stat call
# anywhere else, so a new reader cannot skip the chase (three review rounds each found one that did).
def world_writable_link(root, rel):
    """#1543 Security R2, #1702: the refusal for link REL in the tree, by link_refusal's rules, with
    the link's target and where it resolves (tree_chase)."""
    walked = []
    try:
        path = tree_chase(root, rel, missing_ok=True, walked=walked)[0]
    except OSError:
        # Fail-open on purpose: a loop or a non-directory step fails the same lookup on the box, so
        # the link reads nothing. Keep it so if tree_chase changes, or this becomes a quiet hole.
        return []
    target = tree_readlink(root, rel)
    why = link_refusal(root, rel, target, path, walked=walked)
    return ["%s: %s" % (rel, why)] if why else []


def link_refusal(root, rel, target, path, made=False, walked=()):
    """#1543 Security R2, #1702, #1803: why a link at REL to TARGET, which resolves to PATH (tree_chase
    with missing_ok), is refused, or None. A link is refused if its target resolves, or where the tree
    stops would resolve, to a directory anyone on the box can write (WORLD_WRITABLE, or a directory
    the tree gives o+w), to a directory one of the box's service users owns (SERVICE_DIRS), or to
    anything inside one: a local user, or a compromised service user, then decides what the link
    reads, whatever reads it (a unit, a generator, udev). The directory itself counts, since every
    name inside it is the user's. So is one through a step of the tree that a uid other than
    TREE_OWNER owns, that a group other than TREE_GROUP can write, that carries a POSIX ACL (#1803,
    #1829: the mode alone does not say who can write it) or that a tmpfiles.d line remakes a link or
    for someone else to write (#1829: the box runs the line after the build), and one through a step
    the tree lacks that such a line makes (#1803, a C line counting too: the line, not the tree,
    decides where it leads). The tree directories holding the link itself are held to the same step
    rules, before anything but the box mount rule (#1829): whoever can write one can replace the
    link, whatever it names. Any other link that
    reaches a box mount is refused too (default deny). A link at a box mount point itself
    (BOX_MOUNTS) is refused before anything else: the box moves its mount onto where the link leads.
    Then the stock links in BOX_LINKS (matched by path and exact target) and a mask pass, and skip
    every other rule here, on purpose: var/lock's target /run/lock is 1777, so the world-writable
    rule would refuse it. So BOX_LINKS' admission rule (its comment, I23) is the only check on an
    entry; the '..', world-writable and SERVICE_DIRS rules apply to every other link. MADE: the link
    is one a tmpfiles.d line makes on the box, so one under a box mount is not hidden by the mount.
    WALKED: the tree directories the chase stepped into on the way (tree_chase), held to the same
    step rules, since whoever can write one can swap the link in it that the chase followed."""
    if rel in BOX_MOUNTS:
        # Security delta 3: the box mounts its own filesystem at /dev, /proc, /sys, /run and /tmp, and
        # switch-root and PID 1 follow a link there (systemd 257's switch-root chases each mount
        # point in the new root), so the mount lands where the link leads: dev -> var/tmp gives a /dev
        # anyone can write, and a missing target fails the boot. Before the mask and BOX_LINKS rules.
        return ("a link to %s; /%s is where the box mounts its %s, and a link there would move the "
                "mount (#1702)" % (target, rel, {"dev": "devtmpfs", "proc": "proc", "sys": "sysfs"}
                                   .get(rel, "tmpfs")))
    held = rel.split("/", 1)[0] not in BOX_MOUNTS
    if held or made:
        # #1829 (Security R1 gap 5): the directories holding the link, as far as the tree holds them
        # without a link. A link the tree holds under a box mount is hidden by the mount; one a
        # tmpfiles.d line makes there is held to the world-writable and SERVICE_DIRS rules only.
        holders = rel.split("/")[:-1]
        for k in range(1, len(holders) + 1):
            d = "/".join(holders[:k])
            try:
                st = None if d in WORLD_WRITABLE or d in SERVICE_DIRS else tree_lstat(root, d)
            except OSError:
                break
            why = step_refusal(root, d, target, held, st, via="in")
            if why:
                return why
            if st is None or stat.S_ISLNK(st.st_mode):
                break
    if target == MASK or target in BOX_LINKS.get(rel, ()):
        return None
    if ".." in path.split("/"):
        # A '..' after a box mount, or after a step the tree lacks, cannot be cancelled lexically:
        # /run/../var/lock is /var/lock on the box, which is /run/lock (1777). Box-made links such as
        # /dev/fd make a lexical '..' unsound inside a mount too, so any such tail is refused.
        return ("a link to %s, which goes up with '..' past a directory the tree does not hold; "
                "where it ends is not known at build time (#1702)" % target)
    parts = path_parts(path)
    for d in walked:
        # #1803 (Security R1): a directory holding a link the chase followed, off the final path.
        why = step_refusal(root, d, target, True)
        if why:
            return why
    gid = TREE_GROUP
    for k in range(1, len(parts) + 1):
        d = "/".join(parts[:k])
        try:
            st = None if d in WORLD_WRITABLE or d in SERVICE_DIRS else tree_lstat(root, d)
        except OSError:
            continue
        why = step_refusal(root, d, target, not path.startswith("/"), st)
        if why:
            return why
        if st is not None:
            gid = st.st_gid
        elif not path.startswith("/"):
            # #1803: the tree lacks this step, so a tmpfiles.d line may make it on the box: a link
            # (whose target the tree never chased here) or a directory someone else can write. #1829
            # (security delta 2, combined delta 2): it may take its parent's group (a setgid bit the
            # tree or a line sets), so the lines that make it are weighed with that gid.
            made = tmpfiles_maker(root, parts[:k], os.stat_result((stat.S_IFDIR, 0, 0, 0, 0, gid, 0, 0, 0, 0)),
                                  lacks=True)
            if made:
                return ("a link to %s, through /%s, which the tree lacks and %s line %d makes %s; "
                        "ship the step in the tree (#1803)" % ((target, d) + made))
    if path.startswith("/") and (made or rel.split("/", 1)[0] not in BOX_MOUNTS):
        # Default deny (#1702 delta 2): the chase stopped at a box mount (tree_chase gives only such a
        # path a leading '/'), and only BOX_LINKS' exact links may end there. A link the tree holds
        # under a box mount is hidden by the mount on the box, so it is not one; a link a tmpfiles.d
        # line makes there (MADE) is.
        return ("a link to %s%s, which ends in /%s, which the box fills at boot, so where it ends is not "
                "known at build time; ship the file itself, or, if this link is stock and names a fixed "
                "root-owned file, add it to BOX_LINKS per I23 (#1702)"
                % (target, "" if path == target else ", which reaches " + path, path.split("/")[1]))
    return None


def step_refusal(root, d, target, held, st=False, via="through"):
    """#1543, #1702, #1803, #1829: why a link to TARGET whose chase steps into tree directory D, or
    that D holds (VIA "in"), is refused, or None. ST: D's tree_lstat (None if the tree lacks it),
    looked up when not given. HELD: D is a step of the tree, not under a box mount, so its owner,
    group write, ACL and the tmpfiles.d lines that remake it count too."""
    if st is False:
        try:
            st = None if d in WORLD_WRITABLE or d in SERVICE_DIRS else tree_lstat(root, d)
        except OSError:
            return None
    if st is None and (d in WORLD_WRITABLE or d in SERVICE_DIRS) \
            or st is not None and stat.S_ISDIR(st.st_mode) and st.st_mode & 0o002:
        return ("a link to %s, inside /%s, which anyone on the box can write, or a service user owns; "
                "a local user would decide what it reads (#1543, #1702)" % (target, d))
    if st is not None and held:
        # #1803: who owns each step, and whether an ACL lets anyone else write it. A step the
        # tree check cannot read the attributes of is refused, not passed.
        try:
            acl = [x for x in tree_xattrs(root, d) if x in ACL_XATTRS]
        except OSError as e:
            acl = ["unreadable (%s)" % e.strerror]
        if st.st_uid != TREE_OWNER or acl:
            return ("a link to %s, %s /%s, which %s; that user would decide what it reads (#1803)"
                    % (target, via, d, "uid %d owns" % st.st_uid if st.st_uid != TREE_OWNER
                       else "carries a POSIX ACL (%s)" % ", ".join(acl)))
        if st.st_mode & 0o020 and st.st_gid != TREE_GROUP:
            # #1829 (gap 3): no named exceptions. Debian's var/spool/mail link into 2775 var/mail is
            # removed by mkosi.conf's RemoveFiles; no other stock link goes through var/mail or var/local.
            return ("a link to %s, %s /%s, which gid %d can write; that group would decide what it "
                    "reads (#1829)" % (target, via, d, st.st_gid))
        # #1829 (gap 2): the box runs tmpfiles.d after the build, so a line naming a held step decides
        # its mode, owner, ACL or whether it is a link, whatever the tree ships. Every step of a link's
        # path is asked, so a Z or A line on an ancestor is caught there.
        made = tmpfiles_maker(root, path_parts(d), st)
        if made:
            return ("a link to %s, %s /%s, which %s line %d remakes %s on the box; the line, not the "
                    "tree, decides who can write it (#1829)" % ((target, via, d) + made))
    return None


def tree_lstat(root, rel):
    """lstat of ROOT/REL (ROOT itself for ""), never following a link on the build host: OSError if a
    step before the last is a link, is not a directory, or is '.' or '..'; None if a step is missing."""
    p, parts = str(root), [x for x in rel.split("/") if x]
    st = os.lstat(p)
    for i, name in enumerate(parts):
        if name in (".", ".."):
            raise OSError(errno.EINVAL, "a '.' or '..' component in %s" % rel)
        if i and stat.S_ISLNK(st.st_mode):
            raise OSError(errno.ELOOP, "%s is a link; the tree check never follows one on the build host"
                          % "/".join(parts[:i]))
        if i and not stat.S_ISDIR(st.st_mode):
            raise NotADirectoryError(errno.ENOTDIR, "not a directory", "/".join(parts[:i]))
        p = os.path.join(p, name)
        try:
            st = os.lstat(p)
        except FileNotFoundError:
            return None
    return st


def tree_listdir(root, rel):
    """The names in directory REL (tree_lstat's rules: no link on the way, REL itself not a link)."""
    st = tree_lstat(root, rel)
    if st is None:
        raise FileNotFoundError(errno.ENOENT, "No such file or directory", rel)
    if not stat.S_ISDIR(st.st_mode):
        raise NotADirectoryError(errno.ENOTDIR, "not a directory", rel)
    return os.listdir(os.path.join(str(root), rel))


def tree_readlink(root, rel):
    """The target of link REL (tree_lstat's rules)."""
    st = tree_lstat(root, rel)
    if st is None or not stat.S_ISLNK(st.st_mode):
        raise OSError(errno.EINVAL, "not a link", rel)
    return os.readlink(os.path.join(str(root), rel))


# #1803: the extended attributes that hold a POSIX ACL; either lets a uid or group the mode does not
# name write the directory.
ACL_XATTRS = ("system.posix_acl_access", "system.posix_acl_default")


def tree_xattrs(root, rel):
    """The extended attribute names of REL itself (tree_lstat's rules; a link's own, never its
    target's). [] where the build filesystem keeps none (ENOTSUP)."""
    st = tree_lstat(root, rel)
    if st is None:
        raise FileNotFoundError(errno.ENOENT, "No such file or directory", rel)
    try:
        return os.listxattr(os.path.join(str(root), rel), follow_symlinks=False)
    except OSError as e:
        if e.errno in (errno.ENOTSUP, errno.EOPNOTSUPP):
            return []
        raise


def tree_read(root, rel, limit=-1):
    """The bytes of regular file REL (at most LIMIT), tree_lstat's rules: no link on the way, and REL
    itself must be a regular file (IsADirectoryError for a directory, OSError for anything else).
    Only Conf.content and has_key call it (TreeAccessTest), so configuration is read through the chase."""
    st = tree_lstat(root, rel)
    if st is None:
        raise FileNotFoundError(errno.ENOENT, "No such file or directory", rel)
    if stat.S_ISDIR(st.st_mode):
        raise IsADirectoryError(errno.EISDIR, "a directory")
    if not stat.S_ISREG(st.st_mode):
        raise OSError(errno.EINVAL, "not a regular file")
    fd = os.open(os.path.join(str(root), rel), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY)
    with os.fdopen(fd, "rb") as f:
        now = os.fstat(fd)
        if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
            raise OSError(errno.ESTALE, "changed while the tree check read it")
        return f.read(limit)


def tree_walk(root, rel=""):
    """(path, lstat) of everything below directory REL, in name order, never entering a link."""
    try:
        names = sorted(tree_listdir(root, rel))
    except OSError:
        return
    for n in names:
        r = rel + "/" + n if rel else n
        try:
            st = tree_lstat(root, r)
        except OSError:
            continue
        if st is None:
            continue
        yield r, st
        if stat.S_ISDIR(st.st_mode):
            yield from tree_walk(root, r)


def entry_mode(root, rel):
    """REL's st_mode as the booted image finds the entry itself (its parent resolved inside the image
    by tree_chase, the entry not followed; a parent the box mounts is taken as the tree has it), or 0
    where there is none (a step missing, a loop, a step that is not a directory)."""
    try:
        return tree_entry(root, rel)[1].st_mode
    except (OSError, AttributeError):
        return 0


def tree_entry(root, rel):
    """(in-image path, lstat) of REL's last component, its parent resolved as entry_mode says;
    (None, None) if it is missing. Raises OSError if the parent loops or a step is not a directory."""
    parent, _, name = rel.rstrip("/").rpartition("/")
    try:
        path, st = tree_chase(str(root), parent)
    except FileNotFoundError:
        return None, None
    path = parent if st is None else path
    rel = path + "/" + name if path else name
    st = tree_lstat(root, rel)
    return (rel, st) if st is not None else (None, None)


def tree_dir(root, rel):
    """The in-image path of directory REL (tree_chase; under a box mount, as the tree has it), or None."""
    try:
        path, st = tree_chase(str(root), rel)
        if st is None:
            path, st = rel, tree_lstat(root, rel)
    except OSError:
        return None
    return path if st is not None and stat.S_ISDIR(st.st_mode) else None


class Conf:
    """A configuration file as the booted box reads it: REL is its path in the tree (its directory
    resolved inside the image, then its name), and every link on the way is followed inside the
    image, never on the build host (#1508)."""

    def __init__(self, root, rel, error=None):
        self.root, self.rel, self.error = root, rel, error
        self.name = rel.rsplit("/", 1)[-1]

    def __repr__(self):
        return "Conf(%r)" % self.rel

    def is_link(self):
        try:
            st = tree_lstat(self.root, self.rel)
        except OSError:
            return False
        return st is not None and stat.S_ISLNK(st.st_mode)

    def chase(self):
        """(in-image path, lstat) as tree_chase gives them; raises OSError as it does."""
        if self.error:
            raise OSError(errno.EACCES, self.error)
        return tree_chase(self.root, self.rel)

    def identity(self):
        """What fstat would name: a device and inode, or a path the box mounts at boot."""
        path, st = self.chase()
        return path if st is None else (st.st_dev, st.st_ino)

    def content(self):
        """What systemd reads, as conf_chase allows it: a mask (a link to exactly /dev/null) reads as
        nothing. OSError for any other link (LinkRefused), dangling or not, a step that is not root's
        or that someone else can write (OwnerRefused), a path that is missing, and wherever systemd's
        read fails: nothing unresolvable ever reads as empty (#1543). This is the only reader of
        configuration in the tree (TreeAccessTest)."""
        if self.error:
            raise OSError(errno.EACCES, self.error)
        path = conf_chase(self.root, self.rel)
        if path is None:
            return b""
        return tree_read(self.root, path)

    def text(self, errors="replace"):
        return self.content().decode(errors=errors)


def hidden_or_backup(name):
    """systemd 257.13's hidden_or_backup_file (src/basic/path-util.c), which FOREACH_DIRENT skips."""
    if name.startswith(".") or name in ("lost+found", "aquota.user", "aquota.group") or name.endswith("~"):
        return True
    return "." in name and name.rsplit(".", 1)[1] in (
        "rpmnew", "rpmsave", "rpmorig", "dpkg-old", "dpkg-new", "dpkg-tmp", "dpkg-dist", "dpkg-bak",
        "dpkg-backup", "dpkg-remove", "ucf-new", "ucf-old", "ucf-dist", "swp", "bak", "old", "new")


class StepRefused(OSError):
    """A step on the way to a configuration file that conf_chase does not take (#1543)."""


class LinkRefused(StepRefused):
    """A link on the way to a configuration file that is not one MASK or TOP_LINKS allows (#1543)."""


class OwnerRefused(StepRefused):
    """A step on the way to a configuration file (the tree's root, a directory or the file) that is
    not owned by TREE_OWNER or that its group or anyone can write (#1543 Security R1)."""


# #1543 Security R1: who must own every step on the way to a configuration file. A step someone else
# owns, or that its group or anyone can write, lets that user change what the box reads after the
# build, with no link involved (a 0666 file, a 1777 sysctl.d, a hard link to a file in /var/tmp).
# Stock packages and mkosi.extra give root-owned 0644 files and 0755 directories. The tests set it to
# their own uid, since they cannot make root-owned trees.
TREE_OWNER = 0
TREE_GROUP = 0  # #1829: the only group that may write a step of a link (step_refusal)


def owned(here, st):
    """Raise OwnerRefused unless lstat ST of step HERE is TREE_OWNER's and writable by no one else."""
    if st.st_uid != TREE_OWNER or st.st_mode & 0o022:
        raise OwnerRefused(errno.EPERM, "%s is owned by uid %d with mode %04o; the tree check reads configuration only "
                           "through steps owned by uid %d that no one else can write (#1543)"
                           % (here or "the tree's root", st.st_uid, stat.S_IMODE(st.st_mode), TREE_OWNER))


def conf_chase(root, rel):
    """REL resolved as the tree check lets the box read a configuration file (#1543 Security B1): a
    link to exactly MASK as the last component is a mask (None), the image's own /lib link
    (TOP_LINKS) is followed, and any other link on the way raises LinkRefused, whatever its target.
    Every other step, the tree's root included, must pass owned() (OwnerRefused, #1543 Security R1);
    a link MASK or TOP_LINKS allows is exempt as a link, and the steps it leads to are checked.
    Returns the in-image path. FileNotFoundError if a step is missing; OSError for a '.' or '..'
    component, a step the box mounts at boot, or a step that is not a directory."""
    parts, cur = [x for x in rel.split("/") if x], []
    owned("", tree_lstat(root, ""))
    while parts:
        name = parts.pop(0)
        if name in (".", ".."):
            raise OSError(errno.EINVAL, "a '.' or '..' component in %s" % rel)
        if not cur and name in BOX_MOUNTS:
            raise OSError(errno.EXDEV, "/%s is mounted by the box at boot" % name)
        here = "/".join(cur + [name])
        st = tree_lstat(root, here)
        if st is None:
            raise FileNotFoundError(errno.ENOENT, "No such file or directory", here)
        if stat.S_ISLNK(st.st_mode):
            to = tree_readlink(root, here)
            if not parts and to == MASK:
                return None
            if not cur and to in TOP_LINKS.get(name, ()):
                parts = TOP_LINKS[name][0].split("/") + parts
                continue
            raise LinkRefused(errno.EPERM, "%s is a link to %s; the tree check reads only a regular file or a "
                              "mask (a link to exactly %s), never a link whose target can change (#1543)"
                              % (here, to, MASK))
        owned(here, st)
        if parts and not stat.S_ISDIR(st.st_mode):
            raise NotADirectoryError(errno.ENOTDIR, "not a directory", here)
        cur.append(name)
    return "/".join(cur)


def conf_files(root, dirs, suffix=".conf", kmod=False):
    """The files systemd reads from DIRS (relative to ROOT, highest precedence first), in its order:
    systemd 257.13's conf_files_list_strv(suffix, root, flags=0, dirs) (src/shared/conf-files.c),
    which every reader checked here calls with flags 0. Each directory is resolved inside the image
    (chase_and_opendir; one that is missing or not a directory is skipped). In it, a hidden or
    backup name (hidden_or_backup) or one without SUFFIX is skipped, and so is a name an earlier
    directory already gave. Nothing is stat'ed, so a link to /dev/null, an empty file or a directory
    still takes its name (that is how a file is masked), and so does any other link, dangling or not,
    which Conf.content then refuses (#1543). The listing follows links as systemd does, but every entry
    reached through a directory link conf_chase refuses carries that refusal, and such a directory
    that gives no entry is listed itself, so every reader refuses it whatever it holds; so is a
    directory reached through a step owned() refuses (#1543 Security R1: a 1777 sysctl.d is refused
    while it is still empty).
    The list is sorted by name as bytes (path_compare_filename is strcmp), not as Python strings.
    KMOD: kmod 34's conf_files_list (libkmod/libkmod-config.c) instead, which skips only names
    starting with "." and drops (without taking the name) an entry it cannot stat or that is a
    directory, and reads a non-directory in DIRS as a file of its own. A link kmod would drop as
    unstattable (a dangling one) is listed all the same, so that it is refused, not skipped (#1543)."""
    root = str(root)
    seen, out = set(), []
    for d in dirs:
        try:
            conf_chase(root, d)
            bad = None
        except StepRefused as e:
            bad = e.strerror
        except OSError:
            bad = None
        try:
            path, st = tree_chase(root, d)
        except OSError:
            if bad:
                out.append(Conf(root, d, bad))
            continue
        if st is None:
            out.append(Conf(root, d, bad or "%s resolves to %s, which the box mounts at boot" % (d, path)))
            continue
        if not stat.S_ISDIR(st.st_mode):
            if kmod and d.rsplit("/", 1)[-1] not in seen:
                seen.add(d.rsplit("/", 1)[-1])
                out.append(Conf(root, path, bad))
            elif bad:
                out.append(Conf(root, d, bad))
            continue
        n = len(out)
        for name in tree_listdir(root, path):
            if (name.startswith(".") if kmod else hidden_or_backup(name)) or not name.endswith(suffix):
                continue
            if name in seen:
                continue
            f = Conf(root, path + "/" + name, bad)
            if kmod:  # lstat: a link, dangling or not, is kept and refused when read
                try:
                    st = tree_lstat(root, f.rel)
                except OSError:
                    continue
                if st is None or stat.S_ISDIR(st.st_mode):
                    continue
            seen.add(name)
            out.append(f)
        if bad and len(out) == n:
            out.append(Conf(root, d, bad))
    return sorted(out, key=lambda f: os.fsencode(f.name))


class Unparsable(Exception):
    """A line where systemd's config_parse fails, and so stops reading."""


WHITESPACE = b" \t\n\r"
BOM = b"\xef\xbb\xbf"


def utf8_valid(b):
    """systemd 257.13's utf8_is_valid: strict UTF-8 without surrogates or noncharacters."""
    try:
        s = b.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return not any(0xFDD0 <= ord(c) <= 0xFDEF or (ord(c) & 0xFFFE) == 0xFFFE for c in s)


def config_lines(data):
    """(section, key, value) for each assignment systemd 257.13's config_parse reads from DATA
    (src/shared/conf-parser.c, with parse_line): lines are read with read_line, a line starting
    (after whitespace) with # or ; is a comment even inside a continuation, one BOM is dropped, a
    line ending in an unescaped backslash continues into the next (the backslash becomes a space),
    and each logical line is stripped of space, tab, CR and LF. Raises Unparsable wherever
    config_parse fails: NUL or CR (read_line ends a line there; refused rather than modelled), a
    line of LONG_LINE_MAX bytes or more, invalid UTF-8, or a bad section header. systemd stops
    reading at such a line, so the check never reads past it."""
    if b"\0" in data or b"\r" in data:
        raise Unparsable("NUL or CR byte")
    lines = data.split(b"\n")
    if lines[-1] == b"":
        lines.pop()
    out, section, cont, bom_seen = [], None, None, False

    def parse_line(n, ln, section):
        ln = ln.strip(WHITESPACE)
        if not ln:
            return section
        if not utf8_valid(ln):
            raise Unparsable("line %d: invalid UTF-8" % n)
        if ln[:1] == b"[":
            if ln[-1:] != b"]":
                raise Unparsable("line %d: invalid section header" % n)
            name = ln[1:-1]
            if any(0 < c < 0x20 or c in b"\"'\\\x7f" for c in name):
                raise Unparsable("line %d: bad characters in section header" % n)
            return name.decode()
        e = ln.find(b"=")
        if section is not None and e > 0:
            out.append((section, ln[:e].strip(WHITESPACE).decode(), ln[e + 1:].strip(WHITESPACE).decode()))
        return section

    for n, buf in enumerate(lines, 1):
        if len(buf) >= LONG_LINE_MAX:
            raise Unparsable("line %d is 1 MiB or longer" % n)
        if buf.lstrip(WHITESPACE)[:1] in (b"#", b";"):
            continue
        ln = buf
        if not bom_seen and buf.startswith(BOM):
            ln, bom_seen = buf[3:], True
        if cont is not None:
            if len(cont) + len(ln) > LONG_LINE_MAX:
                raise Unparsable("line %d: continued line too long" % n)
            p = cont + ln
        else:
            p = ln
        escaped = False
        for c in p:
            escaped = not escaped and c == 0x5c
        if escaped:
            cont = p[:-1] + b" "
            continue
        section, cont = parse_line(n, p, section), None
    if cont is not None:
        parse_line(len(lines) + 1, cont, section)
    return out


def ini_last(files, section, key):
    """The value systemd ends up with for SECTION.KEY across FILES in order: the last assignment
    wins, and an empty one resets it. None if never set."""
    val = None
    for f in files:
        try:
            lines = config_lines(f.content())
        except (OSError, Unparsable) as e:
            # A file systemd may read only in part, or not at all: never pass on it.
            return "unreadable %s (%s)" % (f.name, e.strerror if isinstance(e, OSError) else e)
        for s, k, v in lines:
            if (s, k) == (section, key):
                val = v or None
    return val


def main_conf(root, name):
    """systemd/NAME and its NAME.d drop-ins, as systemd 257.13's
    config_parse_standard_file_with_dropins reads them (config_parse_many_files): only the first
    NAME that opens (in /etc, then /usr/local/lib, then /usr/lib; a link to /dev/null counts) is
    read, and not at all when it is one of the drop-ins; then the drop-ins, in conf_files order."""
    dropins = conf_files(root, conf_paths("systemd/%s.d" % name))
    ids = set()
    for f in dropins:
        try:
            ids.add(f.identity())
        except OSError:
            pass
    for rel in conf_paths("systemd/" + name):
        main = Conf(str(root), rel)
        try:
            conf_chase(str(root), rel)
        except FileNotFoundError:
            continue  # nothing there (a dangling link raises LinkRefused, never this)
        except OSError:
            return [main] + dropins  # read_bytes refuses it
        try:
            if main.identity() in ids:
                break
        except OSError:
            pass
        return [main] + dropins
    return dropins


def sysctl_files(root):
    """The files systemd-sysctl 257.13 reads, in its order: conf_files over sysctl.d. It never reads
    /etc/sysctl.conf itself; older Debian's 99-sysctl.conf link to it is refused like any link (#1543)."""
    return conf_files(root, conf_paths("sysctl.d"))


def sysctl_normalize(k):
    """systemd 257.13's sysctl_normalize (src/basic/sysctl-util.c): if the key's first separator is a
    dot, dots and slashes swap; then path_simplify drops empty and "." components (and ".." right
    after a leading "/"), and the leading "/" goes. So "/net/ipv4/ip_forward/" and
    ".net.ipv4.ip_forward" are both net/ipv4/ip_forward."""
    seps = [i for i in (k.find("."), k.find("/")) if i >= 0]
    if seps and k[min(seps)] == ".":
        i = min(seps)
        k = k[:i] + k[i:].translate(str.maketrans("./", "/."))
    parts, absolute = [], k.startswith("/")
    for c in k.split("/"):
        if c in ("", ".") or (c == ".." and absolute and not parts):
            continue
        parts.append(c)
    return "/".join(parts)


def sysctl_all(root):
    """What systemd-sysctl 257.13 sets, key by key, as src/sysctl/sysctl.c reads it: lines end at LF, CR or
    NUL and lose leading and trailing space and tab; # and ; start comments; in an assignment a
    leading "-" only ignores errors; a "-key" line with no "=" unsets KEY (an earlier assignment to
    it is dropped); keys are normalised (sysctl_normalize) and the last assignment to a key wins.
    Keys keep any glob. A value of None means the key is unset."""
    vals = {}
    for f in sysctl_files(root):
        try:
            data = f.content()
        except OSError:
            continue  # sysctl_byte_violations refuses it
        for raw in re.split(rb"[\n\r\x00]", data):
            if len(raw) >= LONG_LINE_MAX:
                break  # read_line fails, and systemd-sysctl stops reading this file
            ln = raw.strip(b" \t\n\r").decode(errors="replace")
            if not ln or ln[0] in "#;":
                continue
            if "=" in ln:
                k, v = (ln[1:] if ln[0] == "-" else ln).split("=", 1)
                vals[sysctl_normalize(k.strip(" \t\n\r"))] = v.strip(" \t\n\r")
            elif ln[0] == "-":
                vals[sysctl_normalize(ln[1:].strip(" \t\n\r"))] = None
    return vals


def sysctl(root, key):
    """The value systemd-sysctl sets for KEY. None if never set."""
    return sysctl_all(root).get(sysctl_normalize(key))


def sysctl_byte_violations(root):
    """#1508: sysctl.d lines this check and systemd-sysctl could split differently, or that stop
    systemd-sysctl reading the file. They feed both the forwarding check and kernel.core_pattern
    (IMG-nodump)."""
    out = []
    for f in sysctl_files(root):
        try:
            data = f.content()
        except OSError as e:
            out.append("%s: unreadable (%s); the tree check never passes a file it cannot read" % (f.rel, e.strerror))
            continue
        for n, ln in enumerate(data.split(b"\n"), 1):
            if SYSCTL_BAD_BYTES.search(ln):
                out.append("%s: line %d: NUL, CR, control, BOM or Unicode line-break character" % (f.rel, n))
            if len(ln) >= LONG_LINE_MAX:
                out.append("%s: line %d is 1 MiB or longer; systemd-sysctl stops reading the file there" % (f.rel, n))
    return out


def dump_violations(root):
    """IMG-nodump: core dumps are discarded, for every process and for the card's service."""
    out = []
    storage = ini_last(main_conf(root, "coredump.conf"), "Coredump", "Storage")
    if storage != "none":
        out.append("50-agentos-nodump.conf: coredump Storage is %s; must be none" % storage)
    limit = ini_last(main_conf(root, "system.conf"), "Manager", "DefaultLimitCORE")
    if limit not in ("0", "0:0"):
        out.append("50-agentos-nodump.conf: DefaultLimitCORE is %s; must be 0" % limit)
    out += card_unit_violations(root)
    pattern = sysctl(root, "kernel.core_pattern")
    if pattern != CORE_PATTERN:
        out.append("%s: kernel.core_pattern is %s; must be %s" % (NODUMP_SYSCTL.rsplit("/", 1)[-1], pattern, CORE_PATTERN))
    suid = sysctl(root, "fs.suid_dumpable")
    if suid != "0":
        out.append("%s: fs.suid_dumpable is %s; must be 0" % (NODUMP_SYSCTL.rsplit("/", 1)[-1], suid))
    return out


def unit_dropin_names(name):
    """The names whose .d directories hold drop-ins for unit NAME (dropin.c's unit_file_find_dirs):
    NAME, then each "-" prefix of it, longest first (foo-bar-baz.service: foo-bar-.service,
    foo-.service). The units checked here are not templates."""
    prefix, typ = name.rsplit(".", 1)
    chopped = False
    while True:
        dash = prefix.rfind("-")
        if dash <= 0:
            return [name]
        if dash + 1 < len(prefix) or chopped:
            prefix = prefix[:dash + 1]
            break
        prefix, chopped = prefix[:dash], True
    return [name] + unit_dropin_names(prefix + "." + typ)


def card_unit_violations(root):
    """IMG-nodump: each secret-holding service's unit, with every drop-in systemd 257.13 applies to
    it, sets LimitCORE=0. The unit is the first UNIT_PATHS entry of its name; its drop-ins are
    conf_files over NAME.d and each prefix's .d in every unit directory, then service.d
    (unit_file_find_dropin_paths in src/shared/dropin.c). A link as the unit, or a link elsewhere
    that makes another name an alias of it (whose drop-ins then apply too), is refused rather than
    modelled."""
    out, root = [], str(root)
    dirs = []
    for d in UNIT_PATHS:
        try:
            path = conf_chase(root, d)
            st = None if path is None else tree_lstat(root, path)
        except StepRefused as e:
            out.append("%s: unreadable (%s); the tree check never passes a unit directory it cannot read" % (d, e.strerror))
            continue
        except OSError:
            continue
        if st is not None and stat.S_ISDIR(st.st_mode):
            dirs.append(path)
    for d in dirs:
        for n in sorted(tree_listdir(root, d)):
            if n in CARD_UNITS or not stat.S_ISLNK(tree_lstat(root, d + "/" + n).st_mode):
                continue
            try:
                target = tree_chase(root, d + "/" + n)[0].rsplit("/", 1)[-1]
            except OSError:
                continue
            if target in CARD_UNITS:
                out.append("%s/%s: an alias of %s; the tree check does not model unit aliases" % (d, n, target))
    for name in CARD_UNITS:
        unit = next((Conf(root, d + "/" + name) for d in dirs if tree_lstat(root, d + "/" + name)), None)
        if unit is None:
            out.append("%s: missing; a secret-holding service must set LimitCORE=0" % name)
            continue
        if unit.is_link():
            out.append("%s: a link; the tree check reads only a regular unit file" % unit.rel)
            continue
        files = [unit] + conf_files(root, ["%s/%s.d" % (d, n) for d in UNIT_PATHS for n in unit_dropin_names(name)]
                                    + ["%s/service.d" % d for d in UNIT_PATHS])
        limit = ini_last(files, "Service", "LimitCORE")
        if limit not in ("0", "0:0"):
            out.append("%s: LimitCORE is %s; must be 0" % (name, limit))
    return out


def stray_violations(root):
    """#1508: configuration the tree holds where the box never reads it from the image: /run (the
    box mounts a tmpfs over it) and a split-/usr /lib (systemd 257 reads only /usr/lib; trixie's /lib
    is a link to it). Checking such a file as if it were read would let it hide one that is."""
    out, root = [], str(root)
    places = [("run", n, "/run is a tmpfs on the box") for n in READ_CONF + ("modprobe.d",)]
    if not stat.S_ISLNK(entry_mode(root, "lib")):
        places += [("lib", n, "systemd 257 does not read a split-/usr /lib") for n in READ_CONF]
    for top, n, why in places:
        base = top + "/" + n
        try:
            st = tree_lstat(root, base)
        except OSError as e:
            out.append("%s: unreadable (%s); the tree check never passes a path it cannot read" % (base, e.strerror))
            continue
        if st is not None and not stat.S_ISDIR(st.st_mode):
            out.append("%s: %s; the image ships nothing there" % (base, why))
        for rel, st in tree_walk(root, base) if st is not None else ():
            if not stat.S_ISDIR(st.st_mode):
                out.append("%s: %s; the image ships nothing there" % (rel, why))
    return out


def swap_violations(root):
    """IMG-nodump: nothing in the tree turns on swap (the partition table and systemd.swap=0 are
    checked by finish_image.py). etc/fstab is read as configuration (Conf): a link other than a mask,
    dangling or not, is refused (#1543 Security delta 4 B1: systemd-fstab-generator would mount
    whatever a local user wrote at its target)."""
    out, root = [], str(root)
    try:
        for ln in Conf(root, "etc/fstab").text().splitlines():
            f = ln.split()
            if f and not f[0].startswith("#") and len(f) >= 3 and f[2] == "swap":
                out.append("etc/fstab: swap entry %s" % f[0])
    except FileNotFoundError:
        pass
    except OSError as e:
        out.append("etc/fstab: unreadable (%s); the tree check never passes a file it cannot read" % e.strerror)
    seen = set()
    for d in UNIT_DIRS + ("run/systemd/system",):
        path = tree_dir(root, d)
        if path is None or path in seen:
            continue
        seen.add(path)
        for rel, st in tree_walk(root, path):
            if rel.endswith(".swap"):
                out.append("%s: swap unit" % (d + rel[len(path):]))
    for d in ("usr/lib", "lib", "etc", "usr/local/lib"):
        for g in SWAP_GENERATORS:
            if entry_mode(root, d + "/systemd/system-generators/" + g):
                out.append("%s/systemd/system-generators/%s: makes zram swap" % (d, g))
    for n in ("swapfile", "swap.img", "var/swapfile", "var/swap"):
        if entry_mode(root, n):
            out.append("%s: swap file" % n)
    return out


def tree_chase(root, rel, hops=40, missing_ok=False, walked=None):
    """REL resolved as the booted image resolves it (systemd's chase with the image as root):
    symlinks are followed inside ROOT, an absolute target from ROOT and never from the build host,
    and '..' stops at ROOT. Returns (in-image path, lstat of it). A path that enters one of
    BOX_MOUNTS returns ("/" + that path, None) without looking at the tree. Raises
    FileNotFoundError if a step is missing (with MISSING_OK, returns (where the path would go, None):
    the rest taken as written, '..' and all), and OSError if links loop or a step is not a directory.
    WALKED, a list, gets each tree directory the chase steps into after following a link (#1803: who
    can write those decides where the links in them lead); a list that is not empty counts as a link
    already followed, so its every step is recorded."""
    parts, cur = [x for x in rel.split("/") if x], []
    linked = bool(walked)
    st = tree_lstat(root, "")
    while parts:
        name = parts.pop(0)
        if name in (".", ".."):
            if name == ".." and cur:
                cur.pop()
            continue
        if not cur and name in BOX_MOUNTS:
            return "/" + "/".join([name] + parts), None
        p = "/".join(cur + [name])
        st = tree_lstat(root, p)
        if st is None:
            if missing_ok:
                return "/".join(cur + [name] + parts), None
            raise FileNotFoundError(errno.ENOENT, "No such file or directory", p)
        if stat.S_ISLNK(st.st_mode):
            hops -= 1
            if hops < 0:
                raise OSError(errno.ELOOP, "too many levels of links", p)
            target = tree_readlink(root, p)
            if target.startswith("/"):
                cur = []
            parts = [x for x in target.split("/") if x] + parts
            linked = True
            continue
        if parts and not stat.S_ISDIR(st.st_mode):
            raise NotADirectoryError(errno.ENOTDIR, "not a directory", p)
        cur.append(name)
        if linked and walked is not None and parts and p not in walked:
            walked.append(p)
    return "/".join(cur), st


def tree_stat(root, rel):
    """lstat REL as the booted image sees it (tree_chase). None if any step is missing, loops, is
    not a directory, or is one the box mounts at boot."""
    try:
        return tree_chase(str(root), rel)[1]
    except OSError:
        return None


def radio_violations(root):
    """#1415: without these files the controller has no wlan0 and agentos-ap serves no setup network.
    Each must be a non-empty regular file in the tree (a link to one counts)."""
    out = []
    for rel in RADIO_FIRMWARE:
        found = (tree_stat(root, rel + sfx) for sfx in FIRMWARE_SUFFIXES)
        if not any(st and stat.S_ISREG(st.st_mode) and st.st_size > 0 for st in found):
            out.append("%s: missing or empty; the controller's radio needs firmware-mediatek" % rel)
    return out


def kmod_lines(data):
    """The lines kmod 34's freadline_wrapped (shared/util.c) reads from DATA. A backslash before a
    newline joins the next line, even in a comment; any other backslash is dropped and the byte
    after it kept (a backslash at the end of the file reads as byte 0xff, getc's EOF). kmod then
    reads each line as a C string, so it ends at its first NUL."""
    lines, buf, i = [], bytearray(), 0
    while i < len(data):
        c, i = data[i], i + 1
        if c == 0x0A:
            lines.append(bytes(buf))
            buf = bytearray()
        elif c != 0x5C:
            buf.append(c)
        elif i == len(data):
            buf.append(0xFF)
        elif data[i] == 0x0A:
            i += 1
        else:
            buf.append(data[i])
            i += 1
    if buf:
        lines.append(bytes(buf))
    return [ln.split(b"\0", 1)[0] for ln in lines]


def kmod_token(ln, pos):
    """strtok_r(.., "\t ") from POS: (the next word or None, where the next call starts)."""
    while pos < len(ln) and ln[pos] in b"\t ":
        pos += 1
    if pos >= len(ln):
        return None, pos
    end = pos
    while end < len(ln) and ln[end] not in b"\t ":
        end += 1
    return ln[pos:end], end + 1


def kmod_underscores(name):
    """kmod 34's underscores() (libkmod-config.c): every - outside [...] becomes _; None (kmod's
    syntax error) for an unmatched bracket."""
    out, i = bytearray(name), 0
    while i < len(out):
        if out[i] == 0x2D:
            out[i] = 0x5F
        elif out[i] == 0x5D:
            return None
        elif out[i] == 0x5B:
            i = out.find(b"]", i)
            if i < 0:
                return None
        i += 1
    return bytes(out)


def kmod_installs(data, kinds=(b"install",)):
    """(module pattern, command) of each install line kmod 34's kmod_config_parse takes from DATA,
    in order. Words split on space and tab only; a line whose first byte is # is a comment; the
    command is the rest of the line after the one byte that ends the pattern. KINDS widens it to
    remove lines, whose command has the same form."""
    out = []
    for ln in kmod_lines(data):
        if ln[:1] in (b"", b"#"):
            continue
        cmd, pos = kmod_token(ln, 0)
        if cmd not in kinds:
            continue
        name, pos = kmod_token(ln, pos)
        name = kmod_underscores(name) if name is not None else None
        if name is not None and pos < len(ln):
            out.append((name, ln[pos:]))
    return out


def bypass_reason(command):
    """Why an install or remove COMMAND could load a blocked module past its own install line, or
    None. Any line's command can: modprobe -i (--ignore-install) skips install lines, insmod never
    reads them, and a command naming the module loads it some other way. Matched as plain text,
    case-blind, with any short option cluster holding i counted as -i, which errs safe. A command
    that builds the name at run time (shell quoting, variables) is not seen; the after-boot check
    (I20) covers that."""
    text = command.decode(errors="replace").lower()
    for m in BLOCKED_MODULES:
        if m in text:
            return "something naming %s" % m
    for w in re.split(r"[^a-z0-9_./=-]+", text):
        opt = w.split("=", 1)[0]
        # getopt_long takes any unambiguous prefix: --ignore-i, but not --ignore- (or --ignore-remove).
        if len(opt) >= 10 and "--ignore-install".startswith(opt) or re.fullmatch(r"-[a-z0-9]*i[a-z0-9]*", w):
            return "modprobe %s" % w
        if w.rsplit("/", 1)[-1] == "insmod":
            return "insmod"
    return None


def bluetooth_violations(root):
    """#1415: firmware-mediatek also lets the MT7922's Bluetooth half come up. kmod uses the first
    install line whose pattern fnmatch()es the module, reading the files conf_files(kmod=True) lists
    as kmod_installs does (#1528); that line must refuse the load. glibc's fnmatch differs from
    Python's for [...] and \\, so a pattern holding either is refused rather than modelled."""
    first, out = {}, []
    for f in conf_files(root, MODPROBE_DIRS, kmod=True):
        try:
            data = f.content()
        except OSError as e:
            out.append("%s: unreadable (%s); the tree check never passes a file it cannot read" % (f.rel, e.strerror))
            continue
        for name, command in kmod_installs(data, (b"install", b"remove")):
            why = bypass_reason(command)
            if why:
                out.append("%s: install/remove %s runs %s; it could load Bluetooth past its install line (#1528)"
                           % (f.rel, name.decode(errors="backslashreplace"), why))
        for name, command in kmod_installs(data):
            if b"[" in name or b"\\" in name:
                out.append("%s: install %s: a pattern with [ or \\ is not modelled; name the module"
                           % (f.rel, name.decode(errors="backslashreplace")))
                continue
            for m in BLOCKED_MODULES:
                if fnmatch.fnmatchcase(m.encode(), name):
                    first.setdefault(m, command.strip(b"\t ").decode(errors="replace"))
    return out + ["modprobe.d: %s is not blocked (install %s %s); the image ships no Bluetooth"
                  % (m, m, REFUSE[0]) for m in BLOCKED_MODULES if first.get(m) not in REFUSE]


# tmpfiles.d as systemd-tmpfiles 257.13 lists it (conf_files, highest precedence first), with a
# split-/usr /lib as well, which stray_violations refuses anyway. /run/tmpfiles.d is read on the box
# too, but /run is a tmpfs there, so tmpfiles_allow_violations refuses anything the tree puts in it.
TMPFILES_DIRS = conf_paths("tmpfiles.d") + ("lib/tmpfiles.d",)
# #1543: every tmpfiles.d line the image ships must be on this allowlist, keyed by the file it is in.
# It is generated from the stock build (see the file's header for how), so a package update or an
# edit that adds or changes a line fails the build until someone reviews the line and adds it.
TMPFILES_ALLOW = "tmpfiles.allow"
# Where it is in the repository, and how to regenerate it, as each refusal says (#1543 P/UX U1).
TMPFILES_ALLOW_REPO = "image/mkosi/" + TMPFILES_ALLOW
TMPFILES_REGENERATE = "mkosi.finalize --tmpfiles-allowlist ROOT"
# The credential store directories systemd 257 reads (ImportCredential= in systemd-sysctl and
# systemd-tmpfiles takes sysctl.* and tmpfiles.* from them), with /usr/local/lib and a split-/usr /lib
# for safety. Nothing may ship in them unless named here (#1543 Security B3). The image needs the
# four mkosi writes from mkosi.conf's Locale=, Keymap=, Timezone= and RootPassword= (CI build of #1543
# at fc5981d): a credential's name is what PID 1 and ImportCredential= match on, so none of these
# can be read as sysctl.* or tmpfiles.*.
CREDSTORE_DIRS = tuple("%s/%s" % (top, n) for top in ("etc", "run", "usr/local/lib", "usr/lib", "lib")
                       for n in ("credstore", "credstore.encrypted"))
CREDSTORE_ALLOWED = ("usr/lib/credstore/firstboot.keymap", "usr/lib/credstore/firstboot.locale",
                     "usr/lib/credstore/firstboot.timezone", "usr/lib/credstore/passwd.hashed-password.root")
# What a tmpfiles.d line must not touch (#1530), as defence in depth behind the allowlist: /proc and
# /sys; every file and directory this check reads, in each directory systemd or kmod reads it from
# (/run included: the tree check cannot see what tmpfiles puts there at boot); the generator
# directories (zram, #1543 Security R1), the credential stores (B3), owner configuration, and the
# ESP mount points with their loader entries (B2: systemd-boot joins every options line).
# systemd-tmpfiles runs before systemd-sysctl, and the root file system is writable, so a line that
# writes, copies, links, removes or cleans any of these changes what the box runs without the build
# seeing it. This is a list of refused paths, so it cannot see what a chain of lines builds; the
# allowlist above is what holds the line set fixed.
TMPFILES_TARGETS = (("proc",), ("sys",), ("etc", "sysctl.conf"), ("etc", "fstab"), ("usr", "lib", "firmware"),
                    ("lib", "firmware"), ("etc", "agentos"), ("efi",), ("boot",)) + tuple(
    tuple(("%s/%s" % (top, n)).split("/")) for top in ("etc", "usr/local/lib", "usr/lib", "lib", "run")
    for n in READ_CONF + ("modprobe.d", "systemd/system-generators", "credstore", "credstore.encrypted"))
# Debian's own lines that touch one, as whole lines with runs of blanks collapsed: /var/run is
# /run, and /etc/mtab names the mount table, a file (debian.conf, var.conf); trixie's credstore.conf
# makes the empty stores (credstore_violations refuses anything in them); and four relative links
# whose ".." is the link's own parent (debian.conf, legacy.conf, systemd-resolve.conf; CI build of
# #1543 at 14cb555). Nothing else is exempt.
TMPFILES_STOCK = ("L /var/run - - - - ../run", "L+ /var/run - - - - ../run", "L /var/run - - - - /run",
                  "L+ /var/run - - - - /run", "L /etc/mtab - - - - ../proc/self/mounts",
                  "L+ /etc/mtab - - - - ../proc/self/mounts",
                  "d /etc/credstore 0700 root root", "d /etc/credstore.encrypted 0700 root root",
                  "z /run/credstore 0700 root root", "z /run/credstore.encrypted 0700 root root",
                  "L+ /etc/default/locale - - - - ../locale.conf", "L /var/lock - - - - ../run/lock",
                  "L$ /var/log/README - - - - ../../usr/share/doc/systemd/README.logs",
                  "L! /etc/resolv.conf - - - - ../run/systemd/resolve/stub-resolv.conf",
                  # Debian's legacy.conf alias of /dev/shm, which the box mounts 1777 itself, as var/lock
                  # is of /run/lock; the link rule (#1803) would refuse it as a link into /dev.
                  "L /run/shm - - - - /dev/shm")
# systemd-tmpfiles 257.13's path specifiers for the system manager (src/tmpfiles/tmpfiles.c); the
# others expand to names without a slash.
TMPFILES_SPECIFIERS = {"t": "/run", "S": "/var/lib", "C": "/var/cache", "L": "/var/log", "T": "/tmp",
                       "V": "/var/tmp", "h": "/root", "%": "%"}
C_ESCAPES = {"a": "\a", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v", "s": " "}


def tmpfiles_words(ln, n=6):
    """The first N words of LN as extract_first_word(EXTRACT_UNQUOTE|EXTRACT_CUNESCAPE) gives them,
    and the rest of the line (the argument). Quotes may start anywhere in a word; \\xHH, octal,
    \\u and C escapes are decoded and any other escaped character kept, which errs safe (systemd
    refuses the line)."""
    words, i = [], 0
    while len(words) < n:
        while i < len(ln) and ln[i] in " \t\n\r":
            i += 1
        if i >= len(ln):
            break
        w, quote = [], None
        while i < len(ln) and (quote or ln[i] not in " \t\n\r"):
            c = ln[i]
            i += 1
            if c == quote:
                quote = None
            elif quote is None and c in "'\"":
                quote = c
            elif c == "\\" and i < len(ln):
                m = re.match(r"x([0-9a-fA-F]{2})|([0-7]{3})|u([0-9a-fA-F]{4})|U([0-9a-fA-F]{8})", ln[i:])
                if m:
                    w.append(chr(int(m.group(1) or m.group(3) or m.group(4) or "0", 16) if not m.group(2)
                                 else int(m.group(2), 8)))
                    i += m.end()
                else:
                    w.append(C_ESCAPES.get(ln[i], ln[i]))
                    i += 1
            else:
                w.append(c)
        words.append("".join(w))
    return words, ln[i:].strip(" \t\n\r")


def tmpfiles_expand(p):
    """P with systemd-tmpfiles' specifiers expanded (TMPFILES_SPECIFIERS)."""
    return re.sub(r"%(.)", lambda m: TMPFILES_SPECIFIERS.get(m.group(1), m.group(0)), p)


def path_parts(p):
    """P's components as the kernel walks them without links: empty and "." drop, ".." pops."""
    out = []
    for c in p.split("/"):
        if c == "..":
            out = out[:-1]
        elif c not in ("", "."):
            out.append(c)
    return out


def glob_reaches(parts, target, ancestor=False):
    """Whether glob components PARTS can name TARGET or a path below it (or, with ANCESTOR, one
    above it too). A brace in the compared components counts (GLOB_BRACE can span a comma)."""
    k = min(len(parts), len(target))
    if len(parts) < len(target) and not ancestor:
        return False
    return all("{" in c or fnmatch.fnmatchcase(t, c) for c, t in zip(parts[:k], target[:k]))


def tree_resolve(root, parts):
    """PARTS resolved inside the image as far as the tree goes (tree_chase); the missing rest is kept
    as written. A path into what the box mounts keeps its mount's name. OSError (EXDEV) if a '..'
    follows a box mount or a missing step: the box, not the tree, decides where it goes (#1803)."""
    for k in range(len(parts), -1, -1):
        try:
            p, _ = tree_chase(root, "/".join(parts[:k]))
        except OSError:
            continue
        if ".." in p.split("/") + parts[k:]:
            raise OSError(errno.EXDEV, "a '..' past a directory the tree does not hold", "/".join(parts))
        return path_parts(p) + parts[k:]
    return parts


def tree_glob(root, parts):
    """Every path glob components PARTS name in the image, links followed inside it; a component
    under a box mount (or a missing directory) is kept as written."""
    found = [[]]
    for c in parts:
        if not re.search(r"[*?\[]", c):
            found = [f + [c] for f in found]
            continue
        nxt = []
        for f in found:
            try:
                p, st = tree_chase(root, "/".join(f))
            except OSError:
                continue
            if st is None:
                nxt.append(f + [c])
            elif stat.S_ISDIR(st.st_mode):
                nxt += [f + [n] for n in sorted(tree_listdir(root, p)) if fnmatch.fnmatchcase(n, c)]
        found = nxt
    return found


def tmpfiles_targets(root):
    """TMPFILES_TARGETS, and every path a link in one of them names in the image (a unit
    directory's links; a link in a directory the check reads files from is refused anyway, #1543)."""
    out = list(TMPFILES_TARGETS)
    for t in TMPFILES_TARGETS:
        base = tree_dir(root, "/".join(t))
        for rel, st in tree_walk(root, base) if base is not None else ():
            if stat.S_ISLNK(st.st_mode):
                to = tree_readlink(root, rel)
                try:
                    out.append(tuple(tree_resolve(root, path_parts(to if to.startswith("/") else rel.rpartition("/")[0] + "/" + to))))
                except OSError:
                    continue  # a '..' past a box mount: world_writable_link refuses the link itself
    return out


def tmpfiles_hits(root, parts, targets):
    """Whether tmpfiles.d path components PARTS can be one of TARGETS, or above or below one: as
    written (with systemd-tmpfiles' /var/run to /run rewrite), or through the image's links."""
    if parts[:2] == ["var", "run"]:
        parts = ["run"] + parts[2:]
    try:
        names = [parts] + [tree_resolve(root, g) for g in tree_glob(root, parts)]
    except OSError:
        return True  # #1803: where it goes is the box's to decide, so it may be one
    return any(glob_reaches(n, t, ancestor=True) for n in names for t in targets)


def tmpfiles_files(root):
    """conf_files over TMPFILES_DIRS, with every link among them refused, a mask too (#1543 Security
    B1): stock tmpfiles.d holds none, and a link there could replace a shipped file with one written
    on the box."""
    return [Conf(f.root, f.rel, "a link to %s; tmpfiles.d ships no links, not even a mask (#1543)"
                 % tree_readlink(f.root, f.rel)) if f.is_link() and not f.error else f
            for f in conf_files(str(root), TMPFILES_DIRS)]


def tmpfiles_violations(root):
    """#1530: systemd-tmpfiles runs before systemd-sysctl and kmod, and can write /proc/sys or create,
    copy, link or remove the configuration this check reads (TMPFILES_TARGETS). Every line of
    tmpfiles.d (conf_files, read as systemd-tmpfiles 257.13 reads lines: they end at LF, CR or NUL,
    # starts a comment) whose path, specifiers expanded and links in the image followed, is one of
    those, above one or below one is refused, whatever its type; so is a link (L) whose target and a
    copy (C) whose source is, taken both as systemd takes it (the rest of the line, as written) and
    unquoted. A path with a ".." component is refused (systemd refuses it too), and so is a link
    target or copy source with one (#1543 Security B1: path_parts pops ".." before links resolve, so
    "/var/run/../etc" would read as /etc while the box takes /run/../etc). Only Debian's own lines
    (TMPFILES_STOCK) are exempt, matched whole."""
    return [msg for rel, n, msg in tmpfiles_refusals(root)]


def tmpfiles_refusals(root):
    """tmpfiles_violations as (file, line number or None, refusal), so that the allowlist check can
    tell which lines this one refuses (#1543 P/UX U4-1)."""
    out, root = [], str(root)
    targets = tmpfiles_targets(root)
    for f in tmpfiles_files(root):
        try:
            data = f.content()
        except OSError as e:
            out.append((f.rel, None, "%s: unreadable (%s); the tree check never passes a file it cannot read"
                        % (f.rel, e.strerror)))
            continue
        for n, raw in enumerate(re.split(rb"[\n\r\x00]", data), 1):
            ln = os.fsdecode(raw).strip(" \t")
            if not ln or ln.startswith("#") or re.sub(r"[ \t]+", " ", ln) in TMPFILES_STOCK:
                continue
            (typ, path, *_), arg = tmpfiles_words(ln) if len(tmpfiles_words(ln)[0]) >= 2 else ([ln, ""], "")
            path = tmpfiles_expand(path)
            names, sources = [path], []
            if typ[:1] in ("L", "C"):
                words = tmpfiles_words(arg, 1)[0]
                for a in {arg, words[0] if words else arg}:
                    a = tmpfiles_expand(a)
                    sources.append(a)
                    if a in ("", "-"):
                        a = "/usr/share/factory/" + path
                    names.append(a if a.startswith("/") else path.rsplit("/", 1)[0] + "/" + a)
            if ".." in path.split("/"):
                why = "a path with a '..' component (#1530)"
            elif any(".." in a.split("/") for a in sources):
                why = "a link target or copy source with a '..' component (#1543)"
            elif any(tmpfiles_hits(root, path_parts(p), targets) for p in names):
                why = "it reaches /proc, /sys or configuration the tree check reads (#1530)"
            elif typ[:1] == "L" and any(tmpfiles_link_refusal(root, path, p) for p in names[1:]):
                why = next(tmpfiles_link_refusal(root, path, p) for p in names[1:] if tmpfiles_link_refusal(root, path, p))
            else:
                continue
            out.append((f.rel, n, "%s: line %d: %s; %s" % (f.rel, n, ln[:120], why)))
    return out


def tmpfiles_link_refusal(root, path, to):
    """#1803: link_refusal for the link a tmpfiles.d L line makes at PATH to TO (its target, made
    absolute against the link's directory): a link the box makes is held to the tree's link rules.
    A target the tree check cannot follow is refused."""
    rel = "/".join(path_parts(path))
    if rel.split("/")[:2] == ["var", "run"]:
        rel = "/".join(["run"] + rel.split("/")[2:])
    walked = [""]
    try:
        chased = tree_chase(root, to, missing_ok=True, walked=walked)[0]
    except OSError as e:
        return "a link to %s, which the tree check cannot follow (%s) (#1803)" % (to, e.strerror)
    return link_refusal(root, rel, to, chased, made=True, walked=walked[1:])


def tmpfiles_makers(root):
    """#1803, #1829: (file, line number, (paths, what, compose)) for each tmpfiles.d line that makes a
    path a link or a copy (C, whatever its source: the tree check never chases what the copy holds),
    or makes it, or may make it, for a user other than root to write: PATHS are the glob components it
    may name (as written, with the /var/run rewrite, and through the image's links), WHAT says how.
    COMPOSE is None, or (recursive,) for a line whose mode gives group write and that names no group
    but root: it counts only where the step's group, from the tree or a parent, is not root."""
    out = []
    for rel, n, ln in tmpfiles_entries(root):
        words, arg = tmpfiles_words(ln) if n is not None else ([], "")
        if len(words) < 2:
            continue
        typ, _, mode, user, group = (words + ["-"] * 5)[:5]
        m, compose = mode.lstrip(":~"), None
        if typ[:1] == "L":
            what = "a link"
        elif typ[:1] == "C":
            what = "a copy of %s" % (arg.strip() if arg.strip() not in ("", "-") else "its factory default")
        elif typ[:1] in ("a", "A"):
            what = "with a POSIX ACL"
        elif m != "-" and not re.fullmatch(r"[0-7]{1,4}", m):
            what = "with a mode it cannot parse (%s)" % mode
        elif user.lstrip(":") not in ("-", "", "root", "0") or group.lstrip(":") not in ("-", "", "root", "0") \
                or m != "-" and int(m, 8) & 0o002:
            # #1829 (combined delta 2): a non-root group counts whatever the mode, since the step's
            # mode, another line or a setgid bit may give that group write.
            what = "mode %s for %s:%s" % (mode, user, group)
        elif m != "-" and int(m, 8) & 0o020:
            # #1829: group write for the step's own group, which the tree or a parent gives it; the
            # check never trusts a line to replace that group (systemd skips duplicate lines, and Z
            # stops at a link), so tmpfiles_maker weighs it with the tree's gid.
            compose = (typ[:1] == "Z",)
            what = "mode %s for %s:%s" % (mode, user, group)
        else:
            continue
        parts = path_parts(tmpfiles_expand(words[1]))
        if parts[:2] == ["var", "run"]:
            parts = ["run"] + parts[2:]
        paths = [parts]
        try:
            # #1829: an L line makes its last component the link, so only the steps before it are
            # resolved; it does not remake where a link the tree already holds there leads.
            paths.append(tree_resolve(root, parts[:-1]) + parts[-1:] if typ[:1] == "L"
                         else tree_resolve(root, parts))
        except OSError:
            pass
        out.append((rel, n, (paths, what, compose)))
    return out


def tmpfiles_lines(data):
    """(line number, line) of each line systemd-tmpfiles 257.13 acts on in DATA: lines end at LF, CR
    or NUL, lose leading and trailing space and tab, and a blank line or one starting with # is
    skipped. The line is otherwise exactly as written: the allowlist compares it whole."""
    for n, raw in enumerate(re.split(rb"[\n\r\x00]", data), 1):
        ln = os.fsdecode(raw).strip(" \t")
        if ln and not ln.startswith("#"):
            yield n, ln


def tmpfiles_allow_path():
    """Where tmpfiles.allow is: beside this script, or under $SRCDIR when mkosi runs it (mkosi v24.3
    mounts the script alone at /work/finalize and the configuration directory at /work/src)."""
    for d in (os.path.dirname(os.path.abspath(__file__)), os.environ.get("SRCDIR")):
        if d and os.path.isfile(os.path.join(d, TMPFILES_ALLOW)):
            return os.path.join(d, TMPFILES_ALLOW)
    return None


def tmpfiles_allowed(path=None):
    """The allowlist as a set of (file, line): each entry line of tmpfiles.allow is the file's path
    in the tree, a tab, and the line exactly as tmpfiles_lines gives it. None if the file is missing."""
    path = path or tmpfiles_allow_path()
    if path is None:
        return None
    out = set()
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        for ln in f.read().split("\n"):
            if ln.strip() and not ln.startswith("#"):
                rel, _, line = ln.partition("\t")
                out.add((rel, line.strip(" \t")))
    return out


def tmpfiles_entries(root):
    """(file, line number, line) of every tmpfiles.d line the box would act on, in conf_files order
    over TMPFILES_DIRS (a name in a higher directory replaces the same name lower down), or
    (file, None, error) for a file that cannot be read."""
    for f in tmpfiles_files(root):
        try:
            data = f.content()
        except OSError as e:
            yield f.rel, None, e.strerror
            continue
        for n, ln in tmpfiles_lines(data):
            yield f.rel, n, ln


def tmpfiles_allow_violations(root, allowed=None):
    """#1543: every tmpfiles.d line in the tree is on the allowlist (tmpfiles.allow), exactly and
    under its own file. Anything under /run/tmpfiles.d is refused outright: /run is a tmpfs on the
    box. Each refusal of a line the guarded-path check passes ends in the entry that would allow it,
    for review; a line that check refuses is offered no entry, since it must not be listed (#1543 P/UX
    U4-1)."""
    allowed = tmpfiles_allowed() if allowed is None else allowed
    if allowed is None:
        return ["%s: missing; every tmpfiles.d line must be on it (#1543)" % TMPFILES_ALLOW]
    out = []
    try:
        present = tree_lstat(root, "run/tmpfiles.d") is not None
    except OSError:
        present = True
    if present:
        out.append("run/tmpfiles.d: not on the tmpfiles.d allowlist; /run is a tmpfs on the box (#1543)")
    guarded = {(rel, n) for rel, n, _ in tmpfiles_refusals(root)}
    for rel, n, ln in tmpfiles_entries(root):
        if n is None:
            out.append("%s: unreadable (%s); the tree check never passes a file it cannot read" % (rel, ln))
        elif (rel, ln) in allowed:
            continue
        elif (rel, n) in guarded:
            out.append("%s line %d: %s: not on the tmpfiles.d allowlist (%s, #1543), and the guarded-path check "
                       "refuses it too: remove the line; it must not be added" % (rel, n, ln[:120], TMPFILES_ALLOW_REPO))
        else:
            out.append("%s line %d: not on the tmpfiles.d allowlist (%s, #1543); review this line, then add the entry "
                       "after 'entry:' to that file (each line is reviewed on its own: %s only lists what a tree "
                       "holds, it reviews nothing); entry: %s\t%s"
                       % (rel, n, TMPFILES_ALLOW_REPO, TMPFILES_REGENERATE, rel, ln))
    return out


def tmpfiles_allowlist_text(root):
    """tmpfiles.allow for the tree at ROOT: its header, then one entry per line the tree holds."""
    return TMPFILES_ALLOW_HEADER + "".join("%s\t%s\n" % (rel, ln) for rel, n, ln in tmpfiles_entries(root)
                                           if n is not None)


TMPFILES_ALLOW_HEADER = """\
# Every tmpfiles.d line the image may ship (#1530, #1543), one per line: the file's path in the image
# tree, a tab, and the line exactly as systemd-tmpfiles reads it (leading and trailing blanks
# dropped; blank lines and comments are not listed). mkosi.finalize fails the build on any line not
# here, wherever it is; the guarded-path check in mkosi.finalize runs as well.
# To regenerate after a reviewed package update or an edit to mkosi.extra's tmpfiles.d: the failed
# build prints each new line as "entry: <file><TAB><line>" (the image workflow also shows them as an
# annotation); check each one, then add it here. With the image tree at hand:
#   python3 image/mkosi/mkosi.finalize --tmpfiles-allowlist ROOT > image/mkosi/tmpfiles.allow
"""


def credstore_violations(root):
    """#1543 Security B3: systemd-sysctl and systemd-tmpfiles import sysctl.* and tmpfiles.*
    credentials from the credential store, so nothing ships there but what CREDSTORE_ALLOWED names.
    A store that is a link or a file is refused too. A store reached through a linked parent (trixie's
    /lib is /usr/lib) is walked once, under the path it resolves to."""
    out, root, seen = [], str(root), set()
    for d in CREDSTORE_DIRS:
        try:
            path, st = tree_entry(root, d)
        except OSError as e:
            out.append("%s: unresolvable (%s); the tree check never passes a store it cannot read" % (d, e.strerror))
            continue
        if st is None:
            continue
        if not stat.S_ISDIR(st.st_mode):
            out.append("%s: a link or file where the credential store is; nothing ships there" % d)
            continue
        if path in seen:
            continue
        seen.add(path)
        for rel, st in tree_walk(root, path):
            if not stat.S_ISDIR(st.st_mode) and rel not in CREDSTORE_ALLOWED:
                out.append("%s: in a credential store; it could carry sysctl.extra or tmpfiles.extra" % rel)
    return out


def byte_violations(f):
    """#1496: lines this check and systemd could split or join differently. systemd continues a
    line ending in a backslash (unless escaped) and ends one at NUL or CR; Python's splitlines also
    splits at \\x0b, \\x0c, \\x1c-\\x1e and U+0085. The files the image ships are plain ASCII, so
    anything else is refused rather than modelled, and so is a line of LONG_LINE_MAX bytes or more,
    where config_parse stops reading."""
    out = []
    try:
        data = f.content()
    except OSError as e:
        return ["%s: unreadable (%s); the tree check never passes a file it cannot read" % (f.rel, e.strerror)]
    for n, ln in enumerate(data.split(b"\n"), 1):
        if len(ln) >= LONG_LINE_MAX:
            out.append("%s: line %d is 1 MiB or longer; systemd stops reading the file there" % (f.name, n))
        if any(b < 0x20 or b > 0x7e for b in ln):
            out.append("%s: line %d: control, NUL, BOM or non-ASCII byte" % (f.name, n))
        if ln.rstrip(b" ").endswith(b"\\"):
            out.append("%s: line %d ends in a backslash (a continued line)" % (f.name, n))
    return out


def uplink_violations(up):
    """#1496: the uplink holds exactly UPLINK_KEYS, each assigned once. Every other line is blank,
    a comment or a section header; byte_violations refuses what would make systemd read the lines
    differently from this split."""
    out, seen, section = byte_violations(up), {}, None
    try:
        text = up.text()
    except OSError:
        return out
    for n, ln in enumerate(text.split("\n"), 1):
        ln = ln.strip()
        if not ln or ln[0] in "#;":
            continue
        if ln.startswith("[") and ln.endswith("]"):
            section = ln[1:-1]
        elif section is not None and "=" in ln:
            k, v = ln.split("=", 1)
            seen.setdefault((section, k.strip()), []).append(v.strip())
        else:
            out.append("%s: line %d: neither a section nor an assignment in one" % (UPLINK, n))
    for (s, k), vals in sorted(seen.items()):
        if (s, k) not in UPLINK_KEYS:
            out.append("%s: [%s] %s is %s; not a key the image ships" % (UPLINK, s, k, vals[-1]))
        elif len(vals) > 1:
            out.append("%s: [%s] %s is set %d times; must be set once" % (UPLINK, s, k, len(vals)))
    for (s, k), want in sorted(UPLINK_KEYS.items()):
        v = seen.get((s, k), [None])[0]
        if v != want:
            out.append("%s: [%s] %s is %s; must be %s" % (UPLINK, s, k, v, want))
    return out


def forward_key(k):
    """#1478, #1497, #1508: whether sysctl key K (normalised by sysctl_normalize, globs kept) can set
    a forwarding key. A ".." component never writes (systemd refuses the path) but counts anyway:
    refusing it errs safe."""
    if GLOB.search(k) and GLOB_ESCAPE.search(k):
        return True
    parts = k.split("/")
    first, last = parts[0], parts[-1]
    return ((first == "net" or bool(GLOB.search(first)) or ".." in parts)
            and (last in FORWARD_LEAVES or bool(GLOB.search(last))))


def network_violations(root):
    """#1478: the effective .network set is the uplink alone, nothing changes it, and neither it nor
    networkd.conf turns on forwarding or LAN name answering; #1479: the uplink keeps the box private.
    The set is conf_files over systemd/network, as networkd's network_load lists it; network_load_one
    skips a file that reads as nothing (an empty file, a mask), and applies conf_files over NAME.d to
    the rest. A file the check cannot read (any other link, #1543) is refused and counts as live."""
    out, live = [], {}
    for f in conf_files(root, conf_paths("systemd/network"), ".network"):
        try:
            if f.content() == b"":
                continue
        except OSError as e:
            out.append("%s: unreadable (%s); the tree check never passes a file it cannot read" % (f.rel, e.strerror))
        live[f.name] = f
    for n in sorted(set(live) - {UPLINK}):
        out.append("%s: live .network file; only %s may run (mask or remove it)" % (live[n].rel, UPLINK))
    up = live.get(UPLINK)
    if up is None:
        out.append("%s: missing or masked; the wired uplink needs it" % UPLINK)
    elif up.is_link():
        out.append("%s: a link; the tree check reads only a regular file" % up.rel)
    else:
        out += uplink_violations(up)
    for n in sorted(live):
        for f in conf_files(root, conf_paths("systemd/network/%s.d" % n)):
            try:
                if f.content() == b"":
                    continue
            except OSError as e:
                out.append("%s: unreadable (%s); the tree check never passes a file it cannot read" % (f.rel, e.strerror))
            out.append("%s: networkd drop-in; the image's .network files are not changed" % f.rel)
    conf = main_conf(root, "networkd.conf")
    for f in conf:
        out += byte_violations(f)
    for key in ("IPv4Forwarding", "IPv6Forwarding"):
        v = ini_last(conf, "Network", key)
        if v not in (None, "no"):
            out.append("networkd.conf: %s is %s; must be unset or no" % (key, v))
    for k, v in sorted(sysctl_all(root).items()):
        if v is not None and v != "0" and forward_key(k):
            out.append("sysctl.d: %s is %s; forwarding must stay 0" % (k, v))
    return out


def resolved_violations(root):
    """#1479: resolved neither answers nor sends LLMNR or multicast DNS on the LAN."""
    conf = main_conf(root, "resolved.conf")
    return [m for f in conf for m in byte_violations(f)] + [
        "50-agentos-uplink.conf: resolved %s is %s; must be no" % (key, v)
        for key in ("LLMNR", "MulticastDNS") for v in [ini_last(conf, "Resolve", key)] if v != "no"]


def has_key(root, rel):
    """Whether regular file REL holds a private key marker (the content scan: any file, not only
    configuration, so it reads through tree_read without the owner rule)."""
    try:
        data = tree_read(root, rel, SCAN_MAX)
    except OSError:
        return False
    return any(m in data for m in KEY_MARKERS)


def main():
    if sys.argv[1:2] == ["--tmpfiles-allowlist"] and len(sys.argv) == 3:
        sys.stdout.write(tmpfiles_allowlist_text(sys.argv[2]))
        return
    root = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("BUILDROOT")
    if not root:
        sys.exit("usage: mkosi.finalize ROOT (or BUILDROOT=...)")
    v = violations(root)
    for line in v:
        print("image check: " + line)
    if v:
        sys.exit("image check: %d problem(s) in the image tree, each named above; a tmpfiles.d line missing from %s "
                 "that the guarded-path check passes ends in the entry to review and add there"
                 % (len(v), TMPFILES_ALLOW_REPO))
    print("image check: clean")


if __name__ == "__main__":
    main()
