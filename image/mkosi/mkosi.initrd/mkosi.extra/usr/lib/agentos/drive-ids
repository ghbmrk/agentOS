#!/bin/bash
# AgentOS drive IDs, run in the initrd before root is mounted (agentos-drive-ids.service).
#
# Every drive is flashed from the same reproducible image, so it starts with the same disk GUID,
# partition and file-system IDs (mkosi.conf Seed=). The initrd finds root through the ESP the
# loader booted from (LoaderDevicePartUUID), so a second drive with the same IDs (a second
# AgentOS drive, or a stick flashed from the public image) could hand it another drive's root.
# /usr is never chosen by ID: the entry's usrhash= names it, and dm-verity refuses any other content.
#
# 1. Refuse (one fixed console line, then the unit powers the box off) unless: the ESP the loader
#    booted from is the only partition with its ID; the root found for mounting is on that ESP's
#    disk; and no other disk carries this disk's GUID or the ID of one of its writable partitions.
#    Nothing is written on refusal, to any disk. Details go to the journal only.
# 2. Only then, and only on that disk: if its GUID is still the one Seed= gives every drive
#    (SEED_DISK; finish_image.py checks the built image against it), give it IDs of its own: both
#    GPT headers in place at the end of the drive, every partition except the active /usr release
#    (labelled agentos_*, IDs from its root hash), the root ext4 UUID and the ESP's volume ID, and
#    the disk GUID last. A run cut short leaves the seed's disk GUID, so the next boot does it all
#    again. The loader still reports the old ESP ID for this boot, so the box restarts once, at
#    once (--force: no unit is stopped, so nothing queued around this unit can hold it up).
#
# AGENTOS_DRIVE_ROOT and AGENTOS_DRIVE_HOLD exist for tests/test_image.py.
set -u
R=${AGENTOS_DRIVE_ROOT:-}
SEED_DISK=8d64dfb8-8434-4cb8-b3f4-306fe9a935dd
REFUSED="agentos-drive: FAIL another drive carries this drive's IDs; unplug it and start again"

say() { echo "agentos-drive: $*"; }
# Refusal: the fixed line on the console, the reason in the journal (stderr), then power off at
# once. Not by FailureAction= alone: when this unit fails, sysroot.mount's dependency fails first
# and the initrd queues emergency.target irreversibly, so a poweroff job would be refused (CI boot 1).
refuse() { echo "$1" >&2; echo "$REFUSED"; systemctl --force poweroff; exit 1; }
fail() { say "FAIL $*"; exit 1; }
lower() { tr 'A-F' 'a-f'; }
newuuid() { cat /proc/sys/kernel/random/uuid; }

var=$R/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
[ -r "$var" ] || refuse "the boot loader did not say which partition it booted from"
esp=$(tail -c +5 "$var" | tr -d '\000' | lower)
[ -n "$esp" ] || refuse "the boot loader's partition ID is empty"

udevadm settle --timeout=60 >/dev/null 2>&1 || true

# One line per block device: device, type, parent disk, ID (GPT GUID for disks, PARTUUID for
# partitions), partition label.
all=$(lsblk -rnpo NAME,TYPE,PKNAME,PTUUID,PARTUUID,PARTLABEL |
	awk '$2 == "disk" { print $1, "disk", "-", tolower($3) } $2 == "part" { print $1, "part", $3, tolower($5), $6 }')
parts=$(printf '%s\n' "$all" | awk '$2 == "part" { print $1, $3, $4, $5 }')

espdevs=$(printf '%s\n' "$parts" | awk -v u="$esp" '$3 == u { print $1 }')
n=$(printf '%s\n' "$espdevs" | grep -c .)
[ "$n" -ge 1 ] || refuse "no partition carries the ID the boot loader booted from ($esp)"
[ "$n" -eq 1 ] || refuse "$n partitions carry the boot ESP's ID $esp"
espdev=$espdevs
disk=$(printf '%s\n' "$parts" | awk -v d="$espdev" '$1 == d { print $2 }')

what=$(systemctl show -P What sysroot.mount 2>/dev/null)
rootdev=$(readlink -f "$what" 2>/dev/null)
[ -n "$what" ] && [ -n "$rootdev" ] || refuse "no root device to check"
rootdisk=$(printf '%s\n' "$parts" | awk -v d="$rootdev" '$1 == d { print $2 }')
[ "$rootdisk" = "$disk" ] || refuse "root ($rootdev) is not on the drive the loader booted from ($disk)"

# This disk's GUID and writable partitions (everything but the active /usr release) must be its own.
guid=$(printf '%s\n' "$all" | awk -v d="$disk" '$1 == d && $2 == "disk" { print $4 }')
own=$(printf '%s\n' "$parts" | awk -v d="$disk" '$2 == d && $4 !~ /^agentos_/')
others=$(printf '%s\n' "$all" | awk -v d="$disk" '$1 != d && $3 != d { print $4 }')
for u in $guid $(printf '%s\n' "$own" | awk '{ print $3 }'); do
	printf '%s\n' "$others" | grep -qxF "$u" && refuse "another disk carries ID $u of $disk"
done

if [ "$guid" != "$SEED_DISK" ]; then
	say "ok disk=$disk"
	exit 0
fi

say "fresh drive: giving $disk its own IDs"
num() { cat "$R/sys/class/block/${1##*/}/partition"; }
sf() { sfdisk -q --no-reread --no-tell-kernel "$@"; }
sf --relocate gpt-bak-std "$disk" || fail "could not place the backup GPT header at the end of the drive"
for p in $(printf '%s\n' "$own" | awk '{ print $1 }'); do
	sf --part-uuid "$disk" "$(num "$p")" "$(newuuid)" || fail "could not set the ID of $p"
done
e2fsck -fp "$rootdev" >/dev/null; [ $? -lt 4 ] || fail "root file system check failed"
tune2fs -U random "$rootdev" >/dev/null || fail "could not set the root file system's ID"
fatlabel -i "$espdev" "$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')" >/dev/null || fail "could not set the ESP's volume ID"
sf --disk-id "$disk" "$(newuuid)" || fail "could not set the disk ID"
sync
say "done; restarting once"
systemctl --force reboot
exec sleep "${AGENTOS_DRIVE_HOLD:-infinity}"
