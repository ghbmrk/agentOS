# The in-image end-to-end run's first half (#1688), passed like agentos-e2e.service as an SMBIOS
# credential on the e2e boot only. It seals a fresh claim code where a preloaded box keeps it before
# any agentOS service starts, as the seller does before the box ships, so the box boots as a
# preloaded one. The code goes to root's tmpfs for agentos-e2e.service, never to the console.
[Unit]
Description=agentOS end-to-end run: seal the claim code (CI only)
After=systemd-tmpfiles-setup.service
Before=agentosd.service agentos-egress.service agentos-localui.service

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
UMask=0077
ExecStart=/bin/mkdir -p /run/agentos-e2e/share
ExecStart=/bin/mount -t 9p -o trans=virtio,version=9p2000.L,ro e2e /run/agentos-e2e/share
ExecStart=/run/agentos-e2e/share/box-e2e seal
