#!/usr/bin/env python3
"""Refuse an enforcer tree that could turn Wi-Fi on or mount USB storage (NET-2 Hardening), that
enables a unit outside the enforcer's preset (only the services it needs), or that would write a core
dump to a file (#4459), or that leaves the kernel's reverse-path filter on anywhere (#4810). mkosi runs this with the tree in $BUILDROOT; each refusal is a line of the
build log. The running box checks the same
(agentos-enforcer/health); this catches it before an image exists."""
import fnmatch
import os
import pathlib
import re
import sys

# Packages that bring a Wi-Fi client, access point, regulatory database or radio firmware.
WIFI_PACKAGES = re.compile(r"(wpasupplicant|hostapd|iw|iwd|wireless-regdb|wireless-tools|network-manager|firmware-.*)")
# modprobe.d must carry these exact lines: the modules then never load, whatever asks.
BLOCKS = ("install cfg80211 /bin/false", "install mac80211 /bin/false",
          "install usb-storage /bin/false", "install uas /bin/false")
# Units the preset enables (usr/lib/systemd/system-preset/50-enforcer.preset), and the .wants links
# systemd and udev ship statically. Anything else in a .wants or .requires directory is refused.
WANTS_DIRS = ("etc/systemd/system",)
# #4459: a crash is never written to a file. The kernel's default core_pattern is the relative
# "core", which writes into the crashed process's working directory: a radio stack's run directory,
# which its adapter sees. These are what usr/lib/sysctl.d/99-enforcer-nodump.conf sets.
NODUMP = {"kernel/core_pattern": "|/usr/bin/false", "fs/suid_dumpable": "0"}
# #4810: the reverse-path filter is off on every interface (usr/lib/sysctl.d/99-enforcer-rpfilter.conf),
# since the ruleset's rpf chain replaces it and, on, it drops the WAN's DHCP answers. These three must
# be 0, and so must every other key that names or globs an interface's rp_filter (rp_filter_key).
RPF = ("net/ipv4/conf/all/rp_filter", "net/ipv4/conf/default/rp_filter", "net/ipv4/conf/*/rp_filter")
# Where systemd-sysctl reads sysctl.d, highest first: a name in a higher directory replaces the same
# name lower down, and the files are read in name order.
SYSCTL_DIRS = ("etc/sysctl.d", "run/sysctl.d", "usr/local/lib/sysctl.d", "usr/lib/sysctl.d", "lib/sysctl.d")


def installed(root):
    st = (root / "var/lib/dpkg/status").read_text()
    return [m.group(1) for m in re.finditer(r"^Package: (\S+)\n(?:.+\n)*?Status: install ok installed$", st, re.M)]


def preset_enabled(root):
    out = set()
    for ln in (root / "usr/lib/systemd/system-preset/50-enforcer.preset").read_text().splitlines():
        w = ln.split()
        if len(w) >= 2 and w[0] == "enable":
            out.add(w[1])
    return out


def inert(root, f):
    """True when f, inside root, holds only blank lines and comments."""
    try:
        real = f.resolve(strict=True)
        real.relative_to(root.resolve())
        text = real.read_text()
    except (OSError, ValueError):
        return False
    return all(not ln.strip() or ln.lstrip().startswith(("#", ";")) for ln in text.splitlines())


def sysctl_key(k):
    """systemd's sysctl_normalize: if the first separator is a dot, dots and slashes swap; empty and
    "." components drop out. So "kernel.core_pattern" and "/kernel//core_pattern" are one key."""
    seps = [i for i in (k.find("."), k.find("/")) if i >= 0]
    if seps and k[min(seps)] == ".":
        k = k[:min(seps)] + k[min(seps):].translate(str.maketrans("./", "/."))
    return "/".join(c for c in k.split("/") if c not in ("", "."))


def globmatch(name, pattern):
    """glob(3)'s match of one name: as fnmatch, but "[^" negates a class as "[!" does."""
    return fnmatch.fnmatchcase(name, pattern.replace("[^", "[!"))


def rp_filter_key(key):
    """True when key (sysctl_key form) names or globs some interface's rp_filter. systemd globs
    /proc/sys one component at a time, and any fourth component matches some interface's name."""
    c = key.split("/")
    return len(c) == 5 and all(globmatch(w, p) for p, w in zip(c[:3] + c[4:], ("net", "ipv4", "conf", "rp_filter")))


def sysctls(root):
    """What systemd-sysctl sets, key by key (sysctl_key), and the refusals: a link anywhere in
    sysctl.d, which the box could resolve differently from this check. Lines end at LF, CR or NUL,
    "#" and ";" start comments, a leading "-" only ignores errors, and the last assignment wins. A
    glob key that matches a NODUMP key counts as setting it."""
    files, out = {}, []
    for d in SYSCTL_DIRS:
        p = root / d
        if p.is_symlink():
            out.append("%s is a link" % d)
            continue
        if not p.is_dir():
            continue
        for f in p.iterdir():
            if f.is_symlink():
                out.append("%s/%s is a link" % (d, f.name))
            elif f.name.endswith(".conf") and not f.name.startswith("."):
                files.setdefault(f.name, f)
    vals = {}
    for name in sorted(files, key=os.fsencode):
        for raw in re.split(rb"[\n\r\x00]", files[name].read_bytes()):
            ln = raw.strip(b" \t").decode(errors="replace")
            if not ln or ln[0] in "#;":
                continue
            k, eq, v = ln.lstrip("-").partition("=")
            key = sysctl_key(k.strip(" \t"))
            for n in NODUMP:
                if n != key and globmatch(n, key):
                    vals[n] = "a glob, %s" % key
            vals[key] = v.strip(" \t") if eq else None
    return vals, out


def violations(root):
    root = pathlib.Path(root)
    out = ["package %s could turn Wi-Fi on" % p for p in installed(root) if WIFI_PACKAGES.fullmatch(p)]
    lines = set()
    for f in sorted((root / "usr/lib/modprobe.d").glob("*.conf")):
        lines |= {ln.strip() for ln in f.read_text().splitlines()}
    out += ["modprobe.d lacks '%s'" % b for b in BLOCKS if b not in lines]
    # No other module configuration. Debian ships etc/modules-load.d/modules.conf as a link to a
    # comment-only etc/modules, so a file counts only by its lines that are not blank or comments;
    # a link that leaves the tree or dangles is refused.
    for d in (root / "etc/modprobe.d", root / "etc/modules-load.d", root / "usr/lib/modules-load.d"):
        if d.is_dir():
            out += ["%s holds %s" % (d.relative_to(root), f.name) for f in sorted(d.iterdir())
                    if f.name.endswith(".conf") and not inert(root, f)]
    enabled = preset_enabled(root)
    for base in WANTS_DIRS:
        for w in sorted((root / base).glob("*.wants")) + sorted((root / base).glob("*.requires")):
            for u in sorted(w.iterdir()):
                if u.name not in enabled:
                    out.append("%s/%s is enabled but not in the enforcer preset" % (w.relative_to(root), u.name))
    vals, bad = sysctls(root)
    out += ["sysctl.d: " + b for b in bad]
    out += ["sysctl.d sets %s to %s; must be %s" % (k.replace("/", "."), vals.get(k), v)
            for k, v in NODUMP.items() if vals.get(k) != v]
    # systemd applies a name over any glob that matches it, and a glob replaces only the same glob
    # from an earlier file, so a non-zero rp_filter key anywhere in the final set leaves one on.
    out += ["sysctl.d sets %s to %s; rp_filter must be 0" % (k.replace("/", "."), vals.get(k))
            for k in sorted(set(RPF) | {k for k in vals if rp_filter_key(k)}) if vals.get(k) != "0"]
    return out


if __name__ == "__main__":
    bad = violations(os.environ["BUILDROOT"])
    for b in bad:
        print("mkosi.finalize: %s" % b)
    sys.exit(1 if bad else 0)
