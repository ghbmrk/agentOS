{
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh api -X PUT repos/ghbmrk/agentOS/pulls/*/ccr/auto_merge -f merge_method=merge)",
      "Bash(gh api -X DELETE repos/ghbmrk/agentOS/pulls/*/ccr/auto_merge)",
      "Bash(gh api -X PUT repos/ghbmrk/agentOS/pulls/*/merge -f merge_method=merge -f sha=*)",
      "Bash(gh api -X POST repos/ghbmrk/agentOS/issues/*/labels -f labels[]=*)",
      "Bash(gh api -X DELETE repos/ghbmrk/agentOS/issues/*/labels/*)",
      "Bash(gh api -X POST repos/ghbmrk/agentOS/issues/*/comments -F body=@/mnt/project-files/lens-drafts/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gh_shape.py\" || { echo \"gh_shape hook failed\" >&2; exit 2; }"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__issue_write|mcp__github__update_issue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/close_guard.py\" || { echo \"close_guard hook failed\" >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
